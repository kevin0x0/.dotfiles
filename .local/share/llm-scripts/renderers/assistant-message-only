# vim: ft=sh
my_message_text_renderer() {
  if [ "$argument" != assistant ]; then
    cat >/dev/null
    return 0
  fi

  cat -u
  echo
}

llmru_render_cmd_message_text=my_message_text_renderer
llmru_render_cmd_message_refusal=my_message_text_renderer
llmru_render_cmd_message_image='cat >/dev/null'
llmru_render_cmd_message_file='cat >/dev/null'
llmru_render_cmd_reasoning='cat >/dev/null'
llmru_render_cmd_reasoning_summary='cat >/dev/null'
llmru_render_cmd_notify='cat >/dev/null'
llmru_render_cmd_preparing_call='cat >/dev/null'
llmru_render_cmd_preparing_builtin='cat >/dev/null'
llmru_render_cmd_tool_call='cat >/dev/null'
llmru_render_cmd_tool_output='cat >/dev/null'
llmru_render_cmd_nop='cat >/dev/null'

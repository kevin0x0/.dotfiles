# vim: ft=sh

# Set the api key
opt_api_key="<your api key>"
# Or
# opt_api_key_cmd="<command that prints your api key>"
# Note: the command must print a trailing newline
# For example, if your key is 'abc', the command may look like:
# opt_api_key_cmd='printf "abc\n"'

# Set the cache key (it identifies your remote file storage)
opt_cache_key="<cache key>"

# Source a model
llmcu_source_configfile @providers/deepseek/models/deepseek-flash

if [ "$llm_scriptname" = llm-chat ]; then
  # If opt_prompt is set, its value is used as the prompt.
  opt_prompt='You are a helpful assistant.'
  # If opt_prompt_file is set instead, the file's content is used as the
  # prompt.
  # llmcu_locate_config_item opt_prompt_file prompts/generic

  # Specify the tools of the default tool set: a space-separated list of
  # glob patterns.
  opt_default_tools='@default _builtin_web_search manage_tools'

  # Specify the extra tool set: additional tools loaded for the session.
  # With opt_extra_tools_defer_loading=inject, they are loaded with stub
  # signatures, and their full signatures are fetched on demand with the
  # manage_tools tool, which must then be enabled; without defer loading
  # it is optional.
  # opt_extra_tools='*'
  # opt_extra_tools_defer_loading=inject
  #
  # With opt_extra_tools_defer_loading=on, the provider defers loading
  # natively; add the tool_search tool so deferred tools can be loaded
  # on demand.
  # opt_extra_tools='*'
  # opt_extra_tools_defer_loading=on
  # opt_default_tools="$opt_default_tools _builtin_tool_search"
fi

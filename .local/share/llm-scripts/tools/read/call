#!/bin/sh

. llm-tool-utils

tmp=
cleanup() {
  [ -n "$tmp" ] && rm -f -- "$tmp"
  if [ -n "$1" ]; then
    trap - "$1"
    kill -"$1" "$$"
  fi
}
trap 'cleanup' EXIT
trap 'cleanup INT' INT
trap 'cleanup TERM' TERM
trap 'cleanup QUIT' QUIT

{
  read -r pathname && read -r offset && read -r limit && read -r llmtu_output_json
} <<EOF || llmtu_bad_argument "invalid JSON"
$(jq -rL "$llmtu_jqlibpath" '
  include "parse-arguments";
  (.path | parse_string),
  (.offset | parse_integer(1)),
  (.limit | parse_integer(1500)),
  (.output_json | parse_boolean)')
EOF

llmtu_eval_string pathname

[ -n "$pathname" ] || llmtu_bad_argument "path is required"
[ "$offset" -gt 0 ] || llmtu_bad_argument "offset must be greater than zero"
[ "$limit" -ge 0 ] || llmtu_bad_argument "limit must be non-negative"

escape_chars=[:,?\>\$\(\)\"\'[:space:][:cntrl:]]

single_line_pathname() {
  case $1 in
    *${escape_chars}*)  shell-escape -t '' -- "$1" ;;
    *)                  printf "%s" "$1" ;;
  esac
}

header() {
  printf "%s: " "$1"
  single_line_pathname "$2"
  [ -n "$3" ] && printf "%s" "$3"
  echo
}

output() {
  case $1 in
    "regular file")
      total=$3; offset=$4; end=$5; missing_newline=$6
      if [ -n "$llmtu_output_json" ]; then
        missing_newline=${missing_newline:+true}
        missing_newline=${missing_newline:-false}
        jq -cRn --arg path "$2" --arg type "$1" \
          --argjson total "$total" \
          --argjson offset "$offset" \
          --argjson end "$end" \
          --argjson missing_newline "$missing_newline" \
          -- '{$path,$type,$total,$offset,$end,$missing_newline,lines:[inputs][$offset - 1:$end]}' <"$2"
      else
        if [ "$total" -eq 0 ]; then
          header "$1" "$2" ", empty"
        elif [ "$offset" -gt "$total" ]; then
          header "$1" "$2" ", offset $offset is beyond the end ($total lines)"
        else
          header "$1" "$2" ", lines ${offset}-$end of $total${missing_newline:+, no trailing newline}"
          { cat -- "$2"; echo; } | awk -v offset="$offset" -v end="$end" \
            'NR >= offset && NR <= end {print NR ": " $0}'
        fi
      fi
      ;;
    "directory")
      total=$3; offset=$4; end=$5
      if [ -n "$llmtu_output_json" ]; then
        jq -cRs --arg path "$2" --arg type "$1" \
          --argjson total "$total" \
          --argjson offset "$offset" \
          --argjson end "$end" \
          -- '{
            $path,$type,$total,$offset,$end,
            entries: split("\u0000")[$offset - 1:$end] | map(
              split("//") |
              [.[0], .[1], .[2], (.[3:] | join("//"))] as [$name, $type, $access_error, $target] |
              {$name,$type} |
              if $type == "symbolic link" then
                if .access_error then
                  .access_error = $access_error
                else
                  .target = $target
                end
              end
            )
          }' <"$tmp"
      else
        if [ "$total" -eq 0 ]; then
          header "$1" "$2" ", empty"
        elif [ "$offset" -gt "$total" ]; then
          header "$1" "$2" ", offset $offset is beyond the end ($total entries)"
        else
          header "$1" "$2" ", entries ${offset}-$end of $total"
          xargs -r0 -- sh -c '
            escape_chars=$1; shift
            single_line_pathname() {
              case $2 in
                *$escape_chars*) eval " $1"="\$(shell-escape -t \"\" -- \"\$2\")" ;;
                *) eval " $1=\$2" ;;
              esac
            }
            for arg; do
              name=${arg%%//*}
              arg=${arg#*//}
              type=${arg%%//*}
              arg=${arg#*//}
              access_error=${arg%%//*}
              target=${arg#*//}
              single_line_pathname name "$name"
              [ -n "$target" ] && single_line_pathname target "$target"
              case $type in
                "regular file") printf "%s\n" "$name" ;;
                "directory") printf "%s/\n" "$name" ;;
                "symbolic link") printf "%s -> %s\n" "$name" "${access_error:+?}$target";;
                *) printf "%s (%s)\n" "$name" "$type" ;;
              esac
            done
          ' sh "$escape_chars" <"$tmp" \
            | tail -n +"$offset" | head -n "$limit"
        fi
      fi
      ;;
    "binary file")
      if [ -n "$llmtu_output_json" ]; then
        jq -cn --arg path "$2" --arg type "regular file" \
          '{$path,$type,binary_file:true}'
      else
        header "regular file" "$2" ", contains a NUL byte, likely a binary file; content not shown"
      fi
      ;;
    "symbolic link")
      if [ -n "$llmtu_output_json" ]; then
        jq -cn --arg path "$2" --arg type "$1" --arg target "$3" \
          '{$path,$type,$target}'
      else
        header "$1" "$2" " -> $(single_line_pathname "$3")"
      fi
      ;;
    "socket"|"FIFO"|"block device"|"character device"|"unknown file type")
      if [ -n "$llmtu_output_json" ]; then
        jq -cn --arg path "$2" --arg type "$1" '{$path,$type}'
      else
        header "$1" "$2"
      fi
      ;;
    "access error")
      if [ -n "$llmtu_output_json" ]; then
        jq -cn --arg path "$2" --arg access_error "$3" '{$path,$access_error}'
      else
        header "$3" "$2"
      fi
      ;;
  esac | llm-make-mcontent -t
}

if [ -L "$pathname" ]; then
  link_target=$(readlink -- "$pathname" && echo x) || llmtu_error "failed to read the link"
  link_target=${link_target%$'\nx'}
  output "symbolic link" "$pathname" "$link_target"
elif [ -c "$pathname" ]; then
  output "character device" "$pathname"
elif [ -b "$pathname" ]; then
  output "block device" "$pathname"
elif [ -p "$pathname" ]; then
  output "FIFO" "$pathname"
elif [ -S "$pathname" ]; then
  output "socket" "$pathname"
elif [ ! -e "$pathname" ]; then
  output "access error" "$pathname" "no such file or directory"
elif [ ! -r "$pathname" ]; then
  output "access error" "$pathname" "unreadable file"
elif [ -d "$pathname" ]; then
  tmp=$(tmpfile) || exit 1

  findpath=$pathname/.
  case $findpath in
    [!/]*) findpath=$PWD/$findpath ;;
  esac
  find "$findpath" ! -name '.' -prune -exec sh -c '
   prefix=$1; shift
    for arg; do
      type=
      target=
      access_error=
      if [ -L "$arg" ]; then
        type="symbolic link"
        if target=$(readlink -- "$arg" && echo x); then
          target=${target%$'"'\\nx'"'}
        else
          access_error="can not read the target"
        fi
      elif [ -f "$arg" ]; then
        type="regular file"
      elif [ -d "$arg" ]; then
        type="directory"
      elif [ -c "$arg" ]; then
        type="character device"
      elif [ -b "$arg" ]; then
        type="block device"
      elif [ -p "$arg" ]; then
        type="FIFO"
      elif [ -S "$arg" ]; then
        type="socket"
      else
        type="unknown file type"
      fi
      printf "%s//%s//%s//%s\0" "${arg#"$prefix"}" "$type" "$access_error" "$target"
    done
  ' sh "$findpath/" {} + \
    | jq -Rs --raw-output0 'split("\u0000")[:-1] | sort[]' >"$tmp"
  total=$(($(tr -cd '\000' <"$tmp" | wc -c)))
  end=$((offset - 1 + limit > total ? total : offset - 1 + limit))
  output "directory" "$pathname" "$total" "$offset" "$end"
elif [ -f "$pathname" ]; then
  if [ -n "$(head -c 4096 <"$pathname" | tr -cd '\000' | tr '\000' 'x' | head -n 1)" ]; then
    output "binary file" "$pathname"
  else
    missing_newline=
    [ -n "$(tail -c 1 <"$pathname" | tr -c '\n' '[x*]')" ] && missing_newline=1
    total=$((missing_newline + $(wc -l <"$pathname")))
    end=$((offset - 1 + limit > total ? total : offset - 1 + limit))
    output "regular file" "$pathname" "$total" "$offset" "$end" "$missing_newline"
  fi
else
  output "unknown file type" "$pathname"
fi

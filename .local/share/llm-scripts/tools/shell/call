#!/bin/sh

if [ -f "$2/tool-config/shell" ]; then
  command . -- "$2/tool-config/shell" >/dev/null 2>&1
fi

stderr=
stdout=
arg=

cleanup() {
  [ -n "$tmpdir" ] && rm -rf -- "$tmpdir"
  if [ -n "$1" ]; then
    trap - "$1"
    kill -"$1" "$$"
  fi
}

trap 'cleanup' EXIT
trap 'cleanup INT' INT
trap 'cleanup TERM' TERM
trap 'cleanup QUIT' QUIT

tmpdir=$(tmpfile -d) || exit 1
stderr=$tmpdir/stderr
stdout=$tmpdir/stdout
arg=$tmpdir/arg
approval_out=$tmpdir/approval-out

cat >"$arg"

if ! jq -e -- 'type == "object" and (.code | type) == "string" and (.intent | type) == "string"' "$arg" >/dev/null 2>&1; then
  llm-make-mcontent -t -- '{"error":"bad argument: both \"code\" and \"intent\" fields must be provided"}'
  exit 0
fi

interpreter=$(jq -j '.interpreter // ""' <"$arg")
[ -z "$interpreter" ] && interpreter=$opt_interpreter

if [ -z "$interpreter" ]; then
  if command -v bash >/dev/null 2>&1; then
    interpreter=bash
  else
    interpreter=sh
  fi
fi

if ! command -v -- "$interpreter" >/dev/null 2>&1; then
  jq -cn --arg interpreter "$interpreter" -- '{error:"interpreter not found: " + $interpreter}' \
    | llm-make-mcontent -t
  exit 0
fi

reply=
if [ -n "$LLM_CHAT_SH_YES$opt_yes" ]; then
  reply=${opt_yes:-$LLM_CHAT_SH_YES}
fi
header=$'\033[31;1m'"script execution requested ($interpreter):"$'\033[0m'
preview_command="jq -j '.code' | $(shell-escape -- sh -- "$1/lib/render-code" -d "$1" -s "$2" -I "$interpreter")"
colored_preview_command="$preview_command -c always"
summary_command="jq -j '.intent' | $(shell-escape -- sh -- "$1/lib/render-intent" -d "$1" -s "$2")"

tty-approval \
  -FR \
  -r "$reply" \
  -p "$preview_command" \
  -P "$colored_preview_command" \
  -s "$summary_command" \
  -h "$header" \
  -i "$arg" >"$approval_out"

case $? in
  0)
    jq -j '.code' <"$arg" | "$interpreter" >"$stdout" 2>"$stderr"
    exitcode=$?
    ;;
  1)
    jq -Rcs '{rejected:.}' <"$approval_out" \
      | llm-make-mcontent -t
    exit 0
    ;;
  3)
    "$interpreter" >"$stdout" 2>"$stderr" <"$approval_out"
    exitcode=$?
    ;;
  *)
    llm-make-mcontent -t '{"error":"approval agent exited abnormally"}'
    exit 0
    ;;
esac

jq -cn --rawfile stdout "$stdout" \
  --rawfile stderr "$stderr" \
  --argjson exitcode "$exitcode" \
  '{$stdout,$stderr,$exitcode}' \
  | llm-make-mcontent -t --

exit 0

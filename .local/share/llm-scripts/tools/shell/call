#!/bin/sh

. -- llm-chat-common
llmcc_set_public_files_var "$2"
llmcc_tool_source_runtime_config "shell"

stderr=
stdout=
arg=
line_prefix='| '

cleanup() {
  [ -n "$tmpdir" ] && rm -rf -- "$tmpdir"
  if [ -n "$1" ]; then
    trap - "$1"
    kill -"$1" "$$"
  fi
}

trap 'cleanup' EXIT
trap 'cleanup INT' INT
trap 'cleanup TERM' TERM
trap 'cleanup QUIT' QUIT

tmpdir=$(tmpfile -d) || exit 1
stderr=$tmpdir/stderr
stdout=$tmpdir/stdout
arg=$tmpdir/arg
approval_out=$tmpdir/approval-out

cat >"$arg"

error() {
  if [ -n "$output_json" ]; then
    jq -nc --arg error "$1" -- '{$error}'
  else
    printf "error:\n%s%s\n" "$line_prefix" "$1"
  fi | llm-make-mcontent -t
  exit 0
}

rejected() {
  if [ -n "$output_json" ]; then
    jq -Rsc -- '{rejected:.}'
  else
    printf "rejected:\n"
    awk -v line_prefix="$line_prefix" '{print line_prefix $0}'
  fi | llm-make-mcontent -t
  exit 0
}

output_json=
if ! jq -e -- 'type == "object" and (.command | type) == "string" and (.intent | type) == "string"' "$arg" >/dev/null 2>&1; then
  error 'bad argument: both "command" and "intent" fields must be provided'
  exit 0
fi

output_json=$(jq -j 'if .output_json then "1" else "" end' <"$arg")
interpreter=$(jq -j '.interpreter // ""' <"$arg")
[ -z "$interpreter" ] && interpreter=$opt_interpreter

if [ -z "$interpreter" ]; then
  if command -v bash >/dev/null 2>&1; then
    interpreter=bash
  else
    interpreter=sh
  fi
fi

if ! command -v -- "$interpreter" >/dev/null 2>&1; then
  case $interpreter in
    *$'\n'*) interpreter=$(shell-escape -t '' -- "$interpreter") ;;
  esac
  error "interpreter not found: $interpreter"
fi

reply=
if [ -n "$LLM_CHAT_SH_YES$opt_yes" ]; then
  reply=${opt_yes:-$LLM_CHAT_SH_YES}
fi
header=$'\033[31;1m'"script execution requested ($interpreter):"$'\033[0m'
preview_command="jq -j '.command' | $(shell-escape -- sh -- "$1/lib/render-command" -d "$1" -s "$2" -I "$interpreter")"
colored_preview_command="$preview_command -c always"
summary_command="jq -j '.intent' | $(shell-escape -- sh -- "$1/lib/render-intent" -d "$1" -s "$2")"

tty-approval \
  -FR \
  -r "$reply" \
  -p "$preview_command" \
  -P "$colored_preview_command" \
  -s "$summary_command" \
  -h "$header" \
  -i "$arg" >"$approval_out"

case $? in
  0)
    jq -j '.command' <"$arg" | "$interpreter" >"$stdout" 2>"$stderr"
    exitcode=$?
    ;;
  1)
    rejected <"$approval_out"
    ;;
  3)
    "$interpreter" >"$stdout" 2>"$stderr" <"$approval_out"
    exitcode=$?
    ;;
  *)
    error "approval agent exited abnormally"
    ;;
esac

if [ -n "$output_json" ]; then
  jq -cn --rawfile stdout "$stdout" \
    --rawfile stderr "$stderr" \
    --argjson exitcode "$exitcode" \
    '{$stdout,$stderr,$exitcode}'
else
  missing_newline() {
    [ -n "$(tail -c 1 <"$1" | tr -c '\n' '[x*]')" ]
  }

  print_out() {
    if [ -s "$1" ]; then
      if missing_newline "$1"; then
        echo >>"$1"
        printf "%s (no trailing newline):\n" "$2"
      else
        printf "%s:\n" "$2"
      fi
      tr -d '\000' <"$1" | \
        awk -v line_prefix="$line_prefix" '{print line_prefix $0}'
    fi
  }

  printf "exitcode: %s\n" "$exitcode"
  print_out "$stderr" "stderr"
  print_out "$stdout" "stdout"
fi | llm-make-mcontent -t --

exit 0

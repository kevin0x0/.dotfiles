#!/bin/sh

. llm-tool-render-utils

llmtr_parse_options "" "$@"

program='
include "functions";

try (
  fromjson |
    (.intent // "" | print_strings, " | ", render("intent")),
    (
      .interpreter // "" as $interpreter |
      .code // "" | print_strings, " | ",
      render_withflags("code"; "-I " + ($interpreter | @sh))
    )
) catch (
  halt
)
'
jq -Rsj --arg libpath "$llmtropt_tool_dir/lib" \
  -L "$llmtropt_tool_dir/lib" -- "$program" \
  | sh -s -- "$@"

#!/bin/sh

. llm-tool-render-utils

llmtr_parse_options "" "$@"

program='
include "functions";

select(.type == "input_text") | .text |
  try (
    fromjson as $value |
      "error", "stdout", "stderr", "rejected" | . as $field | $value[.] |
      select(. != null and .!= "") | print_strings, " | ", render($field)
  ) catch (
    halt
  )
'

jq -j --arg libpath "$llmtropt_tool_dir/lib" \
  -L "$llmtropt_tool_dir/lib" -- "$program" \
  | sh -s -- "$@"

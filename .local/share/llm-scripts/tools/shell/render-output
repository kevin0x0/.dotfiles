#!/bin/sh

. llm-tool-render-utils

llmtr_parse_options "" "$@"

line_prefix='| '

program='
include "functions";

select(.type == "input_text") | .text |
  if startswith("{") then
    fromjson
  else
    split("\n") |
    if .[0] | startswith("exitcode: ") then
      .[1:-1] |
      reduce .[] as $line (
        {};
        if $line | startswith($line_prefix) then
          .[.current] += [$line | ltrimstr($line_prefix)]
        else
          .current = $line | .[.current] = []
        end
      ) |
      if .["stderr (no trailing newline):"] then
        .stderr = (.["stderr (no trailing newline):"] | join("\n"))
      elif .["stderr:"] then
        .stderr = (.["stderr:"] | join("\n") + "\n")
      else
        .stderr = ""
      end |
      if .["stdout (no trailing newline):"] then
        .stdout = (.["stdout (no trailing newline):"] | join("\n"))
      elif .["stdout:"] then
        .stdout = (.["stdout:"] // [] | join("\n") + "\n")
      else
        .stdout = ""
      end
    elif .[0] == "rejected:" then
      {rejected:.[1:] | map(ltrimstr($line_prefix)) | join("\n")}
    elif .[0] == "error:" then
      {error:.[1:] | map(ltrimstr($line_prefix)) | join("\n")}
    else
      {}
    end
  end as $value |
    "error", "stdout", "stderr", "rejected" | . as $field | $value[.] |
    select(. != null and .!= "") | print_strings, " | ", render($field)
'

jq -j --arg line_prefix "$line_prefix" \
  --arg libpath "$llmtr_opt_tool_dir/lib" \
  -L "$llmtr_opt_tool_dir/lib" -- "$program" \
  | sh -s -- "$@"

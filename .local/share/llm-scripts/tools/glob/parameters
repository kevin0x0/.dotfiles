{
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "The directory under which to match; defaults to the working directory of the session."
    },
    "patterns": {
      "description": "The glob pattern(s) to match; a path matches when it matches any of them. A string is one pattern; an array is a list of patterns.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "limit": {
      "type": "integer",
      "description": "The maximum number of paths to list; must be non-negative. Defaults to 100.",
      "default": 100
    },
    "output_json": {
      "type": "boolean",
      "description": "Return the result as a JSON object instead of the default plain text format."
    }
  },
  "required": [
    "patterns"
  ]
}

{
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "The directory under which to match; defaults to the working directory of the session."
    },
    "pattern": {
      "type": "string",
      "description": "A single glob pattern."
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "A list of glob patterns."
    },
    "limit": {
      "type": "integer",
      "description": "The maximum number of paths to list; must be non-negative. Defaults to 100.",
      "default": 100
    },
    "output_json": {
      "type": "boolean",
      "description": "Return the result as a JSON object instead of the default plain text format."
    }
  }
}

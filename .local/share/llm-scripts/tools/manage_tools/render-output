#!/bin/sh

. llm-tool-render-utils
llmtr_parse_options "" "$@"

jq -r '
select(.type == "input_text").text |
try (
  fromjson |
  if .error != null then
    "manage_tools error",
    .error
  elif .added_tools != null then
    "enabled tools",
    .added_tools[]
  elif .removed_tools != null then
    "disabled tools",
    .removed_tools[]
  elif .described != null then
    "described tools",
    (.tools[] | .name // .type)
  elif .list != null then
    "listed tools" + (
      if .list[0] | type == "object" and has("summary") then
        " with summary"
      else
        ""
      end
    ),
    (.list[] | .path // .name)
  elif .docs != null then
    "read documents of " + .toolname,
    .docs[].docpath
  elif .doclist != null then
    "listed documents of " + .toolname,
    .doclist[]
  else
    ""
  end
) catch (
  "error",
  "bad output"
)
' | {
  IFS= read -r line
  color=33
  case $line in
    "manage_tools error") color=31 ;;
  esac
  printf "%s\n" "$line" | llmtr_run_on_color llmtr_color_pattern \
    '1' '36;1' '^((enabled|disabled|described|listed) tools|listed tools with summary|(read|listed) documents of)' '&' \
    '1' '31;1' '^manage_tools error' '&'

  llmtr_complete_newline \
    | llmtr_run_filter_on_color llmtr_filter_color_line "$color" \
    | llmtr_render_lines
}

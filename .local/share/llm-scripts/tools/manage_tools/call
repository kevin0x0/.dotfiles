#!/bin/sh

opt_yes=
statedir=$2
. -- llm-chat-common
. -- llm-tool-utils
llmcc_set_public_files_var "$statedir"
llmcc_tool_source_runtime_config "manage_tools"

llmtu_output_json=1

cleanup() {
  [ -n "$tmpdir" ] && rm -rf -- "$tmpdir"
  if [ -n "$1" ]; then
    trap - "$1"
    kill -"$1" "$$"
  fi
}
trap 'cleanup' EXIT
for sig in INT TERM QUIT; do
  trap "cleanup $sig" "$sig"
done

tmpdir=
tmpdir=$(tmpfile -d) || exit 1
argfile=$tmpdir/arg
outfile=$tmpdir/stdout
errfile=$tmpdir/stderr
approval_out=$tmpdir/approval-out

{
  read -r op \
    && read -r pattern \
    && read -r docpaths \
    && read -r whole_catalog \
    && read -r enabled \
    && read -r with_summary \
    && read -r name \
    && read -r start_index \
    && read -r count
} <<EOF || llmtu_bad_argument "invalid JSON"
$(tee -- "$argfile" | jq -rL "$llmtu_jqlibpath" '
  include "parse-arguments";
  (.operation | parse_simple_string),
  (.pattern | parse_simple_string),
  (.docpaths | parse_string_array),
  (.whole_catalog, .enabled, .with_summary | parse_boolean),
  (.toolname | parse_simple_string),
  (.start_index | parse_integer(0)),
  (.count | parse_integer(20))')
EOF

if [ -z "$op" ]; then
  if jq -e 'keys | map(select(. != "operation")) | length > 0' <"$argfile" >/dev/null 2>&1; then
    llmtu_error "bad argument: operation is missing; the arguments look like they belong to another tool"
  fi
  llmtu_error "bad argument: operation is missing"
fi
case $op in
  enable|disable|describe|list|doc|listdoc) ;;
  *)
    llmtu_error "bad argument: operation must be describe, list, doc or listdoc"
    ;;
esac

# enable and disable need approval
if [ "$op" = enable ] || [ "$op" = disable ]; then
  if [ -z "$pattern" ]; then
    llmtu_error "bad argument: pattern is not given or is empty"
  fi

  summary=$'\033[33;1m'"$op tools matching pattern(s): $pattern"$'\033[0m'
  preview_command="$(shell-escape -- sh -- "$1/lib/approval-preview" -s "$2")"
  colored_preview_command="$preview_command -c always"
  summary_command="$(shell-escape -- printf "%s\n" "$summary")"
  header=$'\033[31;1mrequest to '$op$' tool(s):\033[0m'
  tty-approval \
    -R \
    -r "$opt_yes" \
    -p "$preview_command" \
    -P "$colored_preview_command" \
    -s "$summary_command" \
    -h "$header" \
    -i "$argfile" >"$approval_out"

  case $? in
    0|3)
      ;;
    1)
      jq -Rcs '{rejected:.}' <"$approval_out" | llm-make-mcontent -t
      exit 0
      ;;
    *)
      llmtu_error "approval agent exited abnormally"
      ;;
  esac
fi

# The list scoping flags are mutually exclusive; checked only for
# "list" so that irrelevant parameters stay silently ignored.
if [ "$op" = list ]; then
  if [ -n "$enabled" ] && [ -n "$whole_catalog" ]; then
    llmtu_error "bad argument: enabled and whole_catalog can not be used together"
  fi
  if [ -n "$enabled" ] && [ -n "$pattern" ]; then
    llmtu_error "bad argument: pattern can not be used with enabled"
  fi
fi

set -- -jd "$statedir" "$op"
case $op in
  enable|disable)
    set -- "$@" -- "$pattern"
    ;;
  describe)
    [ "$pattern" ] && set -- "$@" -- "$pattern"
    ;;
  list)
    set -- "$@" -i "$start_index" -c "$count"
    [ -n "$with_summary" ] && set -- "$@" -s
    if [ -n "$enabled" ]; then
      set -- "$@" -e
    elif [ -n "$whole_catalog" ]; then
      set -- "$@" -E
    fi
    [ -n "$pattern" ] && set -- "$@" -- "$pattern"
    ;;
  doc)
    command eval 'set -- "$@" -- "$name" '"$docpaths" \
      || llmtu_bad_argument "invalid docpaths"
    ;;
  listdoc)
    set -- "$@" -- "$name"
    [ -n "$pattern" ] && set -- "$@" "$pattern"
    ;;
esac

llm-chat-manage-tool "$@" >"$outfile" 2>"$errfile"
exitcode=$?
if [ "$exitcode" -eq 0 ]; then
  llm-make-mcontent -ft -- "$outfile"
elif [ -s "$errfile" ]; then
  jq -Rsc '{error:rtrimstr("\n")}' "$errfile" \
    | llm-make-mcontent -t
else
  llm-make-mcontent -t '{"error":"failed"}'
fi
exit 0

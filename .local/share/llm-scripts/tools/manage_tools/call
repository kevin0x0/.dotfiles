#!/bin/sh

opt_yes=
statedir=$2
if [ -f "$statedir/tool-config/manage_tools" ]; then
  command . -- "$statedir/tool-config/manage_tools" >/dev/null 2>&1
fi

cleanup() {
  [ -n "$tmpdir" ] && rm -rf -- "$tmpdir"
  if [ -n "$1" ]; then
    trap - "$1"
    kill -"$1" "$$"
  fi
}
trap 'cleanup' EXIT
for sig in INT TERM QUIT; do
  trap "cleanup $sig" "$sig"
done

error() {
  jq --arg err "$1" -cn -- '{error:$err}' | llm-make-mcontent -t
  exit 0
}

tmpdir=
tmpdir=$(tmpfile -d) || exit 1
argfile=$tmpdir/arg
outfile=$tmpdir/stdout
errfile=$tmpdir/stderr
docpaths=$tmpdir/docpaths
approval_out=$tmpdir/approval-out

cat >"$argfile"

# enable and disable operations are availabel but not explicitly exposed 
# to the model.
op=$(jq -j '.operation // "" | tostring' <"$argfile" 2>/dev/null)
case $op in
  enable|disable|describe|list|doc|listdoc) ;;
  *)
    error "bad argument: operation must be describe, list, doc or listdoc"
    ;;
esac

pattern=$(jq -j '.pattern // "" | tostring | gsub("\n"; " ")' <"$argfile")

# enable and disable need approval
if [ "$op" = enable ] || [ "$op" = disable ]; then
  if [ -z "$pattern" ]; then
    error "bad argument: pattern is not given or is empty"
  fi

  summary=$'\033[33;1m'"$op tools matching pattern(s): $pattern"$'\033[0m'
  preview_command="$(shell-escape -- sh -- "$1/lib/approval-preview" -s "$2")"
  colored_preview_command="$preview_command -c always"
  summary_command="$(shell-escape -- printf "%s\n" "$summary")"
  header=$'\033[31;1mrequest to '$op$' tool(s):\033[0m'
  tty-approval \
    -R \
    -r "$opt_yes" \
    -p "$preview_command" \
    -P "$colored_preview_command" \
    -s "$summary_command" \
    -h "$header" \
    -i "$argfile" >"$approval_out"

  case $? in
    0|3)
      ;;
    1)
      jq -Rcs '{rejected:.}' <"$approval_out" | llm-make-mcontent -t
      exit 0
      ;;
    *)
      error "approval agent exited abnormally"
      ;;
  esac
fi

whole_catalog=$(jq -j '(.whole_catalog and true) or false' <"$argfile")
with_summary=$(jq -j '(.with_summary and true) or false' <"$argfile")
name=$(jq -j '.toolname // "" | tostring' <"$argfile")
jq -r '.docpaths // empty | if type != "array" then [.] end | .[]' <"$argfile" >"$docpaths"
start_index=$(jq -j '.start_index | select(type == "number")' <"$argfile")
count=$(jq -j '.count | select(type == "number")' <"$argfile")

case $start_index in
  '') start_index=0 ;;
  *[!0123456789]*)
    error "bad argument: start_index must be a non-negative integer"
    ;;
esac
case $count in
  '') count=20 ;;
  *[!0123456789]*)
    error "bad argument: count must be a non-negative integer"
    ;;
esac

set -- -jd "$statedir" "$op"
case $op in
  enable|disable)
    set -- "$@" -- "$pattern"
    ;;
  describe)
    [ "$pattern" ] && set -- "$@" -- "$pattern"
    ;;
  list)
    set -- "$@" -i "$start_index" -c "$count"
    [ "$with_summary" = true ] && set -- "$@" -s
    if [ "$whole_catalog" = true ]; then
      set -- "$@" -E
    fi
    [ -n "$pattern" ] && set -- "$@" -- "$pattern"
    ;;
  doc)
    set -- "$@" -- "$name"
    while IFS= read -r docpath; do
      set -- "$@" "$docpath"
    done <"$docpaths"
    ;;
  listdoc)
    set -- "$@" -- "$name"
    [ -n "$pattern" ] && set -- "$@" "$pattern"
    ;;
esac

llm-chat-manage-tool "$@" >"$outfile" 2>"$errfile"
exitcode=$?
if [ "$exitcode" -eq 0 ]; then
  llm-make-mcontent -ft -- "$outfile"
elif [ -s "$errfile" ]; then
  jq -Rsc '{error:rtrimstr("\n")}' "$errfile" \
    | llm-make-mcontent -t
else
  llm-make-mcontent -t '{"error":"failed"}'
fi
exit 0

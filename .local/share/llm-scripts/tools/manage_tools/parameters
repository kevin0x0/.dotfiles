{
  "type": "object",
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "describe",
        "list",
        "doc",
        "listdoc",
        "enable",
        "disable"
      ],
      "description": "The operation to perform."
    },
    "pattern": {
      "type": "string",
      "description": "Space separated glob pattern list. Optional for describe, where it matches tool names or tree paths (nothing is described when omitted); optional for list, where patterns without \"/\" match tool names and patterns containing \"/\" match paths in the tool tree (e.g. \"builtin/*\"; the extra tool set is listed when omitted); optional for listdoc, where it matches document paths (all documents when omitted). Required for enable and disable, where it matches tool names or tree paths."
    },
    "toolname": {
      "type": "string",
      "description": "Name of the tool. Required for doc and listdoc."
    },
    "docpaths": {
      "anyOf": [
        {
          "type": "string",
          "description": "Document pathname relative to the tool's doc directory; a literal path, glob patterns are not expanded. Optional for doc.",
          "default": "README.md"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Document pathname list relative to the tool's doc directory; literal paths, glob patterns are not expanded. Optional for doc.",
          "default": [
            "README.md"
          ]
        }
      ]
    },
    "with_summary": {
      "type": "boolean",
      "description": "Only for list: when true, list the tools with a short summary.",
      "default": false
    },
    "start_index": {
      "type": "integer",
      "description": "Only for list: the index of the starting output item. Must be a non-negative integer.",
      "default": 0
    },
    "count": {
      "type": "integer",
      "description": "Only for list: the maximum number of output items. Must be a non-negative integer.",
      "default": 20
    },
    "whole_catalog": {
      "type": "boolean",
      "description": "Only for list: when true, the whole catalog is listed, including tools that are not in the session."
    }
  },
  "required": [
    "operation"
  ]
}

#!/bin/sh

. llm-tool-render-utils

llmtr_parse_options "" "$@"

jq -Rsr '
try (
  fromjson |
    if .operation == "enable" then
      "enabling " + (.pattern // "" | tostring)
    elif .operation == "disable" then
      "disabling " + (.pattern // "" | tostring)
    elif .operation == "describe" then
      "describing " + (.pattern // "" | tostring)
    elif .operation == "list" then
      if .ignore_extra_set then
        "listing all tools matching " + (.pattern // "" | tostring)
      else
        "listing extra tools matching " + (.pattern // "" | tostring)
      end
    elif .operation == "doc" then
      "reading documents of " + (.toolname | tostring),
      (
        (.docpaths // []) | if type == "array" then . else [.] end |
          map(tostring | gsub("\n"; ""))[]
      )
    elif .operation == "listdoc" then
      "listing documents of " + (.toolname | tostring) + " " + (.pattern // "" | tostring)
    else
      "error: bad argument"
    end
) catch (
  "error: bad argument"
)
' | {
  op_color='36;1'
  error_color='31;1'
  IFS= read -r line
  prefix=
  color=$op_color
  case $line in
    "enabling"*) prefix="enabling" ;;
    "disabling"*) prefix="disabling" ;;
    "describing"*) prefix="describing" ;;
    "listing all tools"*) prefix="listing all tools matching" ;;
    "listing extra tools"*) prefix="listing extra tools matching" ;;
    "reading documents of"*) prefix="reading documents of" ;;
    "listing documents of"*) prefix="listing documents of" ;;
    "error:"*) prefix="error:"; color=$error_color ;;
  esac

  llmtr_render_header "$color" "$prefix" '1' "${line#"$prefix"}"

  while IFS= read -r line; do
    printf "%s\n" "$line"
  done \
    | llmtr_run_filter_on_color llmtr_filter_color_line '33' \
    | llmtr_render_lines
}

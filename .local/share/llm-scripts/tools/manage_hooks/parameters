{
  "type": "object",
  "properties": {
    "operation": {
      "type": "string",
      "enum": ["create", "remove", "list", "list-events", "list-docs", "doc", "path", "log-dump"],
      "description": "The operation to perform."
    },
    "event": {
      "type": "string",
      "description": "Hookable event the hook is attached to. Required for create, remove, path and list-docs (must be installed; for list-docs it can also be a namespace); optional for list, where a glob filters the listed hooks, and for list-events, where an ERE filters the listed events."
    },
    "pattern": {
      "type": "string",
      "description": "An ERE. Only for list-docs: filters the document paths. Only for log-dump: matches the \"[<event>/<hook name>]\" line prefix of the hook log; all lines are dumped when omitted."
    },
    "output_file": {
      "type": "string",
      "description": "Only for log-dump: the pathname of the file to write the matching hook log lines to. The file must not exist yet."
    },
    "name": {
      "type": "string",
      "description": "Hook name with its type suffix, e.g. \"notify.oneshot\" (runs once then is removed) or \"notify.always\" (runs every time). Required for remove and path. Optional for create (an auto-generated name is used; a name of the form \".<type>\" uses the auto-generated name with the given type); required when append is true."
    },
    "docpaths": {
      "anyOf": [
        {
          "type": "string",
          "description": "Document path in the form \"<entry name>/<doc path relative to the entry>\". Optional for doc."
        },
        {
          "type": "array",
          "items": { "type": "string" },
          "description": "Document path list. Optional for doc."
        }
      ]
    },
    "with_summary": {
      "type": "boolean",
      "description": "Only for list-events: when true, include each item's summary."
    },
    "source": {
      "type": "string",
      "description": "For create: the hook script text (mode=command) or a file pathname (mode=copy or mode=symlink)."
    },
    "mode": {
      "type": "string",
      "enum": ["command", "copy", "symlink"],
      "description": "command: source is the shell script text. copy: copy the file content. symlink: link the hook to the file. Defaults to command."
    },
    "append": {
      "type": "boolean",
      "description": "Only for create: append to the existing hook with the same name instead of failing. Cannot be used with mode=symlink."
    }
  },
  "required": ["operation"]
}

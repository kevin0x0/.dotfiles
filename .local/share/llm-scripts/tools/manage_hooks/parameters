{
  "type": "object",
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "create",
        "remove",
        "install",
        "list",
        "doc",
        "hook-dump",
        "hook-source",
        "log-dump"
      ],
      "description": "The operation to perform."
    },
    "event": {
      "type": "string",
      "description": "Hookable event the hook is attached to. Required for create, remove, hook-dump and hook-source. \"create\" requires it to be installed; the others only validate the name syntactically."
    },
    "what": {
      "type": "string",
      "enum": [
        "hooks",
        "events",
        "docs",
        "shared-state",
        "refs"
      ],
      "description": "Only for list: the kind of things to list. Defaults to \"hooks\". The result shapes and the argument requirements of each kind are in the tool description."
    },
    "pattern": {
      "type": "string",
      "description": "A POSIX ERE; do not use non-POSIX extensions. Optional for list and log-dump; the matching semantics are in the tool description."
    },
    "output_file": {
      "type": "string",
      "description": "Only for hook-dump and log-dump: the pathname of the file to write the result to. The file must not exist yet (\"file exists\" otherwise); its directory must exist (\"output directory does not exist\" otherwise). The pathname may be relative to the session's working directory."
    },
    "name": {
      "type": "string",
      "description": "Hook name with its type suffix, e.g. \"notify.oneshot\". Required for remove, hook-dump and hook-source; optional for create; required when append is true."
    },
    "docpaths": {
      "anyOf": [
        {
          "type": "string",
          "description": "Document path in the form \"<entry name>/<doc path relative to the entry>\". Required for doc."
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Document path list. Required for doc; an empty list is an error."
        }
      ]
    },
    "with_summary": {
      "type": "boolean",
      "description": "Only for list with \"what\":\"events\": when true, include each item's summary."
    },
    "source": {
      "type": "string",
      "description": "For create: the hook script text (mode=command) or a file pathname (mode=copy or mode=symlink)."
    },
    "mode": {
      "type": "string",
      "enum": [
        "command",
        "copy",
        "symlink"
      ],
      "description": "command: source is the shell script text. copy: copy the file content. symlink: link the hook to the file. Defaults to command."
    },
    "append": {
      "type": "boolean",
      "description": "Only for create: append to the hook with the same name (creating it if it does not exist) instead of failing with \"hook already exists\". Cannot be used with mode=symlink."
    },
    "entry": {
      "type": "string",
      "description": "Required for list with \"what\":\"docs\": an entry name (an event or a namespace)."
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Hook references to install; each names a hook file under the llm-scripts hooks directory, possibly in a subdirectory (the operand grammar is in the tool description). Required for install; an empty list installs nothing."
    }
  },
  "required": [
    "operation"
  ]
}

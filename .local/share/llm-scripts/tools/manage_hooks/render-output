#!/bin/sh

. llm-tool-render-utils

llmtr_parse_options "" "$@"

program='
include "functions";

select(.type == "input_text") | .text |
try (
  fromjson |
  (.created // null)  as $created |
  (.appended // null) as $appended |
  (.removed // null)  as $removed |
  (.path // "")       as $path |
  (.hooks // null)    as $hooks |
  (.events // null)   as $events |
  (.error // null)    as $error |
  (.rejected // null) as $rejected |
  (if $created != null then
     ($path | print_strings, " | ", render_withflags("change"; "-A created -S " + ($created | @sh)))
   else empty end),
  (if $appended != null then
     ($path | print_strings, " | ", render_withflags("change"; "-A appended -S " + ($appended | @sh)))
   else empty end),
  (if $removed != null then
     ($path | print_strings, " | ", render_withflags("change"; "-A removed -S " + ($removed | @sh)))
   else empty end),
  (if $hooks != null then
     ($hooks | map(.rel) | join("\n") | print_strings, " | ", render("hooks"))
   else empty end),
  (if $events != null then
     ($events
        | map(if .summary != "" then .name + "\n" + .summary else .name end)
        | join("\n") | print_strings, " | ", render("events"))
   else empty end),
  (if $created == null and $appended == null and $removed == null and $path != "" then
     ("" | print_strings, " | ", render_withflags("path"; "-S " + ($path | @sh)))
   else empty end),
  (if $error != null then
     ($error | print_strings, " | ", render("error"))
   else empty end),
  (if $rejected != null then
     ($rejected | print_strings, " | ", render("rejected"))
   else empty end)
) catch (
  halt
)
'

jq -j --arg libpath "$llmtropt_tool_dir/lib" \
  -L "$llmtropt_tool_dir/lib" -- "$program" \
  | sh -s -- "$@"

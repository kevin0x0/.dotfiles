#!/bin/sh

. llm-tool-render-utils

llmtr_parse_options "" "$@"

program='
include "functions";

select(.type == "input_text") | .text |
try (
  fromjson |
  (.created // null)  as $created |
  (.appended // null) as $appended |
  (.removed // null)  as $removed |
  (.entry // "")      as $entry |
  (.hooks // null)    as $hooks |
  (.events // null)   as $events |
  (.shared_state // null) as $shared_state |
  (.doclist // null)  as $doclist |
  (.docs // null)     as $docs |
  (.dump // null)     as $dump |
  (.source // null)   as $source |
  (.error // null)    as $error |
  (.rejected // null) as $rejected |
  (if $created != null then
     ("" | print_strings, " | ", render_withflags("change"; "-A created -S " + ($created | @sh)))
   else empty end),
  (if $appended != null then
     ("" | print_strings, " | ", render_withflags("change"; "-A appended -S " + ($appended | @sh)))
   else empty end),
  (if $removed != null then
     ("" | print_strings, " | ", render_withflags("change"; "-A removed -S " + ($removed | @sh)))
   else empty end),
  (if $hooks != null then
     ($hooks | map(.rel + (if .kind == "symlink" then " symlink" else "" end))
       | join("\n") | print_strings, " | ", render("hooks"))
   else empty end),
  (if $events != null then
     ($events | map(.name) | join("\n") | print_strings, " | ", render("events"))
   else empty end),
  (if $shared_state != null then
     ($shared_state | map(.id) | join("\n") | print_strings, " | ",
      render("shared-state"))
   else empty end),
  (if $doclist != null then
     (.doclist | join("\n") | print_strings, " | ",
      render_withflags("docs"; "-A listed -S " + ($entry | @sh)))
   else empty end),
  (if $docs != null then
     ($docs | map(.path) | join("\n") | print_strings, " | ", render("docs"))
   else empty end),
  (if $dump != null then
     (($dump.count | tostring) + " lines -> " + $dump.path
       | print_strings, " | ", render("dump"))
   else empty end),
  (if $source != null then
     ($source | print_strings, " | ", render("source"))
   else empty end),
  (if $error != null then
     ($error | print_strings, " | ", render("error"))
   else empty end),
  (if $rejected != null then
     ($rejected | print_strings, " | ", render("rejected"))
   else empty end)
) catch (
  halt
)
'

jq -j --arg libpath "$llmtropt_tool_dir/lib" \
  -L "$llmtropt_tool_dir/lib" -- "$program" \
  | sh -s -- "$@"

#!/bin/sh

. llm-tool-render-utils

llmtr_parse_options "" "$@"

program='
include "functions";

try (
  fromjson |
  ([.event, (.name // empty)]
     | map(select(. != null)) | join("/")) as $summary |
  (.append == true) as $is_append |
  (.event // "*") as $event_pattern |
  (.docpaths // [] | if type == "array" then . else [.] end |
    map(tostring | gsub("\n"; "")) | join(" ")) as $docpaths_arg |
  (.output_file // "?") as $output_file_arg |
  (.pattern // "") as $pattern_arg |
  if .operation == "create" then
    (if (.mode // "command") == "command" then
       (.source // "" | print_strings, " | ",
        render_withflags("operation";
          "-A create" + (if $is_append then " -P" else "" end)
          + " -K script -S " + ($summary | @sh)))
     elif (.mode // "command") == "copy" then
       ("copy from: " + (.source // "?") | print_strings, " | ",
        render_withflags("operation";
          "-A create" + (if $is_append then " -P" else "" end)
          + " -K plain -S " + ($summary | @sh)))
     elif (.mode // "command") == "symlink" then
       ("link to: " + (.source // "?") | print_strings, " | ",
        render_withflags("operation";
          "-A create" + (if $is_append then " -P" else "" end)
          + " -K plain -S " + ($summary | @sh)))
     else
       ("" | print_strings, " | ",
        render_withflags("operation";
          "-A create" + (if $is_append then " -P" else "" end)
          + " -S " + ($summary | @sh)))
     end)
  elif .operation == "remove" then
    ("" | print_strings, " | ", render_withflags("operation"; "-A remove -S " + ($summary | @sh)))
  elif .operation == "list" then
    ($pattern_arg | print_strings, " | ",
      render_withflags("operation"; "-A list -K plain"))
  elif .operation == "list-events" then
    ("" | print_strings, " | ",
      render_withflags("operation";
        "-A list-events -S " + ($pattern_arg | @sh)))
  elif .operation == "list-docs" then
    ("" | print_strings, " | ",
      render_withflags("operation";
        "-A list-docs -S " + ($event_pattern | @sh)))
  elif .operation == "doc" then
    ("" | print_strings, " | ",
      render_withflags("operation";
        "-A doc -S " + ($docpaths_arg | @sh)))
  elif .operation == "hook-dump" then
    ("" | print_strings, " | ", render_withflags("operation"; "-A hook-dump -S " + ($summary | @sh)))
  elif .operation == "hook-source" then
    ("" | print_strings, " | ", render_withflags("operation"; "-A hook-source -S " + ($summary | @sh)))
  elif .operation == "log-dump" then
    ($pattern_arg | print_strings, " | ",
      render_withflags("operation";
        "-A log-dump -K plain -S " + ($output_file_arg | @sh)))
  else
    ("unknown hook operation: " + (.operation // "?") | print_strings, " | ", render("error"))
  end
) catch (
  halt
)
'

jq -Rsj --arg libpath "$llmtropt_tool_dir/lib" \
  -L "$llmtropt_tool_dir/lib" -- "$program" \
  | sh -s -- "$@"

#!/bin/sh

. -- llm-chat-common
llmcc_set_public_files_var "$2"
llmcc_tool_source_runtime_config "manage_hooks"

cleanup() {
  [ -n "$tmpdir" ] && rm -rf -- "$tmpdir"
  if [ -n "$1" ]; then
    trap - "$1"
    kill -"$1" "$$"
  fi
}
trap 'cleanup' EXIT
trap 'cleanup INT' INT
trap 'cleanup TERM' TERM
trap 'cleanup QUIT' QUIT

tmpdir=
tmpdir=$(tmpfile -d) || exit 1
argfile=$tmpdir/arg
outfile=$tmpdir/stdout
errfile=$tmpdir/stderr
approval_out=$tmpdir/approval-out
docpaths=$tmpdir/docpaths
filesfile=$tmpdir/files

cat >"$argfile"

op=$(jq -j '.operation // ""' <"$argfile")
case $op in
  create|remove|install|list|doc|hook-dump|hook-source|log-dump) ;;
  *)
    llm-make-mcontent -t -- '{"error":"bad argument: operation must be create, remove, install, list, doc, hook-dump, hook-source or log-dump"}'
    exit 0
    ;;
esac

append=$(jq -j '.append // false' <"$argfile")

# create, remove and install need approval
if [ "$op" = create ] || [ "$op" = remove ] || [ "$op" = install ]; then
  case $op in
    install)
      summary=$(jq -j '.files // [] | if type != "array" then [.] end | join(" ")' <"$argfile")
      ;;
    *)
      summary=$(jq -j '[.event, (.name // empty)] | map(select(. != null)) | join("/")' <"$argfile")
      ;;
  esac
  preview_command="$(shell-escape -- sh -- "$1/render-call" -d "$1" -s "$2")"
  colored_preview_command="$preview_command -c always"
  if [ "$op" = create ] && [ "$append" = true ]; then
    summary_command="$(shell-escape -- sh -- "$1/lib/render-operation" -d "$1" -s "$2" -A "$op" -P -S "$summary")"
  else
    summary_command="$(shell-escape -- sh -- "$1/lib/render-operation" -d "$1" -s "$2" -A "$op" -S "$summary")"
  fi
  header=$'\033[31;1mrequest to manage hook:\033[0m'
  tty-approval \
    -R \
    -r "$opt_yes" \
    -p "$preview_command" \
    -P "$colored_preview_command" \
    -s "$summary_command" \
    -h "$header" \
    -i "$argfile" >"$approval_out"

  case $? in
    0|3)
      ;;
    1)
      jq -Rcs '{rejected:.}' <"$approval_out" | llm-make-mcontent -t
      exit 0
      ;;
    *)
      llm-make-mcontent -t '{"error":"approval agent exited abnormally"}'
      exit 0
      ;;
  esac
fi

event=$(jq -j '.event // ""' <"$argfile")
entry=$(jq -j '.entry // ""' <"$argfile")
what=$(jq -j '.what // "hooks"' <"$argfile")
pattern=$(jq -j '.pattern // ""' <"$argfile")
output_file=$(jq -j '.output_file // ""' <"$argfile")
with_summary=$(jq -j '(.with_summary and true) or false' <"$argfile")
mode=$(jq -j '.mode // "command"' <"$argfile")
source=$(jq -j '.source // ""' <"$argfile")
name=$(jq -j '.name // ""' <"$argfile")
jq -r '.docpaths // empty | if type != "array" then [.] end | .[]' <"$argfile" >"$docpaths"
jq -r '.files // empty | if type != "array" then [.] end | .[]' <"$argfile" >"$filesfile"

set -- -jP -d "$2" "$op"

case $op in
  create)
    [ -n "$event" ] && set -- "$@" "$event"
    if [ "$append" = true ]; then
      set -- "$@" -a
    fi
    case $mode in
      command)
        set -- "$@" -c
        ;;
      copy)
        ;;
      symlink)
        set -- "$@" -L
        ;;
      *)
        jq -cn --arg mode "$mode" '{error:"invalid mode: " + $mode}' \
          | llm-make-mcontent -t
        exit 0
        ;;
    esac
    set -- "$@" -- "$source"
    [ -n "$name" ] && set -- "$@" "$name"
    ;;
  remove|hook-source)
    set -- "$@" -- "$event" "$name"
    ;;
  install)
    set -- "$@" --
    while IFS= read -r hook_file; do
      set -- "$@" "$hook_file"
    done <"$filesfile"
    ;;
  hook-dump)
    if [ -z "$output_file" ]; then
      llm-make-mcontent -t -- '{"error":"bad argument: output_file is not given or is empty"}'
      exit 0
    fi
    set -- "$@" -- "$event" "$name" "$output_file"
    ;;
  list)
    set -- "$@" "$what"
    case $what in
      hooks|shared-state|refs)
        [ -n "$pattern" ] && set -- "$@" -- "$pattern"
        ;;
      events)
        [ "$with_summary" = true ] && set -- "$@" -s
        [ -n "$pattern" ] && set -- "$@" -- "$pattern"
        ;;
      docs)
        if [ -z "$entry" ]; then
          llm-make-mcontent -t -- '{"error":"bad argument: entry is not given or is empty"}'
          exit 0
        fi
        set -- "$@" -- "$entry"
        [ -n "$pattern" ] && set -- "$@" "$pattern"
        ;;
    esac
    ;;
  doc)
    set -- "$@" --
    while IFS= read -r docpath; do
      set -- "$@" "$docpath"
    done <"$docpaths"
    ;;
  log-dump)
    if [ -z "$output_file" ]; then
      llm-make-mcontent -t -- '{"error":"bad argument: output_file is not given or is empty"}'
      exit 0
    fi
    set -- "$@" --
    [ -n "$pattern" ] && set -- "$@" "$pattern"
    set -- "$@" "$output_file"
    ;;
esac

llm-chat-manage-hook "$@" >"$outfile" 2>"$errfile"
exitcode=$?
if [ "$exitcode" -eq 0 ]; then
  cat -- "$outfile" | llm-make-mcontent -t
elif [ -s "$errfile" ]; then
  head -n 1 -- "$errfile" | jq -Rsc '{error:rtrimstr("\n")}' \
    | llm-make-mcontent -t
else
  printf '{"error":"failed"}\n' | llm-make-mcontent -t
fi
exit 0

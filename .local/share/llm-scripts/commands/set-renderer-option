# vim: ft=sh

shift

if [ "$#" -eq 0 ]; then
  (
    render_utils_path=
    paths=${PATH:+$PATH:}
    while [ -n "$paths" ]; do
      path=${paths%%:*}
      paths=${paths#*:}
      if [ -f "${path:-.}/llm-render-utils" ]; then
        render_utils_path=${path:-.}/llm-render-utils
        break
      fi
    done
    if [ -n "$render_utils_path" ]; then
      sed -n -- '/renderer_opt_/{s/^.*renderer_opt_\([[:alnum:]_]*\).*$/\1/; s/_/-/g; p;}' "$render_utils_path" | sort -u
    fi
  )
  return 0
fi

command eval "renderer_opt_$(printf "%s" "$1" | tr -- '-' '_')="'$2'

_comp_ec() {
  local paths=${PATH:+$PATH:}
  local cur="${COMP_WORDS[COMP_CWORD]}"

  local item
  COMPREPLY=()
  while IFS= read -r item; do
    COMPREPLY+=("$item")
  done < <(
      while [ -n "$paths" ]; do
        local path=${paths%%:*}
        path=${path:-.}
        if [ -d "$path" ] && [ -x "$path" ] && [ -r "$path" ]; then
          (cd -- "$path" && find . -type f -print | grep -F "./$cur" | sed 's/^\.\///g')
        fi
        paths=${paths#*:}
      done
    )
}

complete -o nosort -o bashdefault -o default -F _comp_ec ec


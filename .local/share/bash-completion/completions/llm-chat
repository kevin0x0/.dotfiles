
_comp_cmd_llm_chat() {
  local cur prev
  _comp_get_words cur prev

  case $prev in
    -*c)
      case $cur in
        @*)
          COMPREPLY=()
          local path=
          for path in "${XDG_CONFIG_HOME:-$HOME/.config}/llm-scripts" "${XDG_DATA_HOME:-$HOME/.local/share}/llm-scripts"; do
            [ -d "$path" ] || continue
            _comp_compgen -aP @ -C "$path" -- filedir
          done

          local paths=${XDG_DATA_DIRS:-/usr/local/share/:/usr/share/}
          paths=${paths:+$paths:}
          while [ -n "$paths" ]; do
            path=${paths%%:*}
            paths=${paths#*:}

            path=${path:-.}/llm-scripts
            [ -d "$path" ] || continue
            _comp_compgen -aP @ -C "$path" -- filedir
          done
          ;;
        *)
          _comp_compgen -- filedir
          ;;
      esac
      ;;
    -*o)
      local llm_chat_path=$(command -v llm-chat 2>/dev/null) || return
      _comp_compgen -- split -F $'\n' -- "$(sed -n -- '/opt_/{s/^.*opt_\([[:alnum:]_]*\).*$/\1/; s/_/-/g; p;}' "$llm_chat_path" | sort -u)"
      compopt -o nospace
      ;;
    *)
      local options=$(llm-chat -o print-options | tr -d ':')
      options=${options//?/-& }
      _comp_compgen -- split -F ' ' -- "$options"
      ;;
  esac
}

complete -o default -F _comp_cmd_llm_chat llm-chat


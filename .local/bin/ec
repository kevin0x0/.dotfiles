#!/bin/sh

count=$#
while [ "$count" -ne 0 ]; do
  count=$((count - 1))
  arg=$1
  shift

  if ! f=$(command -v -- "$arg"); then
    i18n -n common '$1 does not exist' "$arg" >&2
    continue
  fi

  case $f in
    /*)
      set -- "$@" "$f"
      ;;
    *)
      i18n -n common '$1 does not exist' "$arg" >&2
      ;;
  esac
done

if [ "$#" -eq 0 ]; then
  i18n -n common "None of provided files exists" >&2
  exit 1
fi

"${EDITOR:-vim}" -- "$@"

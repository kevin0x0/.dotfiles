#!/bin/sh

find_in_path() {
  paths=${PATH:+$PATH:}
  while [ -n "$paths" ]; do
    path=${paths%%:*}
    if [ -f "${path:-$PWD}/$1" ]; then
      printf "%s\n" "${path:-$PWD}/$1"
      return 0
    fi
    paths=${paths#*:}
  done
  return 1
}

count=$#
while [ "$count" -ne 0 ]; do
  count=$((count - 1))
  arg=$1
  shift

  if ! f=$(find_in_path "$arg" && echo x); then
    i18n -n common '$1 does not exist' "$arg" >&2
    continue
  fi
  set -- "$@" "${f%$'\nx'}"
done

if [ "$#" -eq 0 ]; then
  i18n -n common "None of provided files exists" >&2
  exit 1
fi

"${EDITOR:-vim}" -- "$@"

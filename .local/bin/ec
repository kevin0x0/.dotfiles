#!/bin/sh

count=$#
while [ "$count" -ne 0 ]; do
  count=$((count - 1))
  arg=$1
  shift

  if ! f=$(command -v -- "$arg"); then
    printf "%s not found\n" "$arg" >&2
    continue
  fi

  case $f in
    /*)
      set -- "$@" "$f"
      ;;
    *)
      printf "%s not found\n" "$arg" >&2
      ;;
  esac
done

if [ "$#" -eq 0 ]; then
  printf "none of provided files exists\n" >&2
  exit 1
fi

"${EDITOR:-vim}" -- "$@"

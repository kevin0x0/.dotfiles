#!/bin/sh

llmcc_set_public_files_var() {
  llmcc_volatile_fileids=$1/volatile-file-ids
  llmcc_persistent_fileids=$1/persistent-file-ids
  llmcc_tool_list=$1/tool-list
  llmcc_default_tool_name_list=$1/default-tool-name-list
  llmcc_extra_tool_name_list=$1/extra-tool-name-list
  llmcc_hooks_dir=$1/hooks
  llmcc_tool_state_dir=$1/tool-state
  llmcc_hook_state_dir=$1/hook-state
  llmcc_hook_shared_state_dir=$1/hook-shared-state
  llmcc_hook_log_file=$1/hook-log
  llmcc_hook_log_tmp_file=$1/hook-log-tmp
}

llmcc_helper_set_tmp() {
  if [ "$1" = -d ]; then
    tmp=$(tmpfile -d) || exit 1
  else
    tmp=$(tmpfile) || exit 1
  fi

  cleanup() {
    if [ -n "$tmp" ]; then
      [ -d "$tmp" ] && rm -rf -- "$tmp" || rm -f -- "$tmp"
    fi

    if [ -n "$1" ]; then
      trap - "$1"
      kill -"$1" "$$"
    fi
  }
  trap 'cleanup' EXIT
  for sig in INT TERM QUIT; do
    trap "cleanup "$sig"" "$sig"
  done
}

llmcc_operate_extra_tool() (
  OPTIND=1
  opt_print=
  opt_mode=
  while getopts "pm:" opt; do
    case $opt in
      p) opt_print=1 ;;
      m) opt_mode=$OPTARG ;;
      \?) exit 2 ;;
    esac
  done
  shift "$((OPTIND - 1))"

  trap '' INT

  # The key invariant:
  # extralist ∩ defaultlist = Ø
  # both lists are sorted

  extralist=$llmcc_extra_tool_name_list
  defaultlist=$llmcc_default_tool_name_list
  for list in "$extralist" "$defaultlist"; do
    [ -f "$list" ] || : >"$list" || exit 1
  done

  llmcc_helper_set_tmp -d
  case $opt_mode in
    add)
      llm-expand-toolspec -- "$@" \
        | comm -23 - "$extralist" \
        | comm -23 - "$defaultlist" >"$tmp/delta"
      ;;
    remove)
      llm-expand-toolspec -- "$@" \
        | comm -12 - "$extralist" >"$tmp/delta"
      ;;
    *)
      exit 2
      ;;
  esac
  if [ -n "$opt_print" ]; then
    cat -- "$tmp/delta"
  fi

  case $opt_mode in
    add)
      sort -mo "$extralist" -- "$tmp/delta" "$extralist"
      ;;
    remove)
      comm -13 --  "$tmp/delta" "$extralist" >"$tmp/result"
      cp -- "$tmp/result" "$extralist"
      ;;
  esac
)

llmcc_generate_tool_list() (
  OPTIND=1
  opt_parameters=
  opt_description=
  opt_parameters_given=
  opt_description_given=
  opt_defer_loading=
  while getopts "d:p:l" opt; do
    case $opt in
      d) opt_description=$OPTARG; opt_description_given=1 ;;
      p) opt_parameters=$OPTARG; opt_parameters_given=1 ;;
      l) opt_defer_loading=1 ;;
      \?) exit 2 ;;
    esac
  done
  set --
  [ -n "$opt_description_given" ] && set -- "$@" -d "$opt_description"
  [ -n "$opt_parameters_given" ] && set -- "$@" -p "$opt_parameters"
  [ -n "$opt_defer_loading" ] && set -- "$@" -l

  trap '' INT
  {
    if [ -f "$llmcc_default_tool_name_list" ]; then
      tr '\n' '\000' <"$llmcc_default_tool_name_list" \
        | xargs -r0 -- llm-tool-list --
    fi
    if [ -f "$llmcc_extra_tool_name_list" ]; then
      tr '\n' '\000' <"$llmcc_extra_tool_name_list" \
        | xargs -r0 -- llm-tool-list "$@" --
    fi
  } | jq -cs -- 'select(length != 0)' >"$llmcc_tool_list"
)

llmcc_dump_vars() {
  for llmcc_variable_name; do
    case $llmcc_variable_name in
      *[![:alnum:]_]*|[[:digit:]]*|'')
        printf "invalid variable name to dump: %s\n" "$llmcc_variable_name" >&2
        continue
        ;;
    esac

    eval "llmcc_variable_value=\$$llmcc_variable_name"
    printf "%s=" "$llmcc_variable_name"
    while [ -n "$llmcc_variable_value" ]; do
      part=${llmcc_variable_value%%[$'\n\'']*}
      printf "'%s'" "$part"
      llmcc_variable_value=${llmcc_variable_value#"$part"}
      case $llmcc_variable_value in
        $'\n'*)
          printf "%s" "\$'\\n'"
          llmcc_variable_value=${llmcc_variable_value#?}
          ;;
        $'\''*)
          printf "%s" "\$'\\''"
          llmcc_variable_value=${llmcc_variable_value#?}
          ;;
      esac
    done
    echo
  done
}

llmcc_get_tool_state_dir() {
  command eval " $1"='$llmcc_tool_state_dir/$2'
}

llmcc_hook_get_state_dir() {
  command eval " $1"='$llmcc_hook_state_dir/$2/$3'
}

llmcc_hook_dump_vars() {
  llmcc_dump_vars "$@"
}

llmcc_hook_get_my_state_dir() {
  llmcc_hook_get_state_dir "$1" "$llmcc_event" "${llmcc_hook_script##*/}"
  command eval "[ -e \"\$$1\" ] || mkdir -p -- \"\$$1\""
}

llmcc_hook_get_shared_state_dir() {
  case $2 in
    .*|*[![:alnum:]_.-]*|'')
      printf "invalid shared state id: %s\n" "$2" >&2
      return 1
      ;;
  esac
  command eval " $1"='$llmcc_hook_shared_state_dir/$2' || return
  command eval "[ -e \"\$$1\" ] || mkdir -p -- \"\$$1\""
}

llmcc_hook_remove() {
  llmcc_f=$llmcc_hooks_dir/$1/$2
  if [ ! -e "$llmcc_f" ]; then
    printf "hook doesn't exist: %s\n" "$1/$2" >&2
    return 1
  fi
  rm -rf -- "$llmcc_f"
  llmcc_hook_get_state_dir llmcc_hook_state_d "$1" "$2"
  if [ -e "$llmcc_hook_state_d" ]; then
    rm -rf -- "$llmcc_hook_state_d"
  fi
}

llmcc_hook_default_runner() (
  trap - INT
  . -- "$1"
)

llmcc_hook_log() {
  llmcc_hook_log_level=$1
  llmcc_hook_log_time=$(date "+%Y-%m-%dT%H:%M:%S")
  shift
  for llmcc_hook_log_msg; do
    while [ -n "$llmcc_hook_log_msg" ]; do
      printf "[%s] %s: %s\n" \
        "$llmcc_hook_log_level" \
        "$llmcc_hook_log_time" \
        "${llmcc_hook_log_msg%%$'\n'*}"

      case $llmcc_hook_log_msg in
        *$'\n'*)  llmcc_hook_log_msg=${llmcc_hook_log_msg#*$'\n'} ;;
        *)        llmcc_hook_log_msg= ;;
      esac
    done
  done >&2
}

llmcc_run_hooks() {
  llmcc_hook_runner=${1:-llmcc_hook_default_runner}
  shift
  for llmcc_event; do
    for llmcc_hook_script in "$llmcc_hooks_dir/$llmcc_event"/*; do
      [ -f "$llmcc_hook_script" ] || continue
      "$llmcc_hook_runner" "$llmcc_hook_script" \
        </dev/null 2>"$llmcc_hook_log_tmp_file"

      if [ -s "$llmcc_hook_log_tmp_file" ]; then
        tr '\n' '\000' <"$llmcc_hook_log_tmp_file" \
          | xargs -r0 -- printf "[$llmcc_event/${llmcc_hook_script##*/}] %s\n" \
            >>"$llmcc_hook_log_file"
        : >"$llmcc_hook_log_tmp_file"
      fi

      case $llmcc_hook_script in
        *.oneshot)
          llmcc_hook_remove "$llmcc_event" "${llmcc_hook_script##*/}" 2>/dev/null
          ;;
      esac
    done
  done
}

llmcc_get_fileid() (
  if [ -z "$1" ]; then
    printf "base url for Files API not provided\n" >&2
    exit 1
  fi

  if [ -z "$2" ]; then
    printf "api key not provided\n" >&2
    exit 1
  fi

  if [ -z "$3" ]; then
    printf "cache key not provided\n" >&2
    exit 1
  fi

  if [ -z "$4" ]; then
    printf "purpose not provided\n" >&2
    exit 1
  fi

  if [ -z "$5" ]; then
    printf "file not provided\n" >&2
    exit 1
  fi

  if [ "$#" -ne 5 ]; then
    printf "not exactly 5 arguments\n" >&2
    exit 1
  fi

  trap '' INT
  llmcc_helper_set_tmp

  if ! llm-file-manager -u "$1" -FNk 0 -K "$3" -p "$4" -Ulm -- "$5" >"$tmp" <<EOF
$2
EOF
  then
    exit 1
  fi

  add_to_file=
  if jq -e -- '.expires_at' "$tmp" >/dev/null 2>&1; then
    add_to_file=$llmcc_volatile_fileids
  else
    add_to_file=$llmcc_persistent_fileids
  fi

  trap '' INT

  cat "$tmp" >>"$add_to_file"
  jq -r -- '.id' "$tmp"
  jq -cs -- 'unique_by(.id)[]' "$add_to_file" >"$tmp"
  cp -- "$tmp" "$add_to_file"
  rm "$tmp"
)

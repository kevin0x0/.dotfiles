#!/bin/sh

llm_chat_set_public_files_var() {
  llm_chat_volatile_fileids=$1/volatile-file-ids
  llm_chat_persistent_fileids=$1/persistent-file-ids
  llm_chat_tool_list=$1/tool-list
  llm_chat_default_tool_name_list=$1/default-tool-name-list
  llm_chat_extra_tool_name_list=$1/extra-tool-name-list
  llm_chat_hooks_dir=$1/hooks
  llm_chat_tool_state_dir=$1/tool-state
}

llm_chat_helper_set_tmp() {
  if [ "$1" = -d ]; then
    tmp=$(tmpfile -d) || exit 1
  else
    tmp=$(tmpfile) || exit 1
  fi

  cleanup() {
    if [ -n "$tmp" ]; then
      [ -d "$tmp" ] && rm -rf -- "$tmp" || rm -f -- "$tmp"
    fi

    if [ -n "$1" ]; then
      trap - "$1"
      kill -"$1" "$$"
    fi
  }
  trap 'cleanup' EXIT
  for sig in INT TERM QUIT; do
    trap "cleanup "$sig"" "$sig"
  done
}

llm_chat_operate_extra_tool() (
  OPTIND=1
  opt_print=
  opt_mode=
  while getopts "pm:" opt; do
    case $opt in
      p) opt_print=1 ;;
      m) opt_mode=$OPTARG ;;
      \?) exit 2 ;;
    esac
  done
  shift "$((OPTIND - 1))"

  trap '' INT

  # The key invariant:
  # extralist ∩ defaultlist = Ø
  # both lists are sorted

  extralist=$llm_chat_extra_tool_name_list
  defaultlist=$llm_chat_default_tool_name_list
  for list in "$extralist" "$defaultlist"; do
    [ -f "$list" ] || : >"$list" || exit 1
  done

  llm_chat_helper_set_tmp -d
  case $opt_mode in
    add)
      llm-expand-toolspec -- "$@" \
        | comm -23 - "$extralist" \
        | comm -23 - "$defaultlist" >"$tmp/delta"
      ;;
    remove)
      llm-expand-toolspec -- "$@" \
        | comm -12 - "$extralist" >"$tmp/delta"
      ;;
    *)
      exit 2
      ;;
  esac
  if [ -n "$opt_print" ]; then
    cat -- "$tmp/delta"
  fi

  case $opt_mode in
    add)
      cat -- "$tmp/delta" >>"$extralist"
      ;;
    remove)
      comm -13 --  "$tmp/delta" "$extralist" >"$tmp/result"
      cp -- "$tmp/result" "$extralist"
      ;;
  esac
)

llm_chat_generate_tool_list() (
  OPTIND=1
  opt_parameters=
  opt_description=
  opt_parameters_given=
  opt_description_given=
  opt_defer_loading=
  while getopts "d:p:l" opt; do
    case $opt in
      d) opt_description=$OPTARG; opt_description_given=1 ;;
      p) opt_parameters=$OPTARG; opt_parameters_given=1 ;;
      l) opt_defer_loading=1 ;;
      \?) exit 2 ;;
    esac
  done
  set --
  [ -n "$opt_description_given" ] && set -- "$@" -d "$opt_description"
  [ -n "$opt_parameters_given" ] && set -- "$@" -p "$opt_parameters"
  [ -n "$opt_defer_loading" ] && set -- "$@" -l

  trap '' INT
  {
    if [ -f "$llm_chat_default_tool_name_list" ]; then
      tr '\n' '\000' <"$llm_chat_default_tool_name_list" \
        | xargs -r0 -- llm-tool-list --
    fi
    if [ -f "$llm_chat_extra_tool_name_list" ]; then
      tr '\n' '\000' <"$llm_chat_extra_tool_name_list" \
        | xargs -r0 -- llm-tool-list "$@" --
    fi
  } | jq -cs -- 'select(length != 0)' >"$llm_chat_tool_list"
)

llm_chat_get_tool_state_dir() {
  command eval " $1"='$llm_chat_tool_state_dir/$2'
  command eval "[ -e \"\$$1\" ] || mkdir -p -- \"\$$1\""
}

llm_chat_run_hooks() {
  for llm_chat_hookable_event; do
    for llm_chat_hook_script in "$llm_chat_hooks_dir/$llm_chat_hookable_event"/*; do
      [ -f "$llm_chat_hook_script" ] || continue
      (trap - INT; . -- "$llm_chat_hook_script")
      case $llm_chat_hook_script in
        *.oneshot) rm -f -- "$llm_chat_hook_script" ;;
      esac
    done
  done
}

llm_chat_get_fileid() (
  if [ -z "$1" ]; then
    printf "base url for Files API not provided\n" >&2
    exit 1
  fi

  if [ -z "$2" ]; then
    printf "api key not provided\n" >&2
    exit 1
  fi

  if [ -z "$3" ]; then
    printf "cache key not provided\n" >&2
    exit 1
  fi

  if [ -z "$4" ]; then
    printf "purpose not provided\n" >&2
    exit 1
  fi

  if [ -z "$5" ]; then
    printf "file not provided\n" >&2
    exit 1
  fi

  if [ "$#" -ne 5 ]; then
    printf "not exactly 5 arguments\n" >&2
    exit 1
  fi

  trap '' INT
  llm_chat_helper_set_tmp

  if ! llm-file-manager -u "$1" -FNk 0 -K "$3" -p "$4" -Ulm -- "$5" >"$tmp" <<EOF
$2
EOF
  then
    exit 1
  fi

  add_to_file=
  if jq -e -- '.expires_at' "$tmp" >/dev/null 2>&1; then
    add_to_file=$llm_chat_volatile_fileids
  else
    add_to_file=$llm_chat_persistent_fileids
  fi

  trap '' INT

  cat "$tmp" >>"$add_to_file"
  jq -r -- '.id' "$tmp"
  jq -cs -- 'unique_by(.id)[]' "$add_to_file" >"$tmp"
  cp -- "$tmp" "$add_to_file"
  rm "$tmp"
)

#!/bin/sh

if [ "$#" -eq 0 ]; then
  printf "provide an instance\n" >&2
  exit 2
fi

instance=$1
case $instance in
  -*)
    instance=default
    ;;
  *)
    shift
    ;;
esac


opt_files_base_url=
opt_api_key=
opt_files_default_purpose=user_data

. llm-config-utils

llm_scriptname=llm-files-api-configured
source_configfile "@instances/$instance" || exit

eval_api_key

llm-files-api -u "$opt_files_base_url" -FNk 0 -p "$opt_files_default_purpose" "$@" <<EOF
$opt_api_key
EOF

#!/bin/sh

. llm-config-utils

opt_input=
opt_trim_newline=
opt_interrupt=
while getopts "i:INS:" opt; do
  case $opt in
    i)
      opt_input=$OPTARG
      ;;
    I)
      opt_interrupt=1
      ;;
    N)
      opt_trim_newline=1
      ;;
    S)
      case $OPTARG in
        *=*)
          ;;
        *)
          printf "not in pattern: [[:alpha:]][[:alnum:]_]*=[[:digit:]]\n" >&2
          exit 2
          ;;
      esac
      option_key=${OPTARG%%=*}
      option_value_src=${OPTARG#*=}
      tmp=$(cat <&"$option_value_src" && echo x)
      tmp=${tmp%x}
      [ -n "$opt_trim_newline" ] && tmp=${tmp%$'\n'}
      opt_trim_newline=
      eval " $option_key"='$tmp'
      ;;
    \?)
      exit 2
      ;;
  esac
done
shift "$((OPTIND - 1))"

if [ -z "$opt_input" ]; then
  exec 3<&0
else
  exec 3<"$opt_input"
fi

call() {
  : >"$errmsg"
  if [ -n "$opt_interrupt" ]; then
    printf "interrupted by user\n" >"$errmsg"
    return 129
  elif [ -z "$execpath" ]; then
    printf "missing tool: '%s'\n" "$name" >&2
    printf "%s\n" 'can not find this tool' >"$errmsg"
    return 1
  else
    set -- "${execpath%/*}" "$@"
    # Allow interruption
    trap ':' INT
    case $execpath in
      */source)
        (. -- "$execpath")
        ;;
      */call)
        if [ -x "$execpath" ]; then
          "$execpath" "$@"
        elif [ -r "$execpath" ]; then
          sh -- "$execpath" "$@"
        else
          printf "%s is neither executable nor readable\n" "$execpath" >&2
          printf "%s\n" 'this tool neither executable nor readable' >"$errmsg"
          false
        fi
        ;;
    esac
    exitcode=$?
    trap '' INT

    [ "$exitcode" -eq 0 ] && return 0
    if [ "$exitcode" -gt 128 ]; then
      # Consider it to be interrupted
      notify-state "$interruption_state"
      printf "interrupted by user\n" >"$errmsg"
      return "$exitcode"
    else
      if [ ! -s "$errmsg" ]; then
        printf "failed to execute this tool\n" >"$errmsg"
      fi
      return "$exitcode"
    fi
  fi
}

call_normal() {
  {
    if ! call "$@" <"$tool_input"; then
      # Output a NUL character, so jq must fail and write nothing to stdout
      printf "\0"
    fi
  } | jq -cs --argjson call_id "$id" --arg type "$type" --arg name "$name" \
      '{$name,$call_id,$type,output:.}' 2>/dev/null

  if [ "$?" -ne 0 ]; then
    # jq failed
    if [ ! -s "$errmsg" ]; then
      printf "this tool generated broken json(can not parsed as StringOutput or OutputContentList)\n" >"$errmsg"
    fi
    jq -Rsc '{"llm-tool-call-error":.}' <"$errmsg" \
      | llm-make-mcontent -t \
      | jq -cs --argjson call_id "$id" --arg type "$type" --arg name "$name" \
          '{$name,$call_id,$type,"output":.}'
  fi
  true
}

call_builtin() {
  call "$@" <"$tool_input"
  exitcode=$?
  if [ "$exitcode" -gt 128 ]; then
    # Consider it to be interrupted
    on_interruption=
    locate_config_item on_interruption "tools/$name/on-interruption"

    if [ -z "$on_interruption" ]; then
      printf "'%s' not found\n" "tools/$name/on-interruption" >&2
      return "$exitcode"
    fi

    if ! "$on_interruption" <"$tool_input"; then
      printf "'%s' failed\n" "$on_interruption" >&2
      return 1
    fi

    return 0
  fi
}

find_and_call() {
  type=$1
  id=$2
  name=$3
  shift 3

  case $type in
    function_call)
      type=function_call_output
      ;;
    custom_tool_call)
      type=custom_tool_call_output
      ;;
    api_builtin)
      type=
      ;;
    *)
      while IFS= read -r argpart; do
        case $argpart in
          __END__)
            break
            ;;
        esac
      done
      ;;
  esac

  execpath=
  set_execpath() {
    for path in "$1/call" "$1/source"; do
      [ -f "$path" ] || continue
      execpath=$path
      return 0
    done
    return 1
  }

  for_config_item "tools/$name" set_execpath

  while IFS= read -r argpart; do
    case $argpart in
      __END__)
        break
        ;;
    esac
    printf "%s" "$argpart"
  done | jq -j '.' >"$tool_input"

  if [ -z "$type" ]; then
    # built-in tool
    call_builtin "$@"
  else
    call_normal "$@"
  fi
}

cleanup() {
  [ -n "$statedir" ] && rm -rf -- "$statedir"
  if [ -n "$1" ]; then
    trap - "$1"
    kill -"$1" "$$"
  fi
}
statedir=
statedir=$(tmpfile -d)
tool_input=$statedir/tool-input
errmsg=$statedir/errmsg
trap 'cleanup' EXIT
trap 'cleanup TERM' TERM
trap 'cleanup QUIT' QUIT
trap '' INT

interruption_state=llm-tool-call-interrupted-$$

jq_program='
def chunk: if length != 0 then range(0;length;512) as $n | .[$n:$n+512] end;
if .type == "function_call" or .type == "custom_tool_call" then
  .type, (.call_id | @json), .name, (.arguments // .input | chunk | @json), "__END__"
elif .type | endswith("_call") then
  select($filterout[.type] == null) |
  "api_builtin", null, "_builtin_" + (.type | rtrimstr("_call")), @json, "__END__"
else
  empty
end
'

# These tool calls are handled in server side.
filterout='{
  "file_search_call":true,
  "computer_call":true,
  "web_search_call":true,
  "image_generation_call":true,
  "code_interpreter_call":true,
  "mcp_call":true
}'

jq -rc --argjson filterout "$filterout" "$jq_program" <&3 \
  | {
      fatal_error=
      while read -r type && read -r id && read -r toolname; do
        find_and_call "$type" "$id" "$toolname" "$@" || fatal_error=$?
      done

      if [ -n "$fatal_error" ]; then
        notify-state -c "$interruption_state"
        exit 1
      elif notify-state -tc "$interruption_state"; then
        exit 5
      else
        exit 0
      fi
    }

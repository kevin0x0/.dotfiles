#!/bin/sh

. llm-config-utils

opt_input=
opt_fake_output=
opt_trim_newline=
while getopts "i:f:F:NS:" opt; do
  case $opt in
    i)
      opt_input=$OPTARG
      ;;
    f)
      opt_fake_output=$(llm-make-mcontent -t -- "$OPTARG")
      ;;
    F)
      opt_fake_output=$OPTARG
      ;;
    N)
      opt_trim_newline=1
      ;;
    S)
      case $OPTARG in
        *=*)
          ;;
        *)
          printf "not in pattern: [[:alpha:]][[:alnum:]_]*=[[:digit:]]\n" >&2
          exit 2
          ;;
      esac
      option_key=${OPTARG%%=*}
      option_value_src=${OPTARG#*=}
      tmp=$(cat <&"$option_value_src" && echo x)
      tmp=${tmp%x}
      [ -n "$opt_trim_newline" ] && tmp=${tmp%$'\n'}
      opt_trim_newline=
      eval " $option_key"='$tmp'
      ;;
    \?)
      exit 2
      ;;
  esac
done
shift "$((OPTIND - 1))"

if [ -z "$opt_input" ]; then
  exec 3<&0
else
  exec 3<"$opt_input"
fi

call() {
  set -- "${execpath%/*}" "$@"
  errmsg=
  if [ -n "$opt_fake_output" ]; then
    printf "%s" "$opt_fake_output"
  elif [ -z "$execpath" ]; then
    printf "missing tool: '%s'\n" "$name" >&2
    errmsg='can not find this tool'
    false
  else
    case $execpath in
      */source)
        (. -- "$execpath")
        ;;
      */call)
        if [ -x "$execpath" ]; then
          "$execpath" "$@"
        elif [ -r "$execpath" ]; then
          sh -- "$execpath" "$@"
        else
          printf "%s is neither executable nor readable\n" "$execpath" >&2
          errmsg='this tool neither executable nor readable'
          false
        fi
        ;;
    esac
  fi
}

call_normal() {
  if ! call "$@"; then
    if [ -n "$errmsg" ]; then
      jq --arg err "$errmsg" '{"error": $err}' | llm-make-mcontent -t
    else
      llm-make-mcontent -t -- '{"error": "failed to execute this tool"}'
    fi
  fi \
    | jq -cs --argjson call_id "$id" --arg type "$type" --arg name "$name" \
      '{"name":$name,"call_id":$call_id,"type":$type,"output":.}' 2>/dev/null

  if [ "$?" -ne 0 ]; then
    err='{"error":"this tool generated broken json(can not parsed as StringOutput or OutputContentList)"}'
    jq -cs --argjson call_id "$id" --arg type "$type" --arg name "$name" \
      --arg err "$err" \
      '{"name":$name,"call_id":$call_id,"type":$type,"output":$err}'
  fi
}

call_builtin() {
  call "$@"
}

find_and_call() {
  type=$1
  id=$2
  name=$3
  tmpfile=$4
  shift 4

  case $type in
    function_call)
      type=function_call_output
      ;;
    custom_tool_call)
      type=custom_tool_call_output
      ;;
    api_builtin)
      type=
      ;;
    *)
      while IFS= read -r argpart; do
        case $argpart in
          __END__)
            break
            ;;
        esac
      done
      ;;
  esac

  execpath=
  set_execpath() {
    for path in "$1/call" "$1/source"; do
      [ -f "$path" ] || continue
      execpath=$path
      return 0
    done
    return 1
  }

  for_config_item "tools/$name" set_execpath

  while IFS= read -r argpart; do
    case $argpart in
      __END__)
        break
        ;;
    esac
    printf "%s" "$argpart"
  done >"$tmpfile"

  if [ -z "$type" ]; then
    # built-in tool
    call_builtin "$@" <"$tmpfile"
  else
    jq -sj '.[]' <"$tmpfile" | call_normal "$@"
  fi
}

tmpfile=$(tmpfile)
trap 'rm -- "$tmpfile"' EXIT
trap 'rm -- "$tmpfile"; trap - INT; kill -INT "$$"' INT
trap 'rm -- "$tmpfile"; trap - TERM; kill -TERM "$$"' TERM
trap 'rm -- "$tmpfile"; trap - QUIT; kill -QUIT "$$"' QUIT

jq_program='
def chunk: if length != 0 then range(0;length;512) as $n | .[$n:$n+512] end;
if .type == "function_call" or .type == "custom_tool_call" then
  .type, (.call_id | @json), .name, (.arguments // .input | chunk | @json), "__END__"
elif .type | endswith("_call") then
  select($filterout[.type] == null) |
  "api_builtin", null, "_builtin_" + (.type | rtrimstr("_call")), @json, "__END__"
else
  empty
end
'
filterout='{
  "file_search_call":true,
  "computer_call":true,
  "web_search_call":true,
  "image_generation_call":true,
  "code_interpreter_call":true,
  "mcp_call":true
}'

jq -rc --argjson filterout "$filterout" "$jq_program" <&3 \
  | {
    exitcode=0
    while read -r type && read -r id && read -r toolname; do
      find_and_call "$type" "$id" "$toolname" "$tmpfile" "$@" || exitcode=$?
    done
    exit "$exitcode"
  }

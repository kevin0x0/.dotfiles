#!/bin/sh

opt_test_uri=
opt_terminator=$'\n'

while getopts "ut:" opt; do
  case $opt in
    u)
      opt_test_uri=1
      ;;
    t)
      opt_terminator=$OPTARG
      ;;
    \?)
      exit 2
      ;;
  esac
done
shift "$((OPTIND - 1))"

letters=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ
digits=0123456789
chars_allowed_in_uri=$(printf "%s" "-._~!\$&'()*+,;=:@/$letters$digits" | tr -d "$opt_terminator")

# Is it already a URI?
# Here we don’t follow the RFC3986 strictly; instead, we check
# heuristically.
is_uri() {
  case $1 in
    *:*)
      schema=${1%%:*}
      case $schema in
        [$letters]*)
          case $schema in
            *[!-+.$letters$digits]*)
              ;;
            *)
              return 0
              ;;
          esac
          ;;
      esac
      ;;
  esac
  return 1
}

if [ -n "$opt_test_uri" ]; then
  for arg; do
    is_uri "$arg" || exit 1
  done
  exit 0
fi

for arg; do
  is_uri=
  if is_uri "$arg"; then
    # It is a URI
    is_uri=1
    case $arg in
      *"$opt_terminator"*)
        # But it contains a terminator, need do percent encoding
        ;;
      *)
        # It doesn't contain a terminator, skip it
        printf "%s%s" "$arg" "$opt_terminator"
        continue
        ;;
    esac
  fi

  # If it is not a URI, make it a URI with file schema
  if [ -z "$is_uri" ]; then
    arg=$(normpath -t x -- "$arg")
    arg=file://${arg%x}
  fi

  # Percent encoding
  while [ -n "$arg" ]; do
    head=${arg%%[$chars_allowed_in_uri]*}
    if [ -n "$head" ]; then
      printf "%s" "$head" \
        | od -vA n -t x1 \
        | sed -E 's/[[:space:]]+/ /g' \
        | tr '[:lower:]' '[:upper:]' \
        | {
            out=
            while read line; do
              for hex in $line; do
                hex=00$hex
                out=$out%${hex#"${hex%??}"}
              done
            done
            printf "%s" "$out"
          }

      arg=${arg#"$head"}
    fi

    head=${arg%%[!$chars_allowed_in_uri]*}
    arg=${arg#"$head"}
    printf "%s" "$head"
  done

  printf "%s" "$opt_terminator"
done

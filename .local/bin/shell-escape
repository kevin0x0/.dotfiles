#!/bin/sh
# This script is for shells conforming POSIX Issue 8

opt_terminator=' '
while getopts "t:" opt; do
  case $opt in
    t)
      opt_terminator=$OPTARG
      ;;
    \?)
      exit 2
      ;;
  esac
done
shift "$((OPTIND - 1))"

escape_chars=$'\a\b\f\n\r\t\v'
for s; do
  head=${s%%[\\\'$escape_chars]*}
  out="\$'"$head
  s=${s#"$head"}
  while [ -n "$s" ]; do
    case $s in
      \\*)
        out=$out"\\\\"
        ;;
      \'*)
        out=$out"\\'"
        ;;
      [$escape_chars]*)
        case $s in
          $'\a'*) out=$out"\\a" ;;
          $'\b'*) out=$out"\\b" ;;
          $'\f'*) out=$out"\\f" ;;
          $'\n'*) out=$out"\\n" ;;
          $'\r'*) out=$out"\\r" ;;
          $'\t'*) out=$out"\\t" ;;
          $'\v'*) out=$out"\\v" ;;
        esac
        ;;
    esac
    s=${s#?}
    head=${s%%[\\\'$escape_chars]*}
    out=$out$head
    s=${s#"$head"}
  done
  out=$out"'"
  printf "%s%s" "$out" "$opt_terminator"
done

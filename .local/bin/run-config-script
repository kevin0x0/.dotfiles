#!/bin/sh

opt_test_existence=
while getopts "e" opt; do
  case $opt in
    e)
      opt_test_existence=1
      ;;
    \?)
      exit 2
      ;;
  esac
done
shift "$((OPTIND - 1))"

script=$1
shift
scriptpath=

path=${XDG_CONFIG_HOME:-$HOME/.config}
if [ -f "$path/$script" ]; then
  scriptpath="$path/$script"
  [ -x "$path/$script" ] || exit 4
else
  paths=$PATH
  while [ -n "$paths" ]; do
    path=${paths%%:*}
    if [ -f "$path/$script" ]; then
      scriptpath="$path/$script"
      [ -x "$path/$script" ] || exit 4
      break
    fi
    paths=${paths#*:}
  done
fi

[ -z "$scriptpath" ] && exit 3

[ -n "$opt_test_existence" ] && exit 0

exec "$scriptpath" "$@"

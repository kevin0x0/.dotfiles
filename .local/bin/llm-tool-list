#!/bin/sh

. llm-config-utils

opt_parameters=
opt_description=
opt_description_given=
opt_defer_loading=
while getopts "d:p:l" opt; do
  case $opt in
    d) opt_description=$OPTARG; opt_description_given=1 ;;
    p) opt_parameters=$OPTARG; opt_parameters_given=1 ;;
    l) opt_defer_loading=1 ;;
    \?) exit 2 ;;
  esac
done
shift "$((OPTIND - 1))"

generate_normal() {
  set -- --arg name "$name" \
    --arg defer_loading "$opt_defer_loading" \
    --rawfile description "$description" \

  if [ -z "$parameters" ]; then
    jq -cn "$@" '
        {type:"custom",$name,$description} | 
          if $defer_loading != "" then
            .defer_loading = true
          end'
  else
    set -- "$@" --slurpfile params "$parameters"
    jq -cn "$@" '
        {type:"function",$name,$description} |
          if $params[0] then
            .parameters = $params[0]
          end |
          if $defer_loading != "" then
            .defer_loading = true
          end'
    if [ "$?" -ne 0 ]; then
      printf "failed to generate json for '%s' tool\n" "$name" >&2
    fi
  fi
}

generate_injected() {
  set -- --arg name "$name"
  if [ -n "$opt_description_given" ]; then
    command eval "evaluated_description=$opt_description"
    set -- "$@" --arg description "$evaluated_description"
  else
    set -- "$@" --rawfile description "$description"
  fi

  if [ -z "$parameters" ]; then
    jq -cn "$@" '{type:"custom",$name,$description}'
  else
    if [ -n "$opt_parameters_given" ]; then
      set -- "$@" --argjson params "[$opt_parameters]"
    else
      set -- "$@" --slurpfile params "$parameters"
    fi
    jq -cn "$@" '
        {type:"function",$name,$description} |
          if $params[0] then
            .parameters = $params[0]
          end'
    if [ "$?" -ne 0 ]; then
      printf "failed to generate json for '%s' tool\n" "$name" >&2
    fi
  fi
}

for name; do
  generate=
  description=
  parameters=

  llmcu_locate_config_item generate "tools/$name/generate"
  if [ -f "$generate" ]; then
    if [ -r "$generate" ]; then
      (. -- "$generate")
      continue
    fi
  fi

  llmcu_locate_config_item description "tools/$name/description"
  llmcu_locate_config_item parameters "tools/$name/parameters"

  if [ ! -f "$description" ] || [ ! -r "$description" ]; then
    description=/dev/null
  fi
  if [ ! -f "$parameters" ] || [ ! -r "$parameters" ]; then
    parameters=
  fi

  if [ -z "$opt_defer_loading" ] || [ -z "$opt_description_given$opt_parameters_given" ]; then
    generate_normal
  else
    generate_injected
  fi
done

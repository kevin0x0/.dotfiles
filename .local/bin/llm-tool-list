#!/bin/sh

. llm-config-utils

for name; do
  generate=
  description=
  parameters=

  locate_config_item generate "tools/$name/generate"
  if [ -f "$generate" ]; then
    if [ -r "$generate" ]; then
      (. -- "$generate")
      continue
    fi
  fi

  locate_config_item description "tools/$name/description"
  locate_config_item parameters "tools/$name/parameters"

  if [ ! -f "$description" ] || [ ! -r "$description" ]; then
    description=/dev/null
  fi
  if [ ! -f "$parameters" ] || [ ! -r "$parameters" ]; then
    parameters=
  fi

  if [ -z "$parameters" ]; then
    jq -cn --rawfile desc "$description" --arg name "$name" \
      '{"type":"custom","name":$name,"description":$desc}'
  else
    jq -cn --rawfile desc "$description" --arg name "$name" \
      --slurpfile params "$parameters" \
      '{"type":"function","name":$name,"description":$desc,"parameters":$params[0]}'
    if [ "$?" -ne 0 ]; then
      printf "failed to generate json for '%s' tool\n" "$name" >&2
    fi
  fi
done

#!/bin/sh

. llm-config-utils
. llm-render-utils

opt_color=auto
opt_color_ansi=
llmcuopt_fromfile=

llm_scriptname=llm-render
[ -f "$llmcu_configdir/llm-render" ] && . -- "$llmcu_configdir/llm-render"

while getopts "f:o:O:c:" opt; do
  case $opt in
    f)
      llmcuopt_fromfile=1
      ;;
    [oO])
      option_prefix=opt_
      [ "$opt" = O ] && option_prefix=
      llmcu_evaluate_option "$option_prefix$OPTARG"
      ;;
    c)
      llmcu_source_configfile "$OPTARG"
      ;;
    \?)
      exit 2
      ;;
  esac
done

case $opt_color in
  auto)
    opt_color_ansi=
    [ -t 1 ] && opt_color_ansi=1
    ;;
  never)
    opt_color_ansi=
    ;;
  always)
    opt_color_ansi=1
    ;;
esac

tmpdir=$(tmpfile -d) || exit
trap 'rm -rf -- "$tmpdir"' EXIT
mkfifo "$tmpdir/fifo" || exit
dispatch_render_event "$tmpdir/fifo"

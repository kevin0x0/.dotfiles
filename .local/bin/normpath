#!/bin/sh

opt_terminator='\n'
opt_directory=$PWD

while getopts "t:d:n" opt; do
  case $opt in
    t)
      opt_terminator=$OPTARG
      ;;
    d)
      case $OPTARG in
        /*) opt_directory=$OPTARG ;;
        *)  opt_directory=$PWD/$OPTARG ;;
      esac
      ;;
    n)
      opt_terminator='\0000'
      ;;
    \?)
      exit 2
      ;;
  esac
done
shift "$((OPTIND - 1))"

for path; do
  case $path in
    [!/]*)
      components=$opt_directory/$path
      ;;
    *)
      components=$path
      ;;
  esac
  components=${components#/}/
  norm=
  while [ -n "$components" ]; do
    component=${components%%/*}
    components=${components#*/}
    case $component in
      ..)
        if [ -z "$norm" ]; then
          printf "bad pathname: %s\n" "$path" >&2
          exit 1
        fi
        norm=${norm%/*}
        ;;
      .|'')
        continue
        ;;
      *)
        norm=$norm/$component
        ;;
    esac
  done

  printf "%s%b" "${norm:-/}" "$opt_terminator"
done

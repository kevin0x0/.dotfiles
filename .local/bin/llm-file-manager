#!/bin/sh

opt_files_base_url=
opt_api_key=
opt_api_key_cmd=
opt_cache_key=
opt_purpose=user_data
opt_clean=
opt_update=
opt_list=
opt_all=
opt_metadata=
opt_delete=
opt_trash=
opt_deleteboth=

opt_nul_terminated=

. llm-argparse-utils

llm_scriptname=llm-file-manager
[ -f "$llm_configdir/file-manager-config" ] && . -- "$llm_configdir/file-manager-config"

while getopts "c:u:E:k:K:p:fFNaCUlmdtn" opt; do
  case $opt in
    c)
      source_configfile "$OPTARG"
      ;;
    u)
      getarg opt_files_base_url "$OPTARG"
      ;;
    E)
      getarg opt_api_key_cmd "$OPTARG"
      opt_api_key=
      ;;
    k)
      getarg opt_api_key "$OPTARG"
      opt_api_key_cmd=
      ;;
    K)
      getarg opt_cache_key "$OPTARG"
      ;;
    p)
      getarg opt_purpose "$OPTARG"
      ;;
    f)
      set_boolean_option opt_fromfile
      ;;
    F)
      set_boolean_option opt_fromfd
      ;;
    N)
      set_boolean_option opt_getarg_trim_newline
      ;;
    a)
      set_boolean_option opt_all
      ;;
    C)
      set_boolean_option opt_clean
      ;;
    U)
      set_boolean_option opt_update
      ;;
    l)
      set_boolean_option opt_list
      ;;
    m)
      set_boolean_option opt_metadata
      ;;
    d)
      [ -n "$opt_delete" ] && set_boolean_option opt_deleteboth
      set_boolean_option opt_delete
      ;;
    t)
      set_boolean_option opt_trash
      ;;
    n)
      set_boolean_option opt_nul_terminated
      ;;
    \?)
      exit 2
      ;;
  esac
done
shift "$((OPTIND - 1))"

[ -f "$llm_configdir/post-file-manager-config" ] && . -- "$llm_configdir/post-file-manager-config"

eval_api_key

if [ -z "$opt_update$opt_list$opt_delete" ]; then
  opt_list=1
fi

# Normalize filenames
count=$#
while [ "$count" -ne 0 ]; do
  count=$((count - 1))
  f=$1
  shift
  norm=$(normpath -t x -- "$f") || exit
  set -- "$@" "${norm%x}"
done

if [ -z "$opt_files_base_url" ]; then
  i18n -n llm-scripts 'Files API base URL not provided' >&2
  exit 1
fi

if [ -z "$opt_cache_key" ]; then
  i18n -n llm-scripts 'cache key not provided' >&2
  exit 1
fi

if [ -z "$opt_api_key" ]; then
  i18n -n llm-scripts 'API key not provided' >&2
  exit 1
fi

url_idencoded=$(idencode -- "$opt_files_base_url")
cachekey_idencoded=$(idencode -- "$opt_cache_key")
purpose_idencoded=$(idencode -- "$opt_purpose")
cachedir="${XDG_CACHE_HOME:-$HOME/.cache}/llm-scripts/file-manager/$url_idencoded/$cachekey_idencoded/$purpose_idencoded/cache"
trashfile="${XDG_CACHE_HOME:-$HOME/.cache}/llm-scripts/file-manager/$url_idencoded/$cachekey_idencoded/$purpose_idencoded/trash"
if [ ! -d "$cachedir" ] && ! mkdir -p -- "$cachedir"; then
  i18n -n llm-scripts 'failed to create cache directory: $1' "$cachedir" >&2
  exit 1
fi

lockname=llm-file-manager-${url_idencoded}-${cachekey_idencoded}-${purpose_idencoded}
lock "$lockname"
trap 'unlock "$lockname"' EXIT
trap 'unlock "$lockname"; trap - TERM; kill -TERM "$$"' TERM
trap 'unlock "$lockname"; trap - QUIT; kill -QUIT "$$"' QUIT
trap 'unlock "$lockname"; trap - INT; kill -INT "$$"' INT

call_api() {
  {
    jq -Rrs '"opt_api_key=" + (rtrimstr("\n") | @sh) + "\n"' <<EOF
$opt_api_key
EOF
    jq -sr --arg fburl "$opt_files_base_url" --arg purpose "$opt_purpose" --arg mode "$1" -- \
      'range(0;length;10) as $n | "llm-files-api -u " + ($fburl | @sh) + " -NFk 0 -p " + ($purpose | @sh) + " " + $mode + " -- " + (.[$n:$n+10] | map(@sh) | join(" ")) + " <<EOF\n$opt_api_key\nEOF"'
  } | sh
}

update_files() (
  [ "$#" -eq 0 ] && exit 0

  for f; do
    if [ ! -f "$f" ]; then
      i18n -n common '$1 is not a file' "$f" >&2
      exit 1
    fi
  done

  set -o pipefail
  check=$(tmpfile)
  create=$(tmpfile)
  tmp=$(tmpfile)
  trap 'rm -rf -- "$check" "$create" "$tmp"' EXIT

  for f; do
    cachefile=$f
    while [ ! -e "$cachedir/$cachefile" ]; do
      cachefile=${cachefile%/*}
    done

    # Exist
    if [ "$cachefile" = "$f" ]; then
      if [ -d "$cachedir/$cachefile" ]; then
        # But is a directory
        # Move all files under it to trashfile
        find "$cachedir/$cachefile" -type f -print0 \
          | xargs -r0 -- cat -- >&5
        rm -rf -- "$cachedir/$cachefile"
        printf "%s\0" "$cachedir/$f" >&4
      else
        # It is a file
        if [ -n "$(find "$f" -newer "$cachedir/$cachefile")" ]; then
          # The file is newer than cached version, move cachefile to trashfile
          cat -- "$cachedir/$cachefile" >&5
          rm -rf -- "$cachedir/$cachefile"
          printf "%s\0" "$cachedir/$f" >&4
        else
          printf "%s\0" "$cachedir/$f" >&3
        fi
      fi
      continue
    fi

    # Doesn't exist, need to create cache file
    printf "%s\0" "$cachedir/$f" >&4
    if [ -f "$cachedir/$cachefile" ]; then
      # $f's some ancestor is a regular file, move it to trash.
      cat -- "$cachedir/$cachefile" >&5
      rm -rf -- "$cachedir/$cachefile"
    fi
  done 3>"$check" 4>"$create" 5>>"$trashfile"

  # Check some soon to expire files
  xargs -r0 -- jq --arg cacheprefix "$cachedir/" --raw-output0 \
    -- 'if .expires_at != null and .expires_at < now + 600 then $cacheprefix + .filename else empty end' \
    <"$check" \
    | tee -a "$create" \
    | xargs -r0 -- rm -rf --

  # Deduplicate to be created files
  jq -Rs --raw-output0 -- 'split("\u0000") | unique | .[] | select(. != "")' \
    <"$create" >"$tmp"
  cat -- "$tmp" >"$create"

  # Ensure the parent directories exist
  xargs -r0 -- sh -c 'for f; do [ -d "${f%/*}" ] || mkdir -p -- "${f%/*}"; done' sh \
    <"$create"

  # Upload files and create cache files
  xargs -r0 -- jq -n --arg cachedir "$cachedir/" --args -- '$ARGS.positional[] | ltrimstr($cachedir)' <"$create" \
    | call_api -U \
    | jq -r --arg cachedir "$cachedir/" '"printf \"%s\n\" "  + (@json | @sh) + " >" + (($cachedir + .filename) | @sh)' \
    | sh \
    || exit 1
)

delete_files() {
  for f; do
    if [ -d "$cachedir/$f" ]; then
      find "$cachedir/$f" -type f -print0 \
        | xargs -r0 -- cat -- >&3
      rm -rf -- "$cachedir/$f"
    elif [ -f "$cachedir/$f" ]; then
      cat -- "$cachedir/$f" >&3
      rm -rf -- "$cachedir/$f"
    fi
  done 3>>"$trashfile"
}

delete_trash() {
  [ -f "$trashfile" ] || return 0

  tmp=$(tmpfile)

  jq --args -- 'select(any(.filename | startswith($ARGS.positional[] + "/"); .))' "$@" \
    <"$trashfile" >"$tmp"

  jq -- 'select(.expires_at == null or .expires_at >= now + 600) | .id' "$tmp" \
    | call_api -d \
    | jq -r 'select(.deleted | not) | "not deleted: " + .id'

  jq --args -- 'select(all(.filename | startswith($ARGS.positional[] + "/"); not))' "$@" \
    <"$trashfile" >"$tmp"
  cp -- "$tmp" "$trashfile"

  rm -rf -- "$tmp"
}

if [ -n "$opt_update" ]; then
  update_files "$@" || exit
fi

if [ -n "$opt_list" ]; then
  if [ -n "$opt_trash" ]; then
    [ -f "$trashfile" ] && exec 3<"$trashfile" || exec 3</dev/null
    if [ -n "$opt_all" ]; then
      cat <&3
    else
      jq --args -- 'select(any(.filename | startswith($ARGS.positional[] + "/"); .))' \
        "$@" <&3
    fi
  else
    if [ -n "$opt_all" ]; then
      find "$cachedir" -type f -exec cat -- {} +
    else
      for f; do
        [ -f "$cachedir/$f" ] && cat -- "$cachedir/$f"
        [ -d "$cachedir/$f" ] && find "$cachedir/$f" -type f -exec cat -- {} +
      done
    fi
  fi | {
    if [ -n "$opt_metadata" ]; then
      cat
    else
      out_opt=-r
      [ -n "$opt_nul_terminated" ] && out_opt=--raw-output0
      jq "$out_opt" -- '.filename'
    fi
  }
fi

if [ -n "$opt_delete" ]; then
  if [ -n "$opt_deleteboth" ]; then
    delete_files "$@" || exit
    delete_trash "$@" || exit
  elif [ -n "$opt_trash" ]; then
    delete_trash "$@" || exit
  else
    delete_files "$@" || exit
  fi
fi

if [ -n "$opt_clean" ]; then
  find "$cachedir" -depth -type d -exec rmdir {} \; 2>/dev/null
  [ ! -s "$trashfile" ] && rm -f -- "$trashfile"
fi

# vim: ft=sh

llmtropt_output_amount=
llmtropt_tool_dir=
llmtropt_state_dir=
llmtropt_color=auto

llmtr_color_enabled=

llmtr_options="s:d:l:c:" 

llmtr_parse_options() {
  llmtr_extra_options=$1
  shift
  OPTIND=1
  while getopts "$llmtr_options$llmtr_extra_options" opt; do
    case $opt in
      d)  llmtropt_tool_dir=$OPTARG ;;
      s)  llmtropt_state_dir=$OPTARG ;;
      l)  llmtropt_output_amount=$OPTARG ;;
      c)  llmtropt_color=$OPTARG ;;
      \?) exit 2 ;;
      *)  "parse_my_option_$opt" ;;
    esac
  done

  [ -z "$llmtropt_tool_dir" ] && exit 2 

  llmtr_color_enabled=
  case $llmtropt_color in
    always)
      llmtr_color_enabled=1
      ;;
    never)
      llmtr_color_enabled=
      ;;
    auto)
      [ -t 1 ] && llmtr_color_enabled=1
      ;;
    [0123456789])
      [ -t "$llmtropt_color" ] && llmtr_color_enabled=1
      ;;
  esac
}

llmtr_run_on_color() {
  if [ -n "$llmtr_color_enabled" ]; then
    "$@"
  else
    cat -u
  fi
}

llmtr_run_filter() {
  while IFS= read -r llmtr_line; do
    if "$@"; then
      printf "%s\n" "$llmtr_line"
    fi
  done

  if [ -n "$llmtr_line" ]; then
    if "$@"; then
      printf "%s" "$llmtr_line"
    fi
  fi

}

llmtr_run_filter_on_color() {
  if [ -n "$llmtr_color_enabled" ]; then
    llmtr_run_filter "$@"
  else
    cat -u
  fi
}

llmtr_filter_color_line() {
  llmtr_line=$'\033['${1}m$llmtr_line$'\033[0m'
}

llmtr_color_pattern() {
  llmtr_count=$#
  llmtr_eres=
  llmtr_repls=
  llmtr_base_colors=
  while [ "$llmtr_count" -ge 4 ]; do
    llmtr_count=$((llmtr_count - 4))
    llmtr_repls=$llmtr_repls$'\033[0m\033['${2}m$4$'\033[0m\033['${1}m$'\n'
    llmtr_eres=$llmtr_eres$3$'\n'
    llmtr_base_colors=$llmtr_base_colors$1$'\n'
    shift 4
  done
  llmtr_eres=$(printf "%s" "$llmtr_eres" | sed 's/\\/\\\\/g; s/$/\\n/;' | tr -d '\n')
  llmtr_repls=$(printf "%s" "$llmtr_repls" | sed 's/\\/\\\\/g; s/$/\\n/;' | tr -d '\n')
  llmtr_base_colors=$(printf "%s" "$llmtr_base_colors" | sed 's/$/\\n/;' | tr -d '\n')
  # The trailing echo guarantees the last record is newline-terminated so
  # awk always sees it; a missing final newline in the input is then
  # recovered from the record count: an extra empty record means the input
  # ended with a newline (the last line is flushed by renderline("\n")),
  # while a final record rendered in END with an empty terminator means
  # it did not.
  { cat -u; echo; } | awk \
    -v colorsnl="$llmtr_base_colors" \
    -v eresnl="$llmtr_eres" \
    -v replsnl="$llmtr_repls" '
        function renderline(newline) {
          for (i = 1; i <= n; ++i) {
            if (gsub(eres[i], repls[i], pending_line) != 0) {
              printf "%s%s", "\033[" colors[i] "m" pending_line "\033[0m", newline
              return
            }
          }
          printf "%s%s", pending_line, newline
        }
        BEGIN {
          n = split(colorsnl, colors, "\n") - 1
          split(eresnl, eres, "\n")
          split(replsnl, repls, "\n")
          pending_line = ""
          pending = 0
        }
        {
          if (pending)
            renderline("\n")
          pending_line = $0
          pending = 1
        }
        END {
          if (pending_line != "")
            renderline("")
        }'
}

llmtr_ltrim_ansi_color() {
  llmtr_ltrim_line=$2
  while :; do
    case $llmtr_ltrim_line in
      $'\033'*m*)
        llmtr_ltrim_line=${llmtr_ltrim_line#*m}
        ;;
      *)
        command eval " $1"='$llmtr_ltrim_line'
        return
        ;;
    esac
  done
}

llmtr_missing_newline_mark="<missing newline>"
llmtr_color_missing_newline_mark="41;30"
llmtr_mark_missing_newline() {
  while IFS= read -r llmtr_line; do
    printf "%s\n" "$llmtr_line"
  done

  if [ -n "$llmtr_line" ]; then
    if [ -n "$llmtr_color_enabled" ]; then
      set -- \
        "${1:-$llmtr_missing_newline_mark}" \
        "${2:-$llmtr_color_missing_newline_mark}"
      printf "%s\033[%sm%s\033[0m\n" "$llmtr_line" "$2" "$1"
    else
      printf "%s\n" "$llmtr_line$llmtr_missing_newline_mark"
    fi
  fi
}

llmtr_cntrl_color_default='41;30'
# The characters marked by llmtr_mark_common_cntrl_chars, in the same
# order as their marks inside the function. ESC must come first: the
# colored wrappers of the marks themselves contain ESC bytes, and the
# ESC pass must therefore run before they are introduced.
llmtr_cntrl_chars=$'\033\b\v\f\r\036\177'

llmtr_mark_common_cntrl_chars() {
  llmtr_cntrl_color=${1:-$llmtr_cntrl_color_default}
  case $llmtr_cntrl_color in
    ''|*[!0-9\;]*) llmtr_cntrl_color=$llmtr_cntrl_color_default ;;
  esac

  # NUL makes the input non-textual (POSIX text utilities behave
  # unpredictably on it), so it is replaced up front with RS (0x1e).
  # The sentinel is internal: it is rendered as the \0 mark below and
  # never appears as itself in the output. The marks of the other
  # control characters are escape sequences, one per line.
  llmtr_cntrl_marks=$(printf '%s\n' '\e' '\b' '\v' '\f' '\r' '\0' '\177' \
    | sed 's/\\/\\\\/g')
  { tr '\0' '\036'; echo; } | awk \
    -v colored="$llmtr_color_enabled" \
    -v color="$llmtr_cntrl_color" \
    -v chars="$llmtr_cntrl_chars" \
    -v marks="$llmtr_cntrl_marks" '
      function renderline(newline) {
        for (i = 1; i <= n; ++i)
          gsub(substr(chars, i, 1), repl[i], pending_line)
        printf "%s%s", pending_line, newline
      }
      BEGIN {
        n = length(chars)
        split(marks, mark, "\n")
        for (i = 1; i <= n; ++i)
          repl[i] = (colored != "" ? "\033[" color "m" mark[i] "\033[0m" : mark[i])
        pending_line = ""
        pending = 0
      }
      {
        if (pending)
          renderline("\n")
        pending_line = $0
        pending = 1
      }
      END {
        if (pending_line != "")
          renderline("")
      }'
}

llmtr_complete_newline() {
  while IFS= read -r llmtr_line || [ -n "$llmtr_line" ]; do
    printf "%s\n" "$llmtr_line"
  done
}

llmtr_line_prefix="┃ "
llmtr_line_has_more_prefix="› "
llmtr_line_color_prefix='36'
llmtr_line_color_has_more='31'
llmtr_render_lines() {
  llmtr_shoud_reset=$1

  llmtr_line_begin=
  if [ -n "$llmtr_color_enabled" ]; then
    if [ -n "$llmtr_line_color_prefix" ]; then
      llmtr_line_begin=$'\033['${llmtr_line_color_prefix}m$llmtr_line_prefix$'\033[0m'
    else
      llmtr_line_begin=$llmtr_line_prefix
    fi

    llmtr_has_more_color_enabled=
    if [ -n "$llmtr_line_color_has_more" ]; then
      llmtr_has_more_color_enabled=1
    fi
  else
    llmtr_line_begin=$llmtr_line_prefix
  fi

  llmtr_print_stats() {
    [ -n "$llmtr_has_more_color_enabled" ] && printf "\033[%sm" "$llmtr_line_color_has_more"
    printf "%s%s\n" "$llmtr_line_has_more_prefix" \
      "($llmtr_line_count lines in total, $((llmtr_line_count - llmtropt_output_amount)) lines not shown)"
    [ -n "$llmtr_has_more_color_enabled" ] && printf "\033[0m"
  }

  llmtr_line_count=0
  llmtr_process_line() {
    if [ -n "$llmtr_shoud_reset" ] && "$llmtr_shoud_reset"; then
      if [ "$llmtr_line_count" -gt "${llmtropt_output_amount:-$llmtr_line_count}" ]; then
        llmtr_print_stats
      fi
      llmtr_line_count=0
    fi

    llmtr_line_count=$((llmtr_line_count + 1))
    if [ "$llmtr_line_count" -gt "${llmtropt_output_amount:-$llmtr_line_count}" ]; then
      return 1
    fi
    llmtr_line=$llmtr_line_begin$llmtr_line
  }

  llmtr_run_filter llmtr_process_line

  if [ "$llmtr_line_count" -gt "${llmtropt_output_amount:-$llmtr_line_count}" ]; then
    llmtr_print_stats
  fi
}

llmtr_render_header() {
  while [ "$#" -ne 0 ]; do
    llmtr_header_color_end=
    llmtr_header_color_begin=
    if [ -n "$llmtr_color_enabled" ]; then
      llmtr_header_color_begin=$'\033['${1}m
      llmtr_header_color_end=$'\033[0m'
    fi
    printf "%s" "$llmtr_header_color_begin$2$llmtr_header_color_end"
    shift 2
  done
  echo
}

#!/bin/sh

mode=$1
shift

opt_prompt=
opt_password=
opt_width=
while getopts "vPp:w:" opt; do
  case $opt in
    v)
      # Ignore
      ;;
    P)
      opt_password=1
      ;;
    p)
      opt_prompt=$OPTARG
      ;;
    w)
      opt_width=$OPTARG
      ;;
    \?)
      exit 2
      ;;
  esac
done

shift "$((OPTIND - 1))"

set -- --mesg "$opt_prompt"
[ -n "$opt_password" ] && set -- "$@" --password='*'
[ -n "$opt_width" ] && set -- "$@" -w "$opt_width"

list_executables() {
  (
    paths=${PATH:+$PATH:}
    while [ -n "$paths" ]; do
      path=${paths%%:*}
      path=${path:-.}
      [ -d "$path" ] && [ -r "$path" ] && printf "%s\0" "$path"
      paths=${paths#*:}
    done
  ) \
    | xargs -r0 -- sh -c 'find -L "$@" -type f -perm -+x' -- \
    | awk -F / '{print $NF}' \
    | sort -u
}

case $mode in
  run)
    sh -c "$(list_executables | fuzzel --dmenu "$@")"
    ;;
  drun)
    exec fuzzel "$@"
    ;;
  dmenu)
    exec fuzzel --dmenu "$@"
    ;;
esac

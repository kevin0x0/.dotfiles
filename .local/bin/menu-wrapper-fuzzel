#!/bin/sh

mode=$1
shift

opt_prompt=
opt_password=
while getopts "vPp:" opt; do
  case $opt in
    v)
      # Ignore
      ;;
    P)
      opt_password=1
      ;;
    p)
      opt_prompt=$OPTARG
      ;;
    \?)
      exit 2
      ;;
  esac
done

shift "$((OPTIND - 1))"

set -- --mesg "$opt_prompt"
[ -n "$opt_password" ] && set -- "$@" --password='*'

list_executables() {
  printf "%s\0" "$PATH" \
    | tr ':' '\000' \
    | xargs -r0 -- sh -c 'find -L "$@" -type f -perm -+x' -- \
    | awk -F / '{print $NF}' \
    | sort -u
}

case $mode in
  run)
    # '--' is supported by exec in IEEE Std 1003.1-2024, but we use command to
    # get the absolute path for compatibility.
    exec "$(command -v -- "$(list_executables | fuzzel --dmenu "$@")")"
    ;;
  drun)
    exec fuzzel "$@"
    ;;
  dmenu)
    exec fuzzel --dmenu "$@"
    ;;
esac

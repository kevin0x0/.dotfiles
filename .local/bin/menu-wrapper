#!/bin/sh

config=${XDG_CONFIG_HOME:-$HOME/.config}/menu-wrapper
[ -f "$config" ] && [ -r "$config" ] && . -- "$config"

if [ -z "$backend" ]; then
  if command -v fuzzel >/dev/null 2>&1; then
    backend=fuzzel
  elif command -v wmenu >/dev/null 2>&1; then
    backend=wmenu
  fi
fi

if [ -z "$backend" ]; then
  notify-or-print -en menu-wrapper -- \
    "$(i18n -n common "Failure")" "$(i18n -n menu "No backend available")"
  exit 1
fi

exec "menu-wrapper-$backend" "$@"

#!/bin/sh

. llm-tool-render-utils

llmtr_parse_options "" "$@"
llmtr_render_header "36;1" apply_patch

should_reset_line() {
  llmtr_ltrim_ansi_color line "$llmtr_line"
  case $line in
    "*** "*)
      return 0
      ;;
  esac
  return 1
}

llmtr_complete_newline \
  | llmtr_run_on_color llmtr_color_pattern \
    '0' '32' '^\+.*$' '&' \
    '0' '31' '^-.*$' '&' \
    '0' '33' '^@@.*$' '&' \
    '0' '1' '^\*\*\* .*$' '&' \
  | llmtr_render_lines should_reset_line

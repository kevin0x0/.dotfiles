#!/bin/sh

. llm-common

opt_fromfile=
opt_fromfd=
opt_getarg_trim_newline=
opt_inverse_boolean_option=

getarg() {
  if [ -n "$opt_fromfd" ]; then
    arg=$(cat <&"$2"; echo x)
    arg=${arg%x}
    opt_fromfd=
  elif [ -n "$opt_fromfile" ]; then
    arg=$(cat -- "$2"; echo x)
    arg=${arg%x}
    opt_fromfile=
  else
    arg=$2
  fi
  [ -n "$opt_getarg_trim_newline" ] && arg=${arg%$'\n'}
  opt_getarg_trim_newline=
  eval "$1"='$arg'
}

set_boolean_option() {
  if [ -n "$opt_inverse_boolean_option" ]; then
    eval "$1="
    opt_inverse_boolean_option=
  else
    eval "$1=1"
  fi
}

eval_api_key() {
  if [ -z "$opt_api_key" ] && [ -n "$opt_api_key_cmd" ]; then
    opt_api_key=$(eval " $opt_api_key_cmd" && echo x) || exit
    opt_api_key=${opt_api_key%$'\nx'}
  fi
}

source_configfile() {
  case $1 in
    @*) . -- "$llm_configdir/${1#@}" ;;
    /*) . -- "$1" ;;
    *) . -- "./$1" ;;
  esac
}

evaluate_option() {
  option_name=$(printf "%s" "${1%%=*}" | tr '-' '_')
  case $1 in
    *=*)
      ;;
    *)
      set_boolean_option "$option_name"
      return
      ;;
  esac

  option_value=${1#*=}
  getarg "$option_name" "$option_value"
}

#!/bin/sh

lock switch-colorscheme
trap 'unlock switch-colorscheme' EXIT

# We don't guarantee the behaviour on receipt of signals except those
# listed the following lines
trap 'unlock switch-colorscheme; trap - TERM; kill -s TERM "$$"' TERM
trap 'unlock switch-colorscheme; trap - QUIT; kill -s QUIT "$$"' QUIT
trap 'unlock switch-colorscheme; trap - HUP; kill -s HUP "$$"' HUP
trap 'unlock switch-colorscheme; trap - INT; kill -s INT "$$"' INT

COLORSCHEME_STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}/colorscheme

if [ ! -d "$COLORSCHEME_STATE_HOME" ]; then
  if [ -e "$COLORSCHEME_STATE_HOME" ]; then
    echo "'$COLORSCHEME_STATE_HOME' exists but not a directory" >&2
    exit 1
  fi

  mkdir -p -- "$COLORSCHEME_STATE_HOME"
fi

COLORSCHEME_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}/colorscheme

if [ ! -d "$COLORSCHEME_CONFIG_HOME" ]; then
  echo "'$COLORSCHEME_CONFIG_HOME' doesn't exist or not a directory" >&2
  exit 1
fi


CURRENT_THEME_FILE=$COLORSCHEME_STATE_HOME/current_theme
CURRENT_ALPHA_FILE=$COLORSCHEME_STATE_HOME/current_alpha

if [ ! -f "$CURRENT_THEME_FILE" ]; then
  if [ -e "$CURRENT_THEME_FILE" ]; then
    echo "'$CURRENT_THEME_FILE' exists but not a file" >&2
    exit 1
  fi
  
  printf "%s\n" 'light' >"$CURRENT_THEME_FILE"
fi

if [ ! -f "$CURRENT_ALPHA_FILE" ]; then
  if [ -e "$CURRENT_ALPHA_FILE" ]; then
    echo "'$CURRENT_ALPHA_FILE' exists but not a file" >&2
    exit 1
  fi
  
  echo >"$CURRENT_ALPHA_FILE"
fi

opt_list=
opt_print=

alpha=$(cat "$CURRENT_ALPHA_FILE")
theme=$(cat "$CURRENT_THEME_FILE")
while getopts "sa:lp" opt; do
  case $opt in
    s)
      case $theme in
        dark)
          theme=light
          ;;
        light)
          theme=dark
          ;;
        *)
          theme=dark
          ;;
      esac
      ;;
    a)
      xdigits=[0123456789abcdefABCDEF]
      case $OPTARG in
        $xdigits$xdigits)
          alpha=$OPTARG
          ;;
        '')
          alpha=
          ;;
        *)
          printf "alpha value must be empty or two hexadecimal digits\n" >&2
          exit 2
          ;;
      esac
      ;;
    l)
      opt_list=1
      ;;
    p)
      opt_print=1
      ;;
    \?)
      exit 2
      ;;
  esac
done

shift "$((OPTIND - 1))"

export COLORSCHEME_STATE_HOME
export COLORSCHEME_CONFIG_HOME
export COLORSCHEME_TEMPLATES_DIR="$COLORSCHEME_CONFIG_HOME/templates"
export COLORSCHEME_EXTRA_DIR="$COLORSCHEME_CONFIG_HOME/extra"
export COLORSCHEME_COLORSCHEMES_DIR="$COLORSCHEME_CONFIG_HOME/colorschemes"
export COLORSCHEME_SPECS_DIR="$COLORSCHEME_CONFIG_HOME/specs"

if [ -n "$opt_list" ]; then
  (cd -- "$COLORSCHEME_COLORSCHEMES_DIR"; printf "%s\n" *)
  exit
fi

[ -n "$1" ] && theme=$1

if [ -n "$opt_print" ]; then
  printf "%s\n" "$theme"
  exit
fi

export COLORSCHEME_THEME="$theme"
export COLORSCHEME_ALPHA="$alpha"

export COLORSCHEME_THEME_FILE="$theme"
# theme name with alpha encoded
export COLORSCHEME_THEME_FILE_A="$theme${alpha:+-}$alpha"

do_scripts() (
  cd -- "$COLORSCHEME_CONFIG_HOME/$1"
  printf "%s\n" * | LC_ALL=C sort \
    | while IFS= read -r f; do
        [ -f "$f" ] || continue
        [ -r "$f" ] || continue
        sh -- "$f" || exit
      done
)

do_scripts_in_parallel() {
  notify-state -c colorscheme-switch-error
  for script in "$COLORSCHEME_CONFIG_HOME/$1"/*; do
    [ -f "$script" ] || continue
    [ -r "$script" ] || continue
    (sh -- "$script" || notify-state colorscheme-switch-error) &
  done

  while ! wait; do
    :
  done

  ! notify-state -tc colorscheme-switch-error 
}

do_scripts pre-switch || exit
do_scripts_in_parallel switch || exit
do_scripts post-switch || exit

printf "%s\n" "$theme" >"$CURRENT_THEME_FILE"
printf "%s\n" "$alpha" >"$CURRENT_ALPHA_FILE"

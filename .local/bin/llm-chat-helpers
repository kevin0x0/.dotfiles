#!/bin/sh

opt_token_estimator=
opt_session_save_options="$opt_session_save_options opt_token_estimator"

llmch_jq_program_extract_text='
inputs |
if (.type // "message") == "message" then
  .content |
  if type == "array" then
    .[].text
  end
elif .type == "reasoning" then
  .content // [] | .[].text
elif .type == "function_call" or .type == "custom_tool_call" then
  .arguments // .input
elif .type == "function_call_output" or .type == "custom_tool_call_output" then
  .output |
  if type == "array" then
    .[].text
  end
else
  empty
end | select(.)
'

llmch_estimate_tokens_jq() {
  jq -nr '
    [ '"$llmch_jq_program_extract_text"' ] | add // "" |
    # token weight: whitespace 0, punct/CJK/kana/hangul 1, emoji 3, other 0.25
    explode | reduce .[] as $c (0;
      . + (
        if $c <= 32 then
          0
        elif $c <= 126 then
          (if $c <= 47 or ($c >= 58 and $c <= 64) or ($c >= 91 and $c <= 96) or $c >= 123 then 1 else 0.25 end)
        else
          (if ($c >= 13312 and $c <= 19903) or ($c >= 19968 and $c <= 40959) or ($c >= 63744 and $c <= 64255)
            or ($c >= 12352 and $c <= 12543) or ($c >= 4352 and $c <= 4607) or ($c >= 12592 and $c <= 12687) or ($c >= 44032 and $c <= 55215)
            or ($c >= 12289 and $c <= 12351) or ($c >= 65281 and $c <= 65381) then 1
           elif ($c >= 126976 and $c <= 129791) or ($c >= 9728 and $c <= 10175) then 3
           else 0.25 end)
        end
      )
    ) | floor
    '
}

llmch_estimate_tokens_perl() {
  jq -nj "$llmch_jq_program_extract_text" \
    | perl -CSD -ne '
        # token weight: whitespace 0, punct/CJK/kana/hangul 1, emoji 3, other 0.25
        BEGIN { $t = 0 }
        for my $c (split //) {
          my $o = ord($c);
          $t += 0.25 if $o > 32;
          $t += 0.75 if ($o >= 33 && $o <= 47) || ($o >= 58 && $o <= 64) || ($o >= 91 && $o <= 96) || ($o >= 123 && $o <= 126);
          $t += 0.75 if ($o >= 13312 && $o <= 19903) || ($o >= 19968 && $o <= 40959) || ($o >= 63744 && $o <= 64255);
          $t += 0.75 if ($o >= 12352 && $o <= 12543) || ($o >= 4352 && $o <= 4607) || ($o >= 12592 && $o <= 12687) || ($o >= 44032 && $o <= 55215);
          $t += 0.75 if ($o >= 12289 && $o <= 12351) || ($o >= 65281 && $o <= 65381);
          $t += 2.75 if ($o >= 126976 && $o <= 129791) || ($o >= 9728 && $o <= 10175);
        }
        END { print int($t), "\n" }
      '
}

command -v perl >/dev/null 2>&1 && llmch_perl_is_available=1 || llmch_perl_is_available=
llmch_estimate_tokens() {
  if [ "${#opt_token_estimator}" -ne 0 ]; then
    if command eval " $opt_token_estimator"; then
      return
    fi
  fi

  [ -n "$llmch_perl_is_available" ] \
    && llmch_estimate_tokens_perl "$@" \
    || llmch_estimate_tokens_jq "$@"
}

llmch_check_required_options() {
  if [ -z "$opt_api_key" ]; then
    i18n -n llm-scripts 'API key not provided' >&2
    return 1
  fi

  if [ -z "$opt_responses_base_url" ]; then
    i18n -n llm-scripts 'base URL not provided' >&2
    return 1
  fi

  if [ -z "$opt_model" ]; then
    i18n -n llm-scripts 'model not provided' >&2
    return 1
  fi
}

llmch_options_ok=
llmch_evaluate_required_options() {
  [ -n "$llmch_options_ok" ] && return 0

  llmcu_eval_api_key || return
  llmch_check_required_options || return

  llmch_options_ok=1
  return 0
}

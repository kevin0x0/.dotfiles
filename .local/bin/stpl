#!/bin/sh

stpl_line_count=0
stpl_line=

error() {
  printf "in stpl_line %u: " "$stpl_line_count"
  printf "$@"
  echo
  printf "%5u | %s\n" "$stpl_line_count" "$stpl_line"
} >&2

expand_line() {
  stpl_remaining=$stpl_line
  while :; do
    case "$stpl_remaining" in
      "$stpl_opt_expansion_open"#*#"$stpl_opt_expansion_close")
        # Ignore the comment stpl_line
        break
        ;;
      *"$stpl_opt_expansion_open"?*?"$stpl_opt_expansion_close"*)
        stpl_head=${stpl_remaining%%"$stpl_opt_expansion_open"?*}
        printf "%s" "$stpl_head"

        stpl_tail=${stpl_remaining#"$stpl_head$stpl_opt_expansion_open"}
        stpl_mark=${stpl_tail%"${stpl_tail#?}"}
        stpl_tail=${stpl_tail#?}
        stpl_terminator="$stpl_mark$stpl_opt_expansion_close"

        stpl_expr=${stpl_tail%%"$stpl_terminator"*}
        stpl_tail=${stpl_tail#"$stpl_expr"}
        stpl_remaining=${stpl_tail#"$stpl_terminator"}

        if [ -z "$stpl_tail" ]; then
          error "expect '%s' to match '%s'" "$stpl_terminator" "$stpl_opt_expansion_open$stpl_mark"
          exit 1
        fi

        if ! command eval "printf \"%s\" \"$stpl_expr\"" 2>/dev/null; then
          error "failed to do word expansion for: \"%s\"" "$stpl_expr"
        fi
        ;;
      *)
        printf "%s\n" "$stpl_remaining"
        return
        ;;
    esac
  done
}

expand_file() {
  while IFS= read -r stpl_line; do
    stpl_line_count=$((stpl_line_count + 1))
    expand_line
  done
}

stpl_opt_expansion_open='{'
stpl_opt_expansion_close='}'
stpl_opt_output=
while getopts "l:r:s:o:" opt; do
  case $opt in
    l)
      stpl_opt_expansion_open=$OPTARG
      ;;
    r)
      stpl_opt_expansion_close=$OPTARG
      ;;
    s)
      case $OPTARG in
        */*)
          stpl_filepath=$OPTARG
          ;;
        *)
          stpl_filepath=./$OPTARG
          ;;
      esac
      if ! command . -- "$stpl_filepath"; then
        printf "failed to source %s\n" "$OPTARG" >&2
        exit 1
      fi
      ;;
    o)
      stpl_opt_output=$OPTARG
      ;;
    '?')
      exit 2
      ;;
  esac
done

shift "$((OPTIND - 1))"

if [ -z "$1" ]; then
  if [ -n "$stpl_opt_output" ]; then
    expand_file >"$stpl_opt_output"
  else
    expand_file
  fi
elif [ -f "$1" ] && [ -r "$1" ]; then
  if [ -n "$stpl_opt_output" ]; then
    expand_file <"$1" >"$stpl_opt_output"
  else
    expand_file <"$1"
  fi
else
  printf "%s is not a readable file\n" "$1" >&2
  exit 1
fi

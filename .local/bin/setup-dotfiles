#!/bin/sh

showmsg() {
  if [ -t 2 ]; then
    printf "\033[1m[\033[%um%s\033[0;1m@\033[34m%s\033[0;1m] %s\033[0m\n" "$1" "$2" "$3" "$4" >&2
  else
    printf "[%s@%s] %s\n" "$2" "$3" "$4" >&2
  fi
}

error() (
  for arg; do
    showmsg 31 error "${MSG_CONTEXT:-"setup-dotfiles"}" "$arg"
  done
)

warning() (
  for arg; do
    showmsg 33 warning "${MSG_CONTEXT:-"setup-dotfiles"}" "$arg"
  done
)

error_exit() {
  error "$@"
  exit 1
}

info() (
  for arg; do
    showmsg 35 info "${MSG_CONTEXT:-"setup-dotfiles"}" "$arg"
  done
)

msg() (
  for arg; do
    showmsg 36 mesg "${MSG_CONTEXT:-"setup-dotfiles"}" "$arg"
  done
)


dotfiles() {
  git --git-dir="$HOME/.dotfiles" --work-tree="$HOME" "$@"
}

opt_force_checkout=
opt_checkout=true
while getopts "fC" opt; do
  case $opt in
    f)
      opt_force_checkout=true
      ;;
    C)
      opt_checkout=
      ;;
    \?)
      exit 2
      ;;
  esac
done

if ! cd -- "$HOME"; then
  error_exit "can not change directory to $HOME"
fi

# Checkout
if [ -n "$opt_checkout" ]; then
  if ! dotfiles diff --quiet --diff-filter=M && \
    [ -z "$opt_force_checkout" ]; then
    error "The following files are different from those in the repository"
    dotfiles diff --name-only --diff-filter=M | \
      while read -r line; do
        error "$line"
      done
    info "you can use option -C to skip checkout or -f to force checkout"
    exit 1
  fi

  if [ -n "$opt_force_checkout" ]; then
    dotfiles checkout -qf
  else
    dotfiles checkout -q
  fi
fi

# We rely on the lexicographic order of the drop-in script names in C locale to
# guarantee the correct execution order.
LC_ALL=C

# Source drop-in configuration file
for f in "${XDG_CONFIG_HOME:-$HOME/.config}"/setup-dotfiles/*; do
  [ -f "$f" ] || continue
  [ -r "$f" ] || continue
  (MSG_CONTEXT=$(basename -- "$f") \
    SCRIPT_DIR=$(dirname -- "$f") . -- "$f") || exit 1
done

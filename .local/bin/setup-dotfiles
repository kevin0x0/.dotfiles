#!/bin/sh

showmsg() {
  if [ -t 2 ]; then
    printf "\033[1m[\033[%um%s\033[34m@%s\033[0;1m] %s\033[0m\n" "$1" "$2" "$3" "$4" >&2
  else
    printf "[%s@%s] %s\n" "$2" "$3" "$4" >&2
  fi
}

error() {
  for arg; do
    showmsg 31 error "${MSG_CONTEXT:-"setup-dotfiles"}" "$arg"
  done
  exit 1
}

info() {
  for arg; do
    showmsg 33 info "${MSG_CONTEXT:-"setup-dotfiles"}" "$arg"
  done
}

msg() {
  for arg; do
    showmsg 36 mesg "${MSG_CONTEXT:-"setup-dotfiles"}" "$arg"
  done
}


dotfiles() {
  git --git-dir="$HOME/.dotfiles" --work-tree="$HOME" "$@"
}

check_diff() {
  if dotfiles diff --quiet --diff-filter=M; then
    return 0
  fi
  dotfiles diff --name-only --diff-filter=M | \
  while IFS= read -r line; do
    case "$line" in
      *.gpg)
        continue
        ;;
      *)
        return 1
        ;;
    esac
  done
}

list_diff() {
  dotfiles diff --name-only --diff-filter=M | \
  while IFS= read -r line; do
    case "$line" in
      *.gpg)
        continue
        ;;
      *)
        printf "%s\n" "$line"
        ;;
    esac
  done
}

opt_force_checkout=
opt_checkout=true
while getopts "fC" opt; do
  case $opt in
    f)
      opt_force_checkout=true
      ;;
    C)
      opt_checkout=
      ;;
    \?)
      exit 2
      ;;
  esac
done

if ! cd -- "$HOME"; then
  error "can not change directory to $HOME"
fi

# Checkout
if [ -n "$opt_checkout" ]; then
  if ! check_diff && [ -z "$opt_force_checkout" ]; then
    list_diff
    error "The contents of files listed above are different from those in the repository" \
      "can not safely checkout."
  fi

  if [ -n "$opt_force_checkout" ]; then
    dotfiles checkout -qf
  else
    dotfiles checkout -q
  fi
fi

: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_CACHE_HOME:=$HOME/.cache}"

# Create XDG user directories
if [ ! -r "$XDG_CONFIG_HOME/user-dirs.dirs" ]; then
  error "$XDG_CONFIG_HOME/user-dirs.dirs does not exist or is not readable"
fi

if ! . -- "$XDG_CONFIG_HOME/user-dirs.dirs"; then
  error "failed to source $XDG_CONFIG_HOME/user-dirs.dirs"
fi

for d in "$XDG_DESKTOP_DIR" "$XDG_MUSIC_DIR" "$XDG_TEMPLATES_DIR" \
  "$XDG_PUBLICSHARE_DIR" "$XDG_DOCUMENTS_DIR" "$XDG_PICTURES_DIR" \
  "$XDG_VIDEOS_DIR" "$XDG_DOWNLOAD_DIR"; do
  if ! mkdir -p -- "$d"; then
    error "failed to create XDG directory $d"
  fi
done

# Source drop-in configuration file
for f in "$XDG_CONFIG_HOME"/setup-dotfiles/*; do
  [ -r "$f" ] || continue
  (MSG_CONTEXT=$(basename -- "$f") . -- "$f") || exit 1
done

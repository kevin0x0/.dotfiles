#!/bin/sh

llmcuopt_fromfile=
llmcuopt_fromfd=
llmcuopt_trim_newline=
llmcuopt_inverse_boolean_option=

llmcu_getarg() {
  if [ -n "$llmcuopt_fromfd" ]; then
    llmcu_arg=$(cat <&"$2"; echo x)
    llmcu_arg=${llmcu_arg%x}
    llmcuopt_fromfd=
  elif [ -n "$llmcuopt_fromfile" ]; then
    llmcu_arg=$(cat -- "$2"; echo x)
    llmcu_arg=${llmcu_arg%x}
    llmcuopt_fromfile=
  else
    llmcu_arg=$2
  fi
  [ -n "$llmcuopt_trim_newline" ] && llmcu_arg=${llmcu_arg%$'\n'}
  llmcuopt_trim_newline=
  eval "$1"='$llmcu_arg'
}

llmcu_set_boolean_option() {
  if [ -n "$llmcuopt_inverse_boolean_option" ]; then
    eval "$1="
    llmcuopt_inverse_boolean_option=
  else
    eval "$1=1"
  fi
}

llmcu_eval_api_key() {
  if [ -z "$opt_api_key" ] && [ -n "$opt_api_key_cmd" ]; then
    opt_api_key=$(eval " $opt_api_key_cmd" && echo x) || exit
    opt_api_key=${opt_api_key%$'\nx'}
  fi
}

llmcu_configdir=${XDG_CONFIG_HOME:-$HOME/.config}/llm-scripts
llmcu_datadir=${XDG_DATA_HOME:-$HOME/.local/share}/llm-scripts

llmcu_match_item_in_datadirs() {
  llmcu_paths=${XDG_DATA_DIRS:-/usr/local/share/:/usr/share/}
  llmcu_paths=${llmcu_paths:+$llmcu_paths:}
  while [ -n "$llmcu_paths" ]; do
    llmcu_path=${llmcu_paths%%:*}
    llmcu_path=${llmcu_path:-$PWD}/llm-scripts
    for llmcu_config_item in "$llmcu_path"/$1; do
      [ -e "$llmcu_config_item" ] || continue
      "$2" "$llmcu_config_item" && return
    done
    llmcu_paths=${llmcu_paths#*:}
  done
  return 1
}

llmcu_match_config_item() {
  for llmcu_config_item in "$llmcu_configdir"/$1 "$llmcu_datadir"/$1; do
    [ -e "$llmcu_config_item" ] || continue
    "$2" "$llmcu_config_item" && return
  done
  llmcu_match_item_in_datadirs "$@"
}

llmcu_for_item_in_datadirs() {
  llmcu_paths=${XDG_DATA_DIRS:-/usr/local/share/:/usr/share/}
  llmcu_paths=${llmcu_paths:+$llmcu_paths:}
  while [ -n "$llmcu_paths" ]; do
    llmcu_path=${llmcu_paths%%:*}
    llmcu_path=${llmcu_path:-$PWD}/llm-scripts
    if [ -e "$llmcu_path/$1" ]; then
      "$2" "$llmcu_path/$1" && return
    fi
    llmcu_paths=${llmcu_paths#*:}
  done
  return 1
}

llmcu_for_config_item() {
  for llmcu_config_item in "$llmcu_configdir/$1" "$llmcu_datadir/$1"; do
    if [ -e "$llmcu_config_item" ]; then
      "$2" "$llmcu_config_item" && return
    fi
  done
  llmcu_for_item_in_datadirs "$@"
}

llmcu_source_configfile() {
  case $1 in
    @*)
      set "${1#@}"
      do_source() {
        [ -f "$1" ] && { . -- "$1"; return 0; }
      }

      llmcu_for_config_item "$1" do_source && return
      printf "can not find config file: %s\n" "$1" >&2
      return 1
      ;;
    /*)
      . -- "$1"
      ;;
    *)
      . -- "./$1"
      ;;
  esac
}

llmcu_locate_config_item() {
  llmcu_location=
  set_location() {
    llmcu_location=$1
  }
  llmcu_for_config_item "$2" set_location

  if [ -n "$llmcu_location" ]; then
    command eval " $1"='$llmcu_location'
  else
    return 1
  fi
}

llmcu_evaluate_option() {
  llmcu_optname=$(printf "%s" "${1%%=*}" | tr -- '-' '_')
  case $1 in
    *=*)
      ;;
    *)
      llmcu_set_boolean_option "$llmcu_optname"
      return
      ;;
  esac

  llmcu_optvalue=${1#*=}
  llmcu_getarg "$llmcu_optname" "$llmcu_optvalue"
}

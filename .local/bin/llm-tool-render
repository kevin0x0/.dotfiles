#!/bin/sh

. llm-config-utils

opt_test=
opt_render_kind=
opt_name=
while getopts "tcopn:" opt; do
  case $opt in
    t)
      opt_test=1
      ;;
    c)
      opt_render_kind=render-call
      ;;
    o)
      opt_render_kind=render-output
      ;;
    p)
      opt_render_kind=render-prepare
      ;;
    n)
      opt_name=$OPTARG
      ;;
    \?)
      exit 2
      ;;
  esac
done
shift "$((OPTIND - 1))"

[ -z "$opt_render_kind" ] && opt_render_kind=render-call

if [ -z "$opt_name" ]; then
  printf "tool name not given\n" >&2
  exit 2
fi

toolpath=
locate_config_item  toolpath "tools/$opt_name/$opt_render_kind"

if [ -x "$toolpath" ]; then
  [ -n "$opt_test" ] && exit 0
  "$toolpath" -d "${toolpath%/*}" "$@"
  exit 0
elif [ -r "$toolpath" ]; then
  [ -n "$opt_test" ] && exit 0
  sh -- "$toolpath" -d "${toolpath%/*}" "$@"
  exit 0
else
  [ -z "$opt_test" ]
fi

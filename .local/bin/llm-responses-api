#!/bin/sh

opt_responses_base_url=
opt_api_key=
opt_stream=
opt_reasoning=none
opt_model=
opt_tools=
opt_tools_file=

opt_input=

. llm-config-utils

while getopts "i:fFNu:k:sr:m:t:T:A:" opt; do
  case $opt in
    i)
      getarg opt_input "$OPTARG"
      ;;
    f)
      set_boolean_option opt_fromfile
      ;;
    F)
      set_boolean_option opt_fromfd
      ;;
    N)
      set_boolean_option opt_getarg_trim_newline
      ;;
    u)
      getarg opt_responses_base_url "$OPTARG"
      ;;
    k)
      getarg opt_api_key "$OPTARG"
      ;;
    s)
      set_boolean_option opt_stream
      ;;
    r)
      getarg opt_reasoning "$OPTARG"
      ;;
    m)
      getarg opt_model "$OPTARG"
      ;;
    t)
      getarg opt_tools "$OPTARG"
      opt_tools_file=
      ;;
    T)
      getarg opt_tools_file "$OPTARG"
      opt_tools=
      ;;
    A)
      getarg opt_extra_request_args "$OPTARG"
      ;;
    \?)
      exit 2
      ;;
  esac
done

shift "$((OPTIND - 1))"

event_output=/dev/null
if [ "$#" -eq 0 ]; then
  response_output=
elif [ "$#" -ge 1 ]; then
  if [ "$1" = - ]; then
    response_output=
  else
    response_output=$1
  fi

  if [ "$#" -gt 1 ]; then
    if [ "$2" = - ]; then
      event_output=
    else
      event_output=$2
    fi
  fi
fi

make_input() {
  stream=false
  [ -n "$opt_stream" ] && stream=true
  if [ -z "$opt_tools_file$opt_tools" ]; then
    opt_tools=null
  fi
  jq -cs \
    --argjson stream "$stream" \
    --"${opt_tools:+argjson}${opt_tools_file:+slurpfile}" tools "${opt_tools_file:-[$opt_tools]}" \
    --arg reasoning "$opt_reasoning" \
    --arg model "$opt_model" \
    --argjson extra "${opt_extra_request_args:-{\}}" \
    '{"model":$model,"stream":$stream,"reasoning":{"effort":$reasoning},"input":.} + $extra
      | if $tools[0] != null then .tools = $tools[0] end'
}

curl_file_escape() {
  tmp=$(printf "%sx\n" "$2" | sed 's/["\]/\\&/g')
  eval " $1"='${tmp%x}'
}

call_curl() (
  curl_file_escape escaped "$tmp_input"
  trap ':' INT
  opts=-sS${opt_stream:+N}
  curl "$opts" "$opt_responses_base_url" \
    -H 'Content-Type: application/json' \
    -H 'Accept: application/json' \
    -H @- \
    -d "@$escaped" <<EOF
Authorization: Bearer $opt_api_key
EOF

  if [ "$?" -gt 128 ]; then
    printf "\n\0INTERRUPTED\n"
  else
    # print extra newline
    echo
  fi
)

make_nonstream_output() {
  tmp=$statedir/tmp.output

  jq -Rsc '
    . as $input | try (
      fromjson |
      if .status == "completed" then
        .output[], ("" | halt_error(0))
      elif .status == "failed" then
        .error, ("" | halt_error(5))
      elif .status == "incomplete" then
        .incomplete_details, .output[], ("" | halt_error(6))
      else
        if has("error") | not then
          {"error":{"message":.,"type":"__defined_by_me","code":"__defined_by_me"}}
        end, ("" | halt_error(4))
      end
    ) catch (
      if $input | endswith("\u0000INTERRUPTED\n") then
        halt_error(7)
      else
        {"error":{"message":$input,"type":"__defined_by_me","code":"__defined_by_me"}}, ("" | halt_error(4))
      end
    )' >"$tmp" 2>/dev/null
  exitcode=$?

  case $event_output in
    "") exec 3>&1 ;;
    *)  exec 3>"$event_output" ;;
  esac

  case $exitcode in
    0)
      llm-render-events <"$tmp" >&3
      ;;
    6)
      # Incomplete
      # `jq 'inputs'` skips the first value
      jq 'inputs' "$tmp" | llm-render-events >&3
      exitcode=3
      ;;
    5)
      # Failed
      exitcode=4
      ;;
    7)
      : >"$tmp"
      exitcode=5
      ;;
    *)
      exitcode=1
      ;;
  esac

  case $response_output in
    "") exec 3>&1 ;;
    *)  exec 3>"$response_output" ;;
  esac
  cat "$tmp" >&3

  return "$exitcode"
}

sse_to_jsons() {
  sse_to_json_program='
  def object_prefix_len:
    if . == "" then
      0
    elif try (fromjson | true) catch false then
      length
    else
      sub("[^}]*.$"; "") | object_prefix_len
    end;

  foreach (., inputs) as $input (
    ["", ""];
    . as [$str, $_] | $input |
    if startswith("data:") then
      ltrimstr("data:") | ltrimstr(" ") |
      if . == "[DONE]" then
        halt
      end | $str + . + "\n" | object_prefix_len as $len | [.[$len:], .[:$len]]
    elif startswith("id:") or startswith("event:") or
      startswith("retry:") or startswith(":") or . == "" then
      [$str, ""]
    else
      if endswith("\u0000INTERRUPTED") then
        [$str, {type:"_my_interrupted",sequence_number:infinite,response:null} | @json]
      else
        (try fromjson) // {error:{message:([., inputs] | add),type:"__defined_by_me",code:"__defined_by_me"}} |
          [$str, {type:"response.failed",sequence_number:infinite,response:.} | @json]
      end
    end;
    .[1] | select(. != "") | rtrimstr("\n")
  )'

  jq --unbuffered -Rr "$sse_to_json_program"
}

stream_sort() {
  # Make sure the event arrives in .sequence_number order
  stream_sort_program='
    def split_succ_prefix($n):
    .[0] as $head |
    if .[0].sequence_number == $n then
      .[1:] | split_succ_prefix($n + 1) | [[$head] + .[0], .[1]]
    else
      [[], .]
    end;

  foreach (inputs, "_END_") as $o (
    {n:null,pending:[],out:null};
    (.pending | length) as $len |
    if $o == "_END_" then
      .out = (.pending | sort_by(.sequence_number))
    elif .n == null then
      if $o.type == "response.created" then
        .n = ($o.sequence_number + 1) |
        .out= $o
      else
        .out = [] |
        .pending = (.pending + [$o] | unique_by(.sequence_number))
      end
    elif $len == 0 then
      if $o.sequence_number == .n then
        .n += 1 | .out = $o
      elif $o.sequence_number < .n then
        .out = []
      else
        .out = [] | .pending = [$o]
      end
    else
      .n as $expected |
      (
        .pending + [$o] |
        unique_by(.sequence_number) |
        split_succ_prefix($expected)
      ) as [$out, $tail] |
      .pending = $tail |
      .out = $out |
      .n += ($out | length)
    end;
    .out | if type == "array" then .[] end
  )'

  jq --unbuffered -cn "$stream_sort_program"
}

preprocess_render_event() {
  preprocess_program='
  def chunk: if length != 0 then range(0;length;512) as $n | .[$n:$n+512] end;
  . as { $type } |
  if .type == "response.reasoning_text.delta" then
    [.output_index, .content_index, null, "reasoning", .delta]
  elif .type == "response.reasoning_summary_text.delta" then
    [.output_index, null, .summary_index, "reasoning-summary", .delta]
  elif .type == "response.output_text.delta" then
    [.output_index, .content_index, null, "message-text assistant", .delta]
  elif .type == "response.refusal.delta" then
    [.output_index, .content_index, null, "message-refusal assistant", .delta]
  elif .type == "response.content_part.added" or
      .type == "response.content_part.done" then
    [
      .output_index,
      .content_index,
      null,
      (
        .part |
        if .type == "reasoning_text" then
          "reasoning"
        elif .type == "output_text" then
          "message-text assistant"
        elif .type == "refusal_text" then
          "message-refusal assistant"
        else
          ""
        end,
        .text? // .refusal?
      )
    ]
  elif .type == "response.output_item.added" then
    [
      .output_index,
      null,
      null,
      if .item.type != "reasoning" and .item.type != "message" then
        "notify " + .item.type + "@start", (.item | @json)
      else
        "", ""
      end
    ]
  elif .type == "response.output_item.done" then
    .output_index as $output_index |
    if .item.type == "reasoning" then
      (.item.summary // [], .item.content // [])[] |
      if .type == "reasoning_text" then
        [ "reasoning", .text ]
      else
        [ "reasoning-summary", .text ]
      end
    elif .item.type == "function_call" or .item.type == "custom_tool_call" then
      ["tool-call " + .item.name, (.item | @json)]
    else
      ["notify " + .item.type, (.item | @json)]
    end | . as [$render_event, $payload] |
    [$output_index, null, null, $render_event, $payload]
  elif .type == "response.reasoning_summary_part.added" then
    [.output_index, null, .summary_index, "reasoning-summary", .part.text]
  elif .type == "response.reasoning_summary_part.done" then
    [.output_index, null, .summary_index, "", .part.text]
  elif .type == "response.completed" then
    [null, null, null, "", (.response.output | @json)]
  elif .type == "response.failed" then
    [null, null, null, "", ([.response.error] | @json)]
  elif .type == "response.incomplete" then
    [null, null, null, "", ([.response.incomplete_details] + .response.output | @json)]
  elif .type == "_my_interrupted" then
    [null, null, null, "", ""]
  else
    empty
  end | . as [$output_index, $content_index, $summary_index, $render_event] | .[4] | chunk |
  ($type, $output_index, $content_index, $summary_index, $render_event, @json)'

  if ! jq --unbuffered -rc "$preprocess_program"; then
    jq -nrc '"response.failed",0,0,0,"",({
        "message":"json parsing error",
        "code":"__defined_by_me",
        "type":"__defined_by_me"
      } | @json | @json)'
  fi
}

make_stream_output() {
  mkdir -- "$buffer_statedir" || return 1
  set --
  case $event_output in
    "") exec 3>&1 ;;
    *)  exec 3>"$event_output" ;;
  esac

  current_is_summary=
  current_is_nonsummary=
  current_item_index=0
  current_content_index=0
  emit_render_event() {
    printf "%s\n%s\n" "$1" "$2"
  }

  emit_on_advance() {
    if [ ! -e "$buffer_statedir/$current_item_index/$prefix$current_content_index" ]; then
      if [ -e "$buffer_statedir/$current_item_index/${prefix}0" ]; then
        # There is a content part in this output item, which is already output, skip.
        return
      fi

      cat -- "$buffer_statedir/$current_item_index/done"
      return
    fi
      
    dir="$buffer_statedir/$current_item_index/$prefix$current_content_index"
    part_file=$dir/part
    if [ -e "$part_file" ]; then
      cat -- "$part_file"
      rm -- "$part_file"
    fi
  }

  emit_and_advance_index() {
    prefix=
    [ -e "$buffer_statedir/$current_item_index/is_summary" ] && prefix=summary-
    while :; do
      if [ -e "$buffer_statedir/$current_item_index/$prefix$current_content_index/done" ]; then
        emit_on_advance
        current_content_index=$((current_content_index + 1))
        continue
      fi
      if [ -e "$buffer_statedir/$current_item_index/done" ]; then
        if [ ! -e "$buffer_statedir/$current_item_index/0" ] \
          && [ ! -e "$buffer_statedir/$current_item_index/summary-0" ]; then
          # For output item that contains no content array, always emit an
          # event.
          emit_on_advance
          # If an event associated with an item is emitted, a nop event
          # should also be emitted to separate item events with the same
          # header.
          emit_render_event "nop" "\"\""
        fi
        current_item_index=$((current_item_index + 1))
        current_content_index=0
        prefix=
        [ -e "$buffer_statedir/$current_item_index/is_summary" ] && prefix=summary-
        continue
      fi

      break
    done
  }

  is_current() {
    [ "$output_index" -eq "$current_item_index" ] \
      && [ "$content_index" -eq "$current_content_index" ]
  }

  should_set_current_output_kind() {
    [ "$output_index" -eq "$current_item_index" ] \
      && [ -z "$current_is_summary$current_is_nonsummary" ]
  }

  should_set_output_kind() {
    [ ! -e "$buffer_statedir/$output_index/is_nonsummary" ] && [ ! -e "$buffer_statedir/$output_index/is_summary" ]
  }

  done_pending=
  while read -r type && read -r output_index && read -r content_index \
    && read -r summary_index && read -r render_event && read -r payload; do
    if [ -n "$done_pending" ]; then
      case $type in
        *.done)
          if [ "$done_pending" != "${output_index}-${content_index}-$summary_index" ]; then
            emit_and_advance_index
            done_pending=
          fi
          ;;
        *)
          emit_and_advance_index
          done_pending=
          ;;
      esac
    fi

    case $type in
      response.reasoning_summary_part.done)
        f=$buffer_statedir/$output_index/summary-$summary_index/done
        if [ ! -f "$f" ]; then
          : >"$f"
          done_pending=${output_index}-null-$summary_index
        fi
        ;;
      response.reasoning_summary_text.delta)
        if is_current && [ -n "$current_is_summary" ]; then
          emit_render_event "$render_event" "$payload"
        else
          f=$buffer_statedir/$output_index/summary-$summary_index/part
          emit_render_event "$render_event" "$payload" >>"$f"
        fi
        ;;
      response.reasoning_text.delta)
        # If output kind unset or directory not created, set it and create it.
        # This should not happen on restrict server-side implementation of
        # OpenAI Response API, but some non-restrict implementation may miss
        # or misuse some events(for example, qwen) and make this happen.
        if should_set_current_output_kind; then
          current_is_nonsummary=1
          d=$buffer_statedir/$output_index/$content_index
          [ ! -d "$d" ] && mkdir -p -- "$d"
        fi

        if is_current && [ -z "$current_is_summary" ]; then
          emit_render_event "$render_event" "$payload"
        else
          d=$buffer_statedir/$output_index/$content_index
          emit_render_event "$render_event" "$payload" >>"$d/part"
        fi
        ;;
      response.output_text.delta)
        if is_current && [ -z "$current_is_summary" ]; then
          emit_render_event "$render_event" "$payload"
        else
          d=$buffer_statedir/$output_index/$content_index
          [ ! -d "$d" ] && mkdir -p -- "$d"
          emit_render_event "$render_event" "$payload" >>"$d/part"
        fi
        ;;
      response.refusal.delta)
        if is_current && [ -z "$current_is_summary" ]; then
          emit_render_event "$render_event" "$payload"
        else
          d=$buffer_statedir/$output_index/$content_index
          [ ! -d "$d" ] && mkdir -p -- "$d"
          emit_render_event "$render_event" "$payload" >>"$d/part"
        fi
        ;;
      response.content_part.added)
        d=$buffer_statedir/$output_index/$content_index
        [ ! -d "$d" ] && mkdir -p -- "$d"
        should_set_current_output_kind && current_is_nonsummary=1
        should_set_output_kind && : >"$buffer_statedir/$output_index/is_nonsummary"
        if is_current && [ -n "$current_is_nonsummary" ]; then
          emit_render_event "$render_event" "$payload"
        else
          emit_render_event "$render_event" "$payload" >>"$d/part"
        fi
        ;;
      response.content_part.done)
        f=$buffer_statedir/$output_index/$content_index/done
        if [ ! -f "$f" ]; then
          : >"$f"
          done_pending=${output_index}-${content_index}-null
        fi
        ;;
      response.output_item.added)
        d=$buffer_statedir/$output_index
        [ ! -d "$d" ] && mkdir -- "$d"
        if [ -n "$render_event" ] && [ "$output_index" -eq "$current_item_index" ]; then
          emit_render_event "$render_event" "$payload"
        fi
        ;;
      response.output_item.done)
        f=$buffer_statedir/$output_index/done
        emit_render_event "$render_event" "$payload" >>"$f"
        done_pending=${output_index}-null-null
        if [ "$output_index" -eq "$current_item_index" ]; then
          current_is_summary=
          current_is_nonsummary=
        fi
        ;;
      response.reasoning_summary_part.added)
        d=$buffer_statedir/$output_index/summary-$summary_index
        [ ! -d "$d" ] && mkdir -- "$d"
        should_set_current_output_kind && current_is_summary=1
        should_set_output_kind && : >"$buffer_statedir/$output_index/is_summary"
        if is_current && [ -n "$current_is_summary" ]; then
          emit_render_event "$render_event" "$payload"
        else
          emit_render_event "$render_event" "$payload" >>"$d/part"
        fi
        ;;
      response.completed|response.failed|response.incomplete|_my_interrupted)
        break
        ;;
      # response.reasoning_text.done)
      #   ;;
      # response.output_text.done)
      #   ;;
      # response.refusal.done)
      #   ;;
      *)
        continue
        ;;
    esac
  done >&3

  case $response_output in
    "") exec 3>&1 ;;
    *)  exec 3>"$response_output" ;;
  esac

  exitcode=0
  drain=1
  case $type in
    response.completed)
      ;;
    response.incomplete)
      exitcode=3
      ;;
    response.failed)
      exitcode=4
      ;;
    _my_interrupted)
      drain=
      exitcode=5
      ;;
    *)
      jq -n '{
        error: {
        message:"the stream terminated abnormally",
        type:"__defined_by_me",
        code:"__defined_by_me"
        }
      }' >&3
      drain=
      exitcode=1
      ;;
  esac
  if [ -n "$drain" ]; then
    {
      printf "%s" "$payload"
      while read -r unused && read -r unused && read -r unused \
        && read -r unused && read -r unused && read -r payload; do
        printf "%s" "$payload"
      done
    } | jq -j '.' | jq -c '.[]' >&3
  fi
  return "$exitcode"
}

make_interrupted_output() {
  build_interruted_output_program='
  reduce (., inputs) as $event ([];
  if $event.type == "response.reasoning_text.delta" then
    if .[$event.output_index].content[$event.content_index] | not then
      .[$event.output_index].content[$event.content_index].type = "reasoning_text"
    end | .[$event.output_index].content[$event.content_index].text += $event.delta
  elif $event.type == "response.output_text.delta" then
    if .[$event.output_index].content[$event.content_index] | not then
      .[$event.output_index].content[$event.content_index].type = "output_text"
    end |
    .[$event.output_index].content[$event.content_index].text += $event.delta |
    if $event.logprobs != null then
      .[$event.output_index].content[$event.content_index].logprobs += $event.logprobs
    end
  elif $event.type == "response.refusal.delta" then
    if .[$event.output_index].content[$event.content_index] | not then
      .[$event.output_index].content[$event.content_index].type = "refusal"
    end |
    .[$event.output_index].content[$event.content_index].refusal += $event.delta
  elif $event.type == "response.reasoning_summary_text.delta" then
    if .[$event.output_index].summary[$event.summary_index] | not then
      .[$event.output_index].summary[$event.summary_index].type = "summary_text"
    end |
    .[$event.output_index].summary[$event.summary_index].text += $event.delta
  elif $event.type == "response.reasoning_summary_part.added" then
    .[$event.output_index].summary[$event.summary_index] = $event.part
  elif $event.type == "response.reasoning_summary_part.done" then
    .[$event.output_index].summary[$event.summary_index] = $event.part
  elif $event.type == "response.content_part.added" then
    .[$event.output_index].content[$event.content_index] = $event.part
  elif $event.type == "response.content_part.done" then
    .[$event.output_index].content[$event.content_index] = $event.part
  elif $event.type == "response.output_item.added" then
    .[$event.output_index] = $event.item
  elif $event.type == "response.output_item.done" then
    .[$event.output_index] = $event.item
  end)[] | select(. != null) |
    if .type == "message" or .type == "reasoning" then .status = "completed" end'
  jq -c -- "$build_interruted_output_program"
}

statedir=
cleanup() {
  [ -n "$statedir" ] && rm -rf -- "$statedir"
  if [ -n "$1" ]; then
    trap - "$1"
    kill -"$1" "$$"
  fi
}

trap 'cleanup' EXIT
trap '' INT
trap 'cleanup TERM' TERM
trap 'cleanup QUIT' QUIT


statedir=$(tmpfile -d) || exit 1
tmp_input=$statedir/tmp.curl-input
tmp_sorted_stream=$statedir/tmp.stream
buffer_statedir=$statedir/buffer

if [ -n "$opt_input" ]; then
  make_input >"$tmp_input" <"$opt_input"
else
  make_input >"$tmp_input"
fi

if [ -z "$opt_stream" ]; then
  call_curl | make_nonstream_output
else
  call_curl | sse_to_jsons | stream_sort \
    | tee -- "$tmp_sorted_stream" | preprocess_render_event | make_stream_output
  exitcode=$?
  if [ "$exitcode" -eq 5 ]; then
    # interrupted
    case $response_output in
      "") exec 3>&1 ;;
      *)  exec 3>"$response_output" ;;
    esac
    make_interrupted_output <"$tmp_sorted_stream" >&3
  fi
  exit "$exitcode"
fi

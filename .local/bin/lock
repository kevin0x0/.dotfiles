#!/bin/sh

RUNTIME_STATE_DIR=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}

remaining=$#
while [ "$remaining" -ne 0 ]; do
  remaining=$((remaining - 1))
  lockfile=$RUNTIME_STATE_DIR/lock-$1
  shift
  while ! (umask 0077; set -C; : >"$lockfile") 2>/dev/null; do
    sleep 1
  done
  set -- "$@" "$lockfile"
done

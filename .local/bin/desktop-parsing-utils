dsk_split_list='{
  dsk_entry_get "$DSK_ARG_TO_BE_SPLIT_KEY" dsk_tmp
  dsk_separator_pattern="[\\\\${DSK_ARG_SEPARATOR:-;}]"
  dsk_head=${dsk_tmp%%$dsk_separator_pattern*}
  dsk_curr_item=$dsk_head
  dsk_tmp=${dsk_tmp#"$dsk_head"}
  while [ -n "$dsk_tmp" ]; do
    case $dsk_tmp in
      \\*)
        dsk_tmp=${dsk_tmp#?}
        dsk_curr_item=$dsk_curr_item\\${dsk_tmp%"${dsk_tmp#?}"}
        dsk_tmp=${dsk_tmp#?}
        ;;
      "${DSK_ARG_SEPARATOR:-;}"*)
        dsk_curr_item=$(dsk_parse_string_value "$dsk_curr_item"; echo x)
        set -- "$@" "${dsk_curr_item%x}"
        dsk_tmp=${dsk_tmp#?}
        dsk_curr_item=
        ;;
    esac
    dsk_head=${dsk_tmp%%$dsk_separator_pattern*}
    dsk_tmp=${dsk_tmp#"$dsk_head"}
    dsk_curr_item=$dsk_curr_item$dsk_head
  done

  if [ -n "$dsk_curr_item" ]; then
    dsk_curr_item=$(dsk_parse_string_value "$dsk_curr_item"; echo x)
    set -- "$@" "${dsk_curr_item%x}"
  fi
}'

MESSAGES=${LC_ALL:-"${LC_MESSAGES:-"$LANG"}"}

M_MODIFIER=${MESSAGES#"${MESSAGES%%@*}"}
MESSAGES=${MESSAGES%%[.@]*}

M_COUNTRY=${MESSAGES##"${MESSAGES%_*}"}
MESSAGES=${MESSAGES%_*}

M_LANG=$MESSAGES

dsk_match_locale() {
  if [ "$M_LANG$M_COUNTRY$M_MODIFIER" = "$1" ]; then
    echo 4
    return
  fi

  if [ "$M_LANG$M_COUNTRY" = "$1" ]; then
    echo 3
    return
  fi

  if [ "$M_LANG$M_MODIFIER" = "$1" ]; then
    echo 2
    return
  fi

  if [ "$M_LANG" = "$1" ]; then
    echo 1
    return
  fi

  echo 0
}

dsk_parse_string_value() (
  s=$1
  result=${s%%\\*}
  s=${s#"$result"}
  while [ "${#s}" -ne 0 ]; do
    s=${s#\\}
    case $s in
      s*) result="$result " ;;
      n*) result=$result$'\n' ;;
      t*) result=$result$'\t' ;;
      r*) result=$result$'\r' ;;
      \\*) result="$result\\" ;;
      ?*) result="$result${s%"${s#?}"}" ;;
    esac
    s=${s#?}
    head=${s%%\\*}
    s=${s#"$head"}
    result="$result$head"
  done

  printf "%s" "$result"
)

dsk_instance_set() {
  eval " dsk_instance_${DSK_INSTANCE}_private_$1"='$2'
}

dsk_instance_get() {
  eval " $2"="\${dsk_instance_${DSK_INSTANCE}_private_$1}"
}

dsk_instance_user_set() {
  eval " dsk_instance_${DSK_INSTANCE}_user_$1"='$2'
}

dsk_instance_user_get() {
  eval " $2"="\${dsk_instance_${DSK_INSTANCE}_user_$1}"
}


dsk_set() {
  eval " dsk_instance_${DSK_INSTANCE}_group_namespace_${DSK_GROUP}_$1"='$2'
}

dsk_get() {
  eval " $2"="\${dsk_instance_${DSK_INSTANCE}_group_namespace_${DSK_GROUP}_$1}"
}

dsk_prefix_set() {
  dsk_encode "$2" dsk_encoded_entry_key
  eval " dsk_instance_${DSK_INSTANCE}_group_namespace_${DSK_GROUP}_${1}_$dsk_encoded_entry_key"='$3'
}

dsk_prefix_get() {
  dsk_encode "$2" dsk_encoded_entry_key
  eval " $3"="\${dsk_instance_${DSK_INSTANCE}_group_namespace_${DSK_GROUP}_${1}_$dsk_encoded_entry_key}"
}

dsk_is_set() {
  dsk_encode "$2" dsk_encoded_entry_key
  eval " [ -n \"\$dsk_instance_${DSK_INSTANCE}_group_namespace_${DSK_GROUP}_${1}_$dsk_encoded_entry_key\" ]"
}

dsk_entry_set() {
  dsk_encode "$1" dsk_encoded_entry_key
  eval " unset dsk_instance_${DSK_INSTANCE}_group_namespace_${DSK_GROUP}_parsed_entry_key_$dsk_encoded_entry_key"
  eval " dsk_instance_${DSK_INSTANCE}_group_namespace_${DSK_GROUP}_entry_key_$dsk_encoded_entry_key"='$2'
}

dsk_entry_get() {
  dsk_encode "$1" dsk_encoded_entry_key
  eval " $2"="\${dsk_instance_${DSK_INSTANCE}_group_namespace_${DSK_GROUP}_entry_key_$dsk_encoded_entry_key}"
}

dsk_entry_get_stdout() {
  dsk_encode "$1" dsk_encoded_entry_key
  eval " printf \"%s\" \"\${dsk_instance_${DSK_INSTANCE}_group_namespace_${DSK_GROUP}_entry_key_$dsk_encoded_entry_key}\""
}

dsk_entry_get_string() {
  if ! dsk_is_set "parsed_entry_key" "$1"; then
    dsk_entry_get "$1" dsk_tmp
    dsk_prefix_set parsed_entry_key "$1" 1
    dsk_tmp=$(dsk_parse_string_value "$dsk_tmp"; echo x)
    dsk_tmp=${dsk_tmp%x}
    dsk_prefix_set cache_entry_key "$1" "$dsk_tmp"
    eval " $2"='$dsk_tmp'
  else
    dsk_prefix_get cache_entry_key "$1" "$2"
  fi
}

dsk_array_clear() {
  eval "dsk_array_${1}_num=0"
}

dsk_array_len() {
  eval "$2=\$dsk_array_${1}_num"
}

dsk_array_setlen() {
  eval "dsk_array_${1}_num"='$2'
}

dsk_array_add() {
  dsk_arrayname=$1
  shift
  dsk_array_len "$dsk_arrayname" dsk_arraylen
  for dsk_cmdarg; do
    eval "dsk_array_${dsk_arrayname}_${dsk_arraylen}"='$dsk_cmdarg'
    dsk_arraylen=$((dsk_arraylen + 1))
  done
  dsk_array_setlen "$dsk_arrayname" "$dsk_arraylen"
}

dsk_array_get() {
  eval "$3=\$dsk_array_${1}_${2}"
}

dsk_array_set() {
  eval "dsk_array_${1}_${2}"='$3'
}

dsk_perform_exec() (
  OPTIND=1
  opt_desktop_path=
  opt_launcher=echo
  while getopts "d:t:" opt; do
    case $opt in
      d)
        opt_desktop_path=$OPTARG
        ;;
      t)
        opt_launcher=$OPTARG
        ;;
      \?)
        exit 2
        ;;
    esac
  done
  shift "$((OPTIND - 1))"

  narg=$#

  # Split Exec into executable program and arguments respecting quoting

  dsk_entry_get_string Exec s
  dsk_array_clear cmd
  s=${s#"${s%%[! ]*}"}
  while [ "${#s}" -ne 0 ]; do
    case $s in
      \"*)
        s=${s#\"}
        cmdarg=${s%%[\"\\]*}
        s=${s#"$cmdarg"}
        while [ "${#s}" -ne 0 ]; do
          case $s in
            \"*)
              s=${s#\"}
              break
              ;;
            \\*)
              s=${s#\\}
              case $s in
                \"*) cmdarg=$cmdarg\" ;;
                \`*) cmdarg="$cmdarg\`" ;;
                \$*) cmdarg="$cmdarg\$" ;;
                \\*) cmdarg="$cmdarg\\" ;;
                *)   cmdarg="$cmdarg\\${s%"${s#?}"}" ;;
              esac
              s=${s#?}
              ;;
          esac
          remaining=${s%%[\"\\]*}
          s=${s#"$remaining"}
          cmdarg=$cmdarg$remaining
        done
        dsk_array_add cmd "$cmdarg"
        ;;
      *)
        head=${s%% *}
        dsk_array_add cmd "$head"
        s=${s#"$head"}
        ;;
    esac
    s=${s#"${s%%[! ]*}"}
  done

  # Substitute field codes %[UFick%] and remember where %[uf] appear.

  arg_comsumed=
  uf_arg_index=
  uf_offset_in_arg=
  uf_kind=
  i=0
  dsk_array_len cmd cmdlen
  dsk_array_clear substcmd
  while [ "$i" -lt "$cmdlen" ]; do
    dsk_array_get cmd "$i" cmdarg
    case $cmdarg in
      %F)
        if [ -n "$arg_comsumed" ]; then
          printf "%s\n" "multiple %F %U %f %u occurred" >&2
          return 1
        fi

        # Here we just take all arguments as pathname
        for arg; do
          case $arg in
            /*)
              ;;
            *)
              arg=$PWD/$arg
              ;;
          esac
          dsk_array_add substcmd "$arg"
        done
        set --
        arg_comsumed=1
        ;;
      %U)
        if [ -n "$arg_comsumed" ]; then
          printf "%s\n" "multiple %F %U %f %u occurred" >&2
          return 1
        fi

        for arg; do
          dsk_array_add substcmd "$(path2uri -- "$arg")"
        done
        set --
        arg_comsumed=1
        ;;
      %[uf])
        if [ -n "$arg_comsumed" ]; then
          printf "%s\n" "multiple %F %U %f %u occurred" >&2
          return 1
        fi
        # %f and %u comprises an argument on its own, remove the whole
        # argument from command line if no file to be open.
        if [ "$narg" -ne 0 ]; then
          uf_kind=${cmdarg#%}
          dsk_array_len substcmd uf_arg_index
          dsk_array_add substcmd ""
          uf_offset_in_arg=0
          arg_comsumed=1
        fi
        ;;
      %i)
        dsk_entry_get_string Icon icon_path
        [ -n "$icon_path" ] && dsk_array_add substcmd --icon "$icon_path"
        ;;
      *)
        head=${cmdarg%%\%*}
        cmdarg=${cmdarg#"$head"}
        substcmdarg=$head
        while [ "${#cmdarg}" -ne 0 ]; do
          cmdarg=${cmdarg#\%}
          case $cmdarg in
            k*) substcmdarg="$substcmdarg$opt_desktop_path" ;;
            \%*) substcmdarg="$substcmdarg%" ;;
            c*)
              dsk_entry_get_string Name name
              substcmdarg="$substcmdarg$name"
              ;;
            u*|f*)
              if [ -n "$arg_comsumed" ]; then
                printf "%s\n" "multiple %F %U %f %u occurred" >&2
                return 1
              fi

              uf_kind=${cmdarg%"${cmdarg#?}"}
              arg_comsumed=1
              dsk_array_len substcmd uf_arg_index
              uf_offset_in_arg=$(printf "%s" "$substcmdarg" | wc -c | tr -d '[:space:]')
              ;;
            *)
              ;;
          esac
          cmdarg=${cmdarg#?}
          head=${cmdarg%%\%*}
          cmdarg=${cmdarg#"$head"}
          substcmdarg=$substcmdarg$head
        done
        dsk_array_add substcmd "$substcmdarg"
        ;;
    esac
    i=$((i + 1))
  done

  # Execute command

  if [ -z "$arg_comsumed" ] && [ "$narg" -ne 0 ]; then
    printf "this app doesn't accept arguments\n" >&2
    return 1
  fi

  dsk_array_len substcmd cmdlen

  if [ "$#" -eq 0 ]; then
    # Either no argument or arguments were consumed by %[UF] 
    i=0
    while [ "$i" -lt "$cmdlen" ]; do
      dsk_array_get substcmd "$i" cmdarg
      set -- "$@" "$cmdarg"
      i=$((i + 1))
    done
    "$opt_launcher" "$@"
    return
  fi

  for arg; do
    (
      if [ -n "$uf_arg_index" ]; then
        case $uf_kind in
          u)
            arg=$(path2uri -- "$arg")
            ;;
          f)
            case $arg in
              /*)
                ;;
              *)
                arg=$PWD/$arg
                ;;
            esac
            ;;
        esac

        dsk_array_get substcmd "$uf_arg_index" cmdarg
        if [ "$uf_offset_in_arg" -eq 0 ]; then
          cmdarg=$(printf "%s%sx" "$arg" "$cmdarg")
        else
          cmdarg=$(printf "%s" "$cmdarg" | \
            { dd bs="$uf_offset_in_arg" count=1 iflag=fullblock 2>/dev/null; printf "%s" "$arg"; cat; echo x; })
        fi
        dsk_array_set substcmd "$uf_arg_index" "${cmdarg%x}"
      fi

      set --
      i=0
      while [ "$i" -lt "$cmdlen" ]; do
        dsk_array_get substcmd "$i" cmdarg
        set -- "$@" "$cmdarg"
        i=$((i + 1))
      done
      "$opt_launcher" "$@"
    )
  done
)

dsk_parse_key_value() {
  dsk_key=$1
  dsk_value=$2
  case $dsk_key in
    *'['*']') # localestring
      dsk_locale=${dsk_key#*"["}
      dsk_locale=${dsk_locale%"]"}
      dsk_key=${dsk_key%%"["*}
      dsk_this_match_level=$(dsk_match_locale "$dsk_locale")
      if ! dsk_is_set match_level "$dsk_key"; then
        [ "$dsk_this_match_level" -eq 0 ] && return
        dsk_prefix_set match_level "$dsk_key" "$dsk_this_match_level"
        dsk_entry_set "$dsk_key" "$dsk_value"
      else
        dsk_prefix_get match_level "$dsk_key" dsk_last_match_level
        if [ "$dsk_last_match_level" -lt "$dsk_this_match_level" ]; then
          dsk_prefix_set match_level "$dsk_key" "$dsk_this_match_level"
          dsk_entry_set "$dsk_key" "$dsk_value"
        fi
      fi
      ;;
    *)
      if dsk_is_set "match_level" "$dsk_key"; then
        # This has type localestring and there is already one match
        return
      fi
      dsk_entry_set "$dsk_key" "$dsk_value"
      ;;
  esac
}

dsk_drain() {
  dsk_instance_get lookahead dsk_line
  while :; do
    case $dsk_line in
      '#'*|'')
        ;;
      \[*\])
        dsk_set group_parsed 1
        dsk_group_name=${dsk_line#'['}
        dsk_group_name=${dsk_group_name%']'}
        dsk_set_current_group "$dsk_group_name"
        ;;
      *=*)
        dsk_key=${dsk_line%%=*}
        dsk_value=${dsk_line#"$dsk_key"=}
        dsk_key=${dsk_key%"${dsk_key##*[![:space:]]}"}
        dsk_value=${dsk_value#"${dsk_value%%[![:space:]]*}"}
        dsk_parse_key_value "$dsk_key" "$dsk_value"
        ;;
    esac
    read -r dsk_line || break
  done
  dsk_instance_set lookahead "$dsk_line"
}

dsk_parse_group() {
  dsk_set_current_group "$1"
  dsk_get group_parsed dsk_tmp
  [ -n "$dsk_tmp" ] && return

  dsk_instance_get lookahead dsk_line
  dsk_match_group_name=$1
  dsk_group_found=
  while :; do
    case $dsk_line in
      '#'*|'')
        ;;
      \[*\])
        [ -n "$dsk_group_found" ] && break

        dsk_group_name=${dsk_line#'['}
        dsk_group_name=${dsk_group_name%']'}
        [ "$dsk_match_group_name" = "$dsk_group_name" ] && dsk_group_found=1
        dsk_set_current_group "$dsk_group_name"
        dsk_set group_parsed 1
        ;;
      *=*)
        dsk_key=${dsk_line%%=*}
        dsk_value=${dsk_line#"$dsk_key"=}
        dsk_key=${dsk_key%"${dsk_key##*[![:space:]]}"}
        dsk_value=${dsk_value#"${dsk_value%%[![:space:]]*}"}
        dsk_parse_key_value "$dsk_key" "$dsk_value"
        ;;
    esac
    read -r dsk_line || break
  done
  dsk_instance_set lookahead "$dsk_line"

  [ -n "$dsk_group_found" ]
}

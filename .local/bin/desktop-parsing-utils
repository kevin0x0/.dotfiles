#!/bin/sh

dsk_set_current_group() {
  dsk_encode "$1" DSK_GROUP
}

dsk_set_current_instance() {
  dsk_encode "$1" DSK_INSTANCE
}

dsk_encode() {
  dsk_out=
  dsk_alnum=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789
  case $1 in
    *[!-/:%\&.=\ @_$dsk_alnum]*|0*)
      dsk_out=0$(
        printf "%s" "$1" | od -vA n -t o1 | sed -E 's/[[:space:]]+/ /g' \
          | (
              out=
              while read dsk_oct_line; do
                for dsk_oct in $dsk_oct_line; do
                  dsk_oct=000$dsk_oct
                  out=$out${dsk_oct#"${dsk_oct%???}"}
                done
              done
              printf "%s" "$out"
            )
        )
      ;;
    *[!$dsk_alnum]*)
      dsk_s=$1
      dsk_head=${dsk_s%%[-/:%&.=@_ ]*}
      dsk_out=$dsk_head
      dsk_s=${dsk_s#"$dsk_head"}
      while [ -n "$dsk_s" ]; do
        case "$dsk_s" in
          '-'*) dsk_out=$dsk_out"_A" ;;
          '/'*) dsk_out=$dsk_out"_B" ;;
          ':'*) dsk_out=$dsk_out"_C" ;;
          '%'*) dsk_out=$dsk_out"_D" ;;
          '&'*) dsk_out=$dsk_out"_E" ;;
          '.'*) dsk_out=$dsk_out"_F" ;;
          '='*) dsk_out=$dsk_out"_G" ;;
          '@'*) dsk_out=$dsk_out"_H" ;;
          ' '*) dsk_out=$dsk_out"_I" ;;
          '_'*) dsk_out=$dsk_out"_J" ;;
        esac
        dsk_s=${dsk_s#?}
        dsk_head=${dsk_s%%[-/:%&.=@_ ]*}
        dsk_out=$dsk_out$dsk_head
        dsk_s=${dsk_s#"$dsk_head"}
      done
      ;;
    *)
      dsk_out=$1
      ;;
  esac
  eval "$2"='$dsk_out'
}

dsk_decode() {
  dsk_out=
  dsk_s=$1
  case $dsk_s in
    0*)
      dsk_out=
      dsk_s=${dsk_s#0}
      while [ -n "$dsk_s" ]; do
        dsk_tail=${dsk_s#???}
        dsk_head=${dsk_s%"$dsk_tail"}
        dsk_s=$dsk_tail
        dsk_out=$dsk_out"\\$dsk_head"
      done
      dsk_out=$(printf "${dsk_out}x")
      dsk_out=${dsk_out%x}
      ;;
    *)
      dsk_head=${dsk_s%%_*}
      dsk_out="$dsk_head"
      dsk_s=${dsk_s#"$dsk_head"}
      while [ -n "$dsk_s" ]; do
        dsk_s=${dsk_s#_}
        case "$dsk_s" in
          'A'*) dsk_out=$dsk_out"-" ;;
          'B'*) dsk_out=$dsk_out"/" ;;
          'C'*) dsk_out=$dsk_out":" ;;
          'D'*) dsk_out=$dsk_out"%" ;;
          'E'*) dsk_out=$dsk_out"&" ;;
          'F'*) dsk_out=$dsk_out"." ;;
          'G'*) dsk_out=$dsk_out"=" ;;
          'H'*) dsk_out=$dsk_out"@" ;;
          'I'*) dsk_out=$dsk_out" " ;;
          'J'*) dsk_out=$dsk_out"_" ;;
        esac
        dsk_s=${dsk_s#?}
        dsk_head=${dsk_s%%_*}
        dsk_out=$dsk_out$dsk_head
        dsk_s=${dsk_s#"$dsk_head"}
      done
      ;;
  esac

  eval " $2"='$dsk_out'
}


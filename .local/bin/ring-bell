#!/bin/sh

bells_dir=${XDG_CACHE_HOME:-$HOME/.cache}/ring-bell
mkdir -p -- "$bells_dir"

[ "$#" -eq 0 ] && set -- bell
for arg; do
  cache_file=$bells_dir/$arg
  if [ -f "$cache_file" ]; then
    sound_file=$cache_file
    break
  fi
  sound_file=$(sound-lookup -- "$arg")
  case "$sound_file" in
    /dev/null|*.disabled)
      continue
      ;;
    *)
      ln -sf "$sound_file" "$cache_file"
      break
      ;;
  esac

done

if command -v paplay >/dev/null 2>/dev/null && \
  pactl info 2>/dev/null >/dev/null; then
  paplay -- "$sound_file"
elif command -v mpv >/dev/null 2>/dev/null; then
  mpv -- "$sound_file"
elif command -v aplay >/dev/null 2>/dev/null; then
  aplay -q -- "$sound_file"
fi >/dev/null

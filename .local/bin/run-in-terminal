#!/bin/sh

while getopts "e" opt; do
  case $opt in
    e)
      # ignore for compatibility
      ;;
    \?)
      exit 2
      ;;
  esac
done

shift "$((OPTIND - 1))"

term=
for candidate in "xdg-terminal-exec" "foot" "konsole" "nxterm" "color-xterm" \
  "rxvt" "dtterm" "xterm"; do
  command -v "$candidate" >/dev/null 2>&1 && { term=$candidate; break; }
done

case $term in
  xdg-terminal-exec|foot)
    exec "$term" -- "$@"
    ;;
  nxterm|color-xterm|rxvt|dtterm|xterm|konsole)
    exec "$term" -e "$@"
    ;;
esac

printf "no recognized terminal available\n" >&2
exit 1

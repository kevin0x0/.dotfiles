#!/bin/sh

opt_enable_cmd=
if [ "$1" = --enable-cmd ]; then
  shift
  opt_enable_cmd=1
fi

llm_chat_options=$(llm-chat -o print-options)
while getopts "$llm_chat_options" opt; do
  case $opt in
    \?)
      exit 2
      ;;
  esac
done
options_end=$OPTIND

if [ -n "$opt_enable_cmd" ]; then
  if [ "$((options_end - 1))" -ne "$#" ]; then
    exec llm-chat "$@" @go @break
  else
    {
      cat
      printf "@go\n@break\n"
    } | llm-chat "$@"
  fi
  exit
fi

content_provided=
content=
count=$#
index=1
while [ "$index" -le "$count" ]; do
  arg=$1
  shift

  if [ "$index" -ge "$options_end" ]; then
    content_provided=1
    content="$content${content:+ }$arg"
  else
    set -- "$@" "$arg"
  fi
  index=$((index + 1))
done

if [ -z "$content_provided" ]; then
  cat
else
  printf "%s" "$content"
fi | llm-chat -o repl-prompt-template='' "$@" "@text-from-file" "@go" "@break"

#!/bin/sh

while getopts "fnswSh:H:o:r:k:K:m:F:u:t:c:" opt; do
  case $opt in
    \?)
      exit 2
      ;;
  esac
done
options_end=$OPTIND

content_provided=
content=
count=$#
index=1
while [ "$index" -le "$count" ]; do
  arg=$1
  shift

  if [ "$index" -ge "$options_end" ]; then
    content_provided=1
    content="$content${content:+ }$arg"
  else
    set -- "$@" "$arg"
  fi
  index=$((index + 1))
done

if [ -z "$content_provided" ]; then
  cat
else
  printf "%s" "$content"
fi | llm-chat -o repl-prompt-template='' "$@" "@text-from-file" "@go" "@break"

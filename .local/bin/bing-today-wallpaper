#!/bin/sh

opt_set=false
while getopts "s" opt; do
  case $opt in
    s)
      opt_set=true
      ;;
    \?)
      exit 2
      ;;
  esac
done

shift "$((OPTIND - 1))"

request_url="https://cn.bing.com/HPImageArchive.aspx?format=js&idx=0&n=1&nc=1614319565639&pid=hp&FORM=BEHPTB&uhd=1"
url_title=$(curl -s -- "$request_url" | jq -r '.images[0] | .url,.title')
if [ -z "$url_title" ]; then
  i18n -n wallpaper 'Failed to request: $1' "$request_url" >&2
  exit 1
fi

url=${url_title%%$'\n'*}
case $url in
  null)
    i18n -n wallpaper 'Failed to extract image URL' >&2
    exit 1
    ;;
esac

url=https://cn.bing.com$url
title=$(printf "%s" "${url_title#*$'\n'}" | tr -d '/')
dir=$(xdg-user-dir PICTURES)/wallpaper

if [ "$#" -eq 1 ]; then
  dir=$1
fi

if [ ! -e "$dir" ]; then
  mkdir -p -- "$dir"
fi

if [ ! -d "$dir" ]; then
  i18n -n wallpaper '$1 is not a directory' "$dir" >&2
  exit 1
fi

if [ ! -t 2 ]; then
  silent=-Ss
fi

if ! curl $silent -- "$url" > "$dir/$title.jpg"; then
  exit 1
fi

if [ "$opt_set" = true ]; then
  run-sway-script switch-wallpaper -p -- "$dir/$title.jpg"
fi

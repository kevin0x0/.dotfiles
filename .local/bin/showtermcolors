#!/bin/sh

validate_number() {
  case "$1" in
    *[!0-9]*)
      i18n -n misc 'Need a number, got $1' "$1" >&2
      exit 1
      ;;
  esac
}

opt_show_number=
opt_number_format=%s
opt_dont_append_newline=
opt_block_size=30
opt_delimiter='
'
opt_max_block=1

while getopts "naf:s:c:d:" opt; do
  case "$opt" in
    n)
      opt_show_number=1
      ;;
    a)
      opt_dont_append_newline=1
      ;;
    f)
      opt_number_format=$OPTARG
      ;;
    s)
      validate_number "$OPTARG"
      opt_block_size=$OPTARG
      ;;
    c)
      validate_number "$OPTARG"
      opt_max_block=$OPTARG
      ;;
    d)
      opt_delimiter=$OPTARG
      ;;
    \?)
      exit 1
      ;;
  esac
done

nblock=0
while read number comment; do
  case ${#number} in
    6)
      case $number in
        *[!ABCDEFabcdef0123456789]*)
            printf "not in RRGGBB format: %s\n" "$number" >&2
            continue
          ;;
      esac
      r=${number%????}
      gb=${number#??}
      g=${gb%??}
      b=${gb#??}
      printf "\033[48;2;%u;%u;%um%${opt_block_size}s\033[0m$opt_number_format" \
        "0x$r" "0x$g" "0x$b" "" "${opt_show_number:+$number}"
      ;;
    1|2|3)
      case $number in
        *[!0123456789]*|[!012]??|2[6789]?|25[6789])
            printf "not a valid 256-color palette index: %s\n" "$number" >&2
            continue
          ;;
        00?)
          number=${number#00}
          ;;
        0??)
          number=${number#0}
          ;;
      esac
      printf "\033[48;5;%um%${opt_block_size}s\033[0m$opt_number_format" "$number" "" \
        "${opt_show_number:+$number}"
      ;;
    '')
      continue
      ;;
    *)
      printf "unrecognized color: %s\n" "$number" >&2
      continue
      ;;
  esac

  if [ -n "$comment" ]; then
    printf " %s" "$comment"
  fi

  nblock=$((nblock + 1))
  if [ "$opt_max_block" -ne 0 ] && [ "$nblock" -ge "$opt_max_block" ]; then
    printf "%s" "$opt_delimiter"
    nblock=0
  fi
done

if [ -n "$opt_dont_append_newline" ]; then
  exit
fi

if [ "$nblock" -ne 0 ]; then
  printf "%s" "$opt_delimiter"
fi

#!/bin/sh

. llm-config-utils

usage() {
  cat <<'EOF'
usage: llm-chat-manage-hook [-d <statedir>] <subcommand> [<options>] [<args>]

Manage hooks that run on session events.

subcommands:
  create       <event> [-L] [-a] [-c] (<command> | <hook-file>) [<name>.<type>|.<type>]
  remove       <event> <name>.<type>
  list         [<glob pattern>...]
  list-events  [-s] [<ERE>...]
  list-docs    <name> [<ERE>...]
  doc          <path>...
  path         <event> <name>.<type>
  log-dump     [<ERE>...] <output-file>

options:
  -d <statedir>  session state directory; hooks live under <statedir>/hooks
  -L             symlink the hook to <hook-file> instead of copying
  -a             append to the existing hook instead of failing
  -c             treat the hook content argument as the command itself
  -j             print results as a single JSON object
  -h             print this help

A hook name has the form <name>.<type>; the type suffix selects the run
policy ("oneshot" runs once and is removed, other types run every time).
With ".<type>", an auto-generated name is used with the given type.
Events are installed under the llm-scripts events directory (in the
config and data dirs), as lowercase dot-separated names; entries
containing uppercase letters are documents.
EOF
}

opt_state_dir=
opt_json=
while getopts "d:jh" opt; do
  case $opt in
    d) opt_state_dir=$OPTARG ;;
    j) opt_json=1 ;;
    h) usage; exit 0 ;;
    \?) exit 2 ;;
  esac
done
shift "$((OPTIND - 1))"
[ "$#" -ne 0 ] || { usage >&2; exit 2; }
subcommand=$1
shift

case $subcommand in
  create|remove|list|list-events|list-docs|doc|path|log-dump) ;;
  *)
    printf "unsupported subcommand: %s\n" "$subcommand" >&2
    usage >&2
    exit 2
    ;;
esac

validate_statedir() {
  [ -n "$opt_state_dir" ] || { printf "statedir not provided (use -d)\n" >&2; return 2; }
  [ -d "$opt_state_dir" ] || { printf "'%s' is not a directory\n" "$opt_state_dir" >&2; return 2; }
}

# $1 result var (the matched absolute path), $2 result var (the matched
# path relative to the events directory), $3 event name.
# An event is installed when the events directory (searched with the
# usual config priority) contains a folding of its dot-separated
# segments: namespace entries end with ".", the final event entry does
# not. Foldings are tried in longest-prefix order; entries containing
# uppercase letters are documents and never match. Iterative DFS, as
# the llmcu functions can not be used recursively.
#
# The short e prefix is kept because sh functions share the caller's
# variable scope, and names like "name" or "event" are meaningful there.
event_registered() {
  ename=$3
  # The stack holds "suffix<TAB>relative path" pairs.
  estack=$ename$'\t'
  while [ -n "$estack" ]; do
    eentry=${estack%%$'\n'*}
    estack=${estack#"$eentry"}
    estack=${estack#$'\n'}
    esuffix=${eentry%%$'\t'*}
    epath=${eentry#*$'\t'}
    erel=${epath:+$epath/}$esuffix
    if llmcu_locate_config_item efound "events/$erel" && [ -d "$efound" ]; then
      command eval " $1"='$efound'
      command eval " $2"='$erel'
      return 0
    fi
    # Push namespace foldings, shortest prefix first so the longest is
    # popped first.
    case $esuffix in
      *.*)
        erest=${esuffix#*.}
        eprefix=${esuffix%%.*}.
        while [ -n "$erest" ]; do
          eentry=$erest$'\t'${epath:+$epath/}$eprefix
          estack=$eentry$'\n'$estack
          case $erest in
            *.*)
              eprefix=$eprefix${erest%%.*}.
              erest=${erest#*.}
              ;;
            *)
              break
              ;;
          esac
        done
        ;;
    esac
  done
  return 1
}

# $1 event name: dot-separated lowercase segments of portable filename
# characters, no empty segments. Additionally checks that the event is
# installed in the events directory.
validate_event() {
  case $1 in
    ''|*[![:alnum:]_.-]*|.*|*.|*..*|*[[:upper:]]*)
      printf "invalid event name: %s\n" "$1" >&2
      return 2
      ;;
  esac
  if ! event_registered event_rel _ "$1"; then
    printf "event not installed: %s\n" "$1" >&2
    return 2
  fi
}

# $1 event or namespace name: like validate_event, but a trailing dot
# (a namespace) is allowed.
validate_entry_name() {
  case $1 in
    ''|*[![:alnum:]_.-]*|.*|*..*|*[[:upper:]]*)
      printf "invalid entry name: %s\n" "$1" >&2
      return 2
      ;;
  esac
}

# $1 hook name: <name>.<type> with exactly one dot and no empty parts.
validate_name() {
  case $1 in
    ''|*[![:alnum:]_.-]*|.*|*.|*.*.*)
      printf "invalid hook name: %s\n" "$1" >&2
      return 2
      ;;
  esac
}

# Print matching hooks as relative paths (event/name.type).
list_hooks() {
  find "$llmcc_hooks_dir/" \( -type f -o -type l \) -print0 \
    | jq --arg prefix "$llmcc_hooks_dir/" \
        -Rsr 'split("\u0000")[] | ltrimstr($prefix) | select(length != 0)' \
    | {
        while IFS= read -r line; do
          for pattern; do
            case $line in
              $pattern) printf "%s\n" "$line"; break ;;
            esac
          done
        done
      }
}

sub_create() {
  [ "$#" -ge 1 ] || { printf "event not specified\n" >&2; return 2; }
  event=$1
  shift

  OPTIND=1
  opt_command=
  opt_symlink=
  opt_append=
  while getopts "cLa" opt; do
    case $opt in
      c) opt_command=1 ;;
      L) opt_symlink=1 ;;
      a) opt_append=1 ;;
      \?) exit 2 ;;
    esac
  done
  shift "$((OPTIND - 1))"

  validate_statedir || return
  . llm-chat-common
  llmcc_set_public_files_var "$opt_state_dir"

  validate_event "$event" || return
  if [ -n "$opt_append" ] && [ -n "$opt_symlink" ]; then
    printf "options -a and -L can not be used together\n" >&2
    return 2
  fi
  if [ -n "$opt_symlink" ] && [ -n "$opt_command" ]; then
    printf "can not create symbolic hook file for command hook\n" >&2
    return 2
  fi

  source=
  name=
  case $# in
    0) printf "hook file not provided\n" >&2; return 2 ;;
    1) source=$1 ;;
    2) source=$1; name=$2 ;;
    *) printf "too many arguments\n" >&2; return 2 ;;
  esac
  if [ -z "$opt_command" ]; then
    case $source in
      /*) ;;
      *) source=$PWD/$source ;;
    esac
    if [ ! -f "$source" ]; then
      printf "'%s' doesn't exist or not a file\n" "$source" >&2
      return 1
    fi
  fi
  type=oneshot
  if [ -n "$name" ]; then
    case $name in
      .*)
        # ".<type>": auto-generate the name part with the given type.
        type=${name#.}
        case $type in
          ''|*[![:alnum:]_-]*)
            printf "invalid hook name: %s\n" "$name" >&2
            return 2
            ;;
        esac
        name=
        ;;
      *)
        validate_name "$name" || return
        ;;
    esac
  fi

  d=$llmcc_hooks_dir/$event
  mkdir -p -- "$d" || return 1

  if [ -n "$name" ]; then
    f=$d/$name
    if [ -z "$opt_append" ] && [ -e "$f" ]; then
      printf "hook already exists: %s\n" "$f" >&2
      return 1
    fi
  else
    # llm-chat and this script never touch hooks concurrently
    name=unnamed-$$.$type
    f=$d/$name
    i=0
    while [ -e "$d/$name" ]; do
      i=$((i + 1))
      name=unnamed-$$-$i.$type
    done
    f=$d/$name
    (set -C; : >"$f") || return 1
  fi

  action=created
  if [ -n "$opt_append" ]; then
    action='appended to'
    if [ -n "$opt_command" ]; then
      printf "%s\n" "$source" >>"$f"
    else
      cat -- "$source" >>"$f"
    fi
  elif [ -n "$opt_symlink" ]; then
    ln -sf -- "$source" "$f"
  elif [ -n "$opt_command" ]; then
    printf "%s\n" "$source" >"$f"
  else
    cp -- "$source" "$f"
  fi
  [ "$?" -eq 0 ] || return 1

  rel=$event/$name
  if [ -n "$opt_json" ]; then
    if [ -n "$opt_append" ]; then
      jq -cn --arg rel "$rel" --arg path "$f" '{appended:$rel,path:$path}'
    else
      jq -cn --arg rel "$rel" --arg path "$f" '{created:$rel,path:$path}'
    fi
  else
    printf "%s hook at: %s\n" "$action" "$f"
  fi
}

sub_remove() {
  [ "$1" = "--" ] && shift
  [ "$#" -eq 2 ] || { printf "hook name not provided\n" >&2; return 2; }

  validate_statedir || return
  . llm-chat-common
  llmcc_set_public_files_var "$opt_state_dir"

  event=$1
  name=$2
  validate_event "$event" || return
  validate_name "$name" || return

  f=$llmcc_hooks_dir/$event/$name
  if [ ! -e "$f" ]; then
    printf "hook doesn't exist: %s\n" "$f" >&2
    return 1
  fi
  rm -f -- "$f"
  rel=$event/$name
  if [ -n "$opt_json" ]; then
    jq -cn --arg rel "$rel" --arg path "$f" '{removed:$rel,path:$path}'
  else
    printf "removed hook: %s\n" "$f"
  fi
}

sub_list() {
  [ "$1" = "--" ] && shift
  [ "$#" -eq 0 ] && set -- '*'

  validate_statedir || return
  . llm-chat-common
  llmcc_set_public_files_var "$opt_state_dir"

  if [ -d "$llmcc_hooks_dir" ]; then
    if [ -n "$opt_json" ]; then
      list_hooks "$@" | jq -Rsc --arg hooks_dir "$llmcc_hooks_dir" \
        'split("\n") | map(select(. != "") | {rel:., path: ($hooks_dir + "/" + .)}) | {hooks:.}'
    else
      list_hooks "$@"
    fi
  else
    [ -n "$opt_json" ] && printf '{"hooks":[]}\n'
  fi
}

# Print the installed events and namespaces as synthesized full names:
# the tree paths are folded with "/" deleted so the namespace dots
# become the separators (namespaces keep their trailing dot). Entries
# whose relative path contains an uppercase letter are documents and are
# skipped. Names are deduplicated and sorted.
sub_list_events() {
  OPTIND=1
  opt_summary=
  while getopts "s" opt; do
    case $opt in
      s) opt_summary=1 ;;
      \?) exit 2 ;;
    esac
  done
  shift "$((OPTIND - 1))"

  # $1 is the events directory (with a trailing slash) of one config
  # base; print each found path relative to it and return 1 so all
  # config bases are visited.
  do_find() {
    find -L -- "$1" \( -type d -o -type l \) -exec sh -c '
      prefix=$1
      shift
      for arg; do
        rel=${arg#"$prefix"}
        # A path with control characters is not a valid install;
        # reject it here, while it is still a single argument, before
        # any line-based processing can split it.
        case $rel in
          *[[:cntrl:]]*) continue ;;
        esac
        printf "%s\n" "$rel"
      done
    ' sh "$1" {} +
    return 1
  }

  # A namespace entry ends with "." and is always followed by "/";
  # deleting the slashes makes the namespace dots the separators,
  # yielding the full name.
  llmcu_for_config_item "events/" do_find \
    | {
        while IFS= read -r rel; do
          rel=${rel#/}
          case $rel in
            # Documents, the base directory, and names containing
            # control characters (invalid installs) are skipped.
            ''|*[[:upper:]]*|*[[:cntrl:]]*) continue ;;
          esac
          printf "%s\n" "$rel"
        done
      } \
    | tr -d '/' \
    | {
        if [ "$#" -eq 0 ]; then
          cat
        else
          grep -E -- "$(printf "%s\n" "$@")"
        fi
      } \
    | sort -u \
    | {
        if [ -z "$opt_summary" ]; then
          cat
        else
          while IFS= read -r name; do
            printf '%s\n' "$name"
            if event_registered found _ "$name" && [ -f "$found/SUMMARY" ]; then
              cat -- "$found/SUMMARY"
            fi
            # One NUL-framed record per name, so the summary may
            # contain arbitrary characters or multiple lines.
            printf '\0'
          done
        fi
      } \
    | {
        if [ -n "$opt_json" ]; then
          if [ -z "$opt_summary" ]; then
            jq -Rsc \
              'split("\n") | map(select(. != "") | {name:.}) | {events:.}'
          else
            jq -Rsc '
              [ split("\u0000")[] | select(. != "") |
                index("\n") as $i | {name: .[:$i], summary: .[$i+1:]} ]
              | {events:.}'
          fi
        else
          if [ -z "$opt_summary" ]; then
            cat
          else
            jq -Rrs '
              split("\u0000")[] | select(. != "") |
                index("\n") as $i | .[:$i], .[$i+1:]'
          fi
        fi
      }
}

# Print the documents of an entry (event or namespace) and its
# ancestors as paths "<entry name>/<doc path relative to the entry>",
# one per line. Documents are files whose path relative to their entry
# contains an uppercase letter; they are collected recursively. The
# optional arguments are EREs filtering the printed paths.
sub_list_docs() {
  [ "$1" = "--" ] && shift
  [ "$#" -ge 1 ] || { printf "entry name not provided\n" >&2; return 2; }
  name=$1
  shift

  validate_entry_name "$name" || return
  event_registered dir rel "$name" || {
    printf "entry not installed: %s\n" "$name" >&2
    return 2
  }

  {
    while :; do
      entry_name=$(printf '%s\n' "$rel" | tr -d '/')
      # The filtering and path construction run inside find -exec so
      # the paths are passed as arguments: the config directory itself
      # may contain any characters (even newlines), while the entry
      # names are portable, and only those appear in the output.
      find -L -- "$dir" -type f \
        -exec sh -c '
          entry_name=$1
          prefix=$2
          shift 2
          for f; do
            drel=${f#"$prefix"}
            case $drel in
              *[[:cntrl:]]*)
                # A path with control characters is not a valid
                # install; skip it.
                continue
                ;;
              */*)
                # Every directory component must contain an uppercase
                # letter; an all-lowercase component is another entry'\''
                # subtree.
                ok=1
                rest=${drel%/*}
                while [ -n "$rest" ]; do
                  comp=${rest%%/*}
                  case $comp in
                    *[[:upper:]]*) ;;
                    *) ok=; break ;;
                  esac
                  rest=${rest#"$comp"}
                  rest=${rest#/}
                done
                [ -n "$ok" ] || continue
                ;;
              *)
                # A direct file is a document only if its name
                # contains an uppercase letter.
                case $drel in
                  *[[:upper:]]*) ;;
                  *) continue ;;
                esac
                ;;
            esac
            printf "%s/%s\n" "$entry_name" "$drel"
          done
        ' sh "$entry_name" "$dir/" {} + 2>/dev/null
      case $rel in
        */*)
          rel=${rel%/*}
          dir=${dir%/*}
          ;;
        *)
          break
          ;;
      esac
    done
  } | sort -u \
    | {
        if [ "$#" -eq 0 ]; then
          cat
        else
          grep -E -- "$(printf "%s\n" "$@")"
        fi
      } \
    | {
        if [ -n "$opt_json" ]; then
          jq -Rsc --arg entry "$name" \
            'split("\n") | map(select(. != "")) | {entry:$entry, doclist:.}'
        else
          cat
        fi
      }
}

# Print the content of the documents at the given paths, one path per
# line header followed by its content. Paths have the form
# "<entry name>/<doc path relative to the entry>"; documents that do
# not exist are silently omitted.
sub_doc() {
  [ "$1" = "--" ] && shift
  [ "$#" -ge 1 ] || { printf "document path not provided\n" >&2; return 2; }

  {
    for docpath; do
      name=${docpath%%/*}
      rel=${docpath#"$name"}
      rel=${rel#/}
      validate_entry_name "$name" || continue
      case $rel in
        ''|*..*|/*) continue ;;
      esac
      event_registered dir _ "$name" || continue
      [ -f "$dir/$rel" ] || continue
      if [ -n "$opt_json" ]; then
        jq -Rsc --arg path "$docpath" '{path:$path, content:.}' "$dir/$rel"
      else
        printf '%s:\n' "$docpath"
        cat -- "$dir/$rel"
      fi
    done
  } | {
        if [ -n "$opt_json" ]; then
          jq -s '{docs:.}'
        else
          cat
        fi
      }
}

sub_path() {
  [ "$1" = "--" ] && shift
  [ "$#" -eq 2 ] || { printf "hook name not provided\n" >&2; return 2; }
  validate_statedir || return
  . llm-chat-common
  llmcc_set_public_files_var "$opt_state_dir"

  event=$1
  name=$2
  validate_event "$event" || return
  validate_name "$name" || return

  f=$llmcc_hooks_dir/$event/$name
  [ -e "$f" ] || { printf "hook doesn't exist: %s\n" "$f" >&2; return 1; }
  if [ -n "$opt_json" ]; then
    jq -cn --arg path "$f" '{path:$path}'
  else
    printf "%s\n" "$f"
  fi
}

# Dump the hook log lines matching the given EREs (all lines without
# any) into a new file. The EREs match the "[<event>/<hook name>]"
# line prefix; the output file must not exist yet.
sub_log_dump() {
  [ "$1" = "--" ] && shift
  validate_statedir || return
  . llm-chat-common
  llmcc_set_public_files_var "$opt_state_dir"

  eres=
  while [ "$#" -gt 1 ]; do
    eres=$eres${eres:+$'\n'}$1
    shift
  done
  [ "$#" -eq 1 ] || { printf "output file not provided\n" >&2; return 2; }
  output_file=$1

  if [ -e "$output_file" ]; then
    printf "file exists: %s\n" "$output_file" >&2
    return 1
  fi
  : >"$output_file" || return 1

  if [ -f "$llmcc_hook_log_file" ]; then
    if [ -n "$eres" ]; then
      grep -E -- "$eres" "$llmcc_hook_log_file" >"$output_file"
      grep_exit=$?
      # grep exits 1 when no line matches: an empty dump, not an error.
      [ "$grep_exit" -ne 2 ] || return 1
    else
      cp -- "$llmcc_hook_log_file" "$output_file" || return 1
    fi
  fi

  count=$(wc -l <"$output_file")
  count=${count##* }
  if [ -n "$opt_json" ]; then
    jq -cn --arg path "$output_file" --argjson count "$count" \
      '{dump:{path:$path,count:$count}}'
  else
    printf "dumped %s lines to: %s\n" "$count" "$output_file"
  fi
}

case $subcommand in
  create)      sub_create "$@" ;;
  remove)      sub_remove "$@" ;;
  list)        sub_list "$@" ;;
  list-events) sub_list_events "$@" ;;
  list-docs)   sub_list_docs "$@" ;;
  doc)         sub_doc "$@" ;;
  path)        sub_path "$@" ;;
  log-dump)    sub_log_dump "$@" ;;
esac

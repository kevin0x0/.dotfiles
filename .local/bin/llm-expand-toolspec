#!/bin/sh

. llm-config-utils

opt_tree=
while getopts "t" opt; do
  case $opt in
    t)  opt_tree=1 ;;
    \?) exit 2 ;;
  esac
done
shift "$((OPTIND - 1))"

print_toolname() {
  set -- "${1%"${1##*[!/]}"}"
  printf "%s\n" "${1##*/}"
  return 1
}

print_tree() {
  set -- "${1#"$llmcu_dir/tooltree"}" "$1"
  if [ -d "$2" ]; then
    printf "%s\n" "${1%/}/"
  else
    printf "%s\n" "$1"
  fi
  return 1
}

print_toolname_in_tree() {
  [ -f "$1" ] && printf "%s\n" "${1##*/}"
  return 1
}

expand_2asterisk_glob() {
  dir=$(normpath -R -- "$llmcu_dir/tooltree")
  llmcu_dir="${dir%/tooltree}"
  glob-expand -nb "$3" -- "$2" \
    | xargs -r0 -- sh -c '
        dir=$1; shift
        for f; do
          printf "%s\n" "${f#"$dir"}"
        done
      ' sh "$dir" \
    | while IFS= read -r line; do
        "$1" "$dir$line"
      done
  return 1
}

preset_error() {
  printf "can not specify a pattern containing whitespaces in a preset(%s in %s), ignored\n" \
    "$preset_line" "$pattern" >&2
}

expand_preset() {
  while IFS= read -r preset_line; do
    case $preset_line in
      *[[:space:]]*) preset_error ;;
      *)  patterns="$patterns $preset_line" ;;
    esac
  done <<EOF
$(llm-expand-preset -p tools -- "$pattern")
EOF
}

expand_toolspec() {
  for patterns; do
    while [ -n "$patterns" ]; do
      case $patterns in
        [[:space:]]*)
          patterns=${patterns#[[:space:]]}
          ;;
        *)
          pattern=${patterns%%[[:space:]]*}
          patterns=${patterns#"$pattern"}
          case $pattern in
            '#'*)
              expand_preset
              ;;
            */*)
              [ -n "$opt_tree" ] && callback=print_tree || callback=print_toolname_in_tree
              case $pattern in
                *"**"*)
                  llmcu_for_config_item "tooltree/" expand_2asterisk_glob "$callback" "$pattern"
                  ;;
                *)
                  llmcu_match_config_item "tooltree/$pattern" "$callback"
                  ;;
              esac
              ;;
            *)
              llmcu_match_config_item "tools/$pattern" print_toolname
              ;;
          esac
          ;;
      esac
    done
  done | sort -u
}

expand_toolspec "$@"

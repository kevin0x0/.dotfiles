#!/bin/sh

instance=$1
case $instance in
  -*|'')
    instance=default
    ;;
  *)
    shift
    ;;
esac


opt_api_key=

. llm-config-utils

llm_scriptname=llm-responses-api-configured
llmcu_source_configfile "@instances/$instance" || exit

llmcu_eval_api_key || exit

trap ':' INT
llm-responses-api -u "$opt_responses_base_url" -m "$opt_model" -FNk 3 "$@" 3<<EOF
$opt_api_key
EOF

#!/bin/sh

usage() {
  cat <<'EOF'
usage: llm-chat-manage-tool [-d <statedir>] <subcommand> [<options>] [<args>]

Manage tools in a session or explore available tools.

subcommands:
  enable    [<glob pattern>...]
  disable   [<glob pattern>...]
  describe  [<glob pattern>...]
  list      [-esic] [-Esic] [<glob pattern>...]
  doc       <tool> [<doc path>...]
  listdoc   <tool> [<glob pattern>...]

options:
  -d <statedir>  session state directory
  -j             print results as a single JSON object
  -h             print this help
EOF
}

opt_state_dir=
opt_json=
while getopts "d:hj" opt; do
  case $opt in
    d) opt_state_dir=$OPTARG ;;
    h) usage; exit 0 ;;
    j) opt_json=1 ;;
    \?) exit 2 ;;
  esac
done
shift "$((OPTIND - 1))"
[ "$#" -ne 0 ] || { usage >&2; exit 2; }
subcommand=$1
shift

case $subcommand in
  enable|disable|describe|list|doc|listdoc) ;;
  *)
    printf "unsupported subcommand: %s\n" "$subcommand" >&2
    usage >&2
    exit 2
    ;;
esac

validate_statedir() {
  [ -n "$opt_state_dir" ] || { printf "statedir not provided (use -d)\n" >&2; return 2; }
  [ -d "$opt_state_dir" ] || { printf "'%s' is not a directory\n" "$opt_state_dir" >&2; return 2; }
}

validate_toolname() {
  case $1 in
    *[![:alnum:]_-]*|'')
      printf "invalid tool name: %s\n" "$1" >&2
      return 2
      ;;
  esac
}

validate_globpattern() {
  for pattern; do
    case $pattern in
      */.*|.*)
        printf "invalid glob pattern: %s\n" "$pattern" >&2
        return 2
        ;;
    esac
  done
}

validate_docpath() {
  for docpath; do
    case $docpath in
      ..|*/../*|*/..|../*)
        printf "invalid document path: %s\n" "$docpath" >&2
        return 2
        ;;
    esac
  done
}

sub_operate_tool_list() {
  validate_statedir || return
  action=$1
  shift
  [ "$1" = "--" ] && shift
  validate_globpattern "$@" || return

  . llm-chat-common
  llmcc_set_public_files_var "$opt_state_dir"

  set -o pipefail
  {
    llm-chat-manage-hook -d "$opt_state_dir" \
      create builtin.state.agent-loop-tool-call.leave \
      -c generate_tool_list >/dev/null || exit 1

    if ! llmcc_operate_extra_tool -pm "$action" -- "$@"; then
      printf "failed to %s extra tool\n" "$action" >&2
      exit 1
    fi
  } | {
    case $action in
      add)    key=added_tools ;;
      remove) key=removed_tools ;;
    esac
    if [ -n "$opt_json" ]; then
      jq -Rcn --arg key "$key" -- '
      {
        $key:[inputs]
      } | .count = (.[$key] | length)'
    else
      cat
    fi
  }
}

sub_describe() {
  OPTIND=1
  opt_describe_all_match=
  while getopts "a" opt; do
    case $opt in
      a) opt_describe_all_match=1 ;;
      \?) exit 2 ;;
    esac
  done
  shift "$((OPTIND - 1))"

  validate_globpattern "$@"
  if [ -z "$opt_describe_all_match" ]; then
    validate_statedir || return 2
    . llm-chat-common
    llmcc_set_public_files_var "$opt_state_dir"
    llmcc_get_tool_state_dir my_state_dir manage_tools || return
    described=$my_state_dir/described
  fi

  filter() {
    [ -n "$opt_describe_all_match" ] && { cat; return; }
    not_in() {
      [ -f "$1" ] || { cat; return; }
      comm -23 -- - "$1"
    }
    in_extra() {
      [ -f "$llmcc_extra_tool_name_list" ] || { cat >/dev/null; return; }
      comm -12 -- - "$llmcc_extra_tool_name_list"
    }
    [ ! -f "$described" ] && : >"$described"
    in_extra \
      | not_in "$described" \
      | tee -- "$my_state_dir/tmp"
    sort -o "$described" -- "$my_state_dir/tmp" "$described"
    rm -f -- "$my_state_dir/tmp"
  }

  llm-expand-toolspec -- "$@" \
    | filter \
    | tr '\n' '\000' \
    | xargs -r0 -- llm-tool-list -- \
    | jq -sc '{described:length,tools:.}'
}

list_with_summary() {
  cat_summary() {
    [ -f "$1" ] && cat -- "$1"
  }
  . llm-config-utils
  while IFS= read -r toolspec; do
    printf "%s\n" "$toolspec"
    case $toolspec in
      */)
        llmcu_for_config_item "tooltree/$toolspec/.summary" cat_summary
        ;;
      *)
        name=${toolspec##*/}
        llmcu_for_config_item "tools/$name/summary" cat_summary
        ;;
    esac
    printf "\0"
  done
}

sub_list() {
  OPTIND=1
  opt_list_enabled=
  opt_with_summary=
  opt_ignore_extralist=
  opt_start_index=
  opt_count=
  while getopts "esEi:c:" opt; do
    case $opt in
      e) opt_list_enabled=1 ;;
      s) opt_with_summary=1 ;;
      E) opt_ignore_extralist=1 ;;
      i) opt_start_index=$OPTARG ;;
      c) opt_count=$OPTARG ;;
      \?) exit 2 ;;
    esac
  done
  shift "$((OPTIND - 1))"

  if [ -n "$opt_list_enabled" ]; then
    [ "$#" -eq 0 ] || { printf "too many arguments\n" >&2; return 2; }
    validate_statedir || return
    . llm-chat-common
    llmcc_set_public_files_var "$opt_state_dir"
  else
    validate_globpattern "$@" || return
    if [ -z "$opt_ignore_extralist" ]; then
      validate_statedir || return
      . llm-chat-common
      llmcc_set_public_files_var "$opt_state_dir"
    fi
  fi

  if [ -n "$opt_list_enabled" ]; then
    set --
    for f in  "$llmcc_extra_tool_name_list" "$llmcc_default_tool_name_list"; do
      [ -f "$f" ] || continue
      set -- "$@" "$f"
    done
    [ "$#" -ne 0 ] && sort -- "$@"
  else
    [ "$#" -eq 0 ] && set -- '*'
    llm-expand-toolspec -t -- "$@" | {
      if [ -n "$opt_ignore_extralist" ]; then
        cat
      elif [ ! -f "$llmcc_extra_tool_name_list" ]; then
        cat >/dev/null
      else
        jq -Rr --rawfile extralist "$llmcc_extra_tool_name_list" -- '
        (reduce ($extralist | split("\n")[] | select(. != ""))
          as $name ({}; .[$name] = true)) as $extra |
          select(endswith("/") or $extra[.[(rindex("/") // -1) + 1:]])
        '
      fi
    }
  fi | {
    if [ -z "$opt_with_summary" ]; then
      tr '\n' '\000'
    else
      list_with_summary
    fi
  } | {
    [ -z "$opt_start_index" ] && opt_start_index=0
    [ -z "$opt_count" ] && opt_count=-1
    jq -Rsc \
      --arg list_enabled "$opt_list_enabled" \
      --arg with_summary "$opt_with_summary" \
      --argjson start_index "$opt_start_index" \
      --argjson count "$opt_count" '
      [
        split("\u0000")[] | select(. != "") | index("\n") as $i | {
          (if .[:$i] | contains("/") then "path" else "name" end):.[:$i],
        } + (if $with_summary != "" then { summary:.[$i+1:]} else {} end)
      ] | (
          if $count == -1 then
            length else
            $count + $start_index
          end
        ) as $end_index | {
        list:.[$start_index:$end_index],
        total:length,
        start_index:$start_index,
        count:$end_index - $start_index
      }
      '
  } | {
    if [ -n "$opt_json" ]; then
      cat
    else
      jq -r \
        --arg with_summary "$opt_with_summary" '
        (
          .list[] | .path // .name,
          if $with_summary != "" then .summary else empty end
        ),
        "total: " + (.total | tostring),
        "start_index: " + (.start_index | tostring),
        "count: " + (.count | tostring)
        '
    fi
  }
}

sub_doc() {
  # Currently no option supported
  [ "$1" = "--" ] && shift
  name=$1
  shift
  validate_toolname "$name" || return
  [ "$#" -eq 0 ] && set -- "README.md"
  validate_docpath "$@" || return

  . llm-config-utils
  cat_doc() {
    if [ -f "$1" ]; then
      if [ -n "$opt_json" ]; then
        jq -Rsc \
          --arg path "$docpath" -- \
          '{docpath:$path,content:.}' "$1"
      else
        printf "%s:%s\n" "$name" "$docpath"
        cat -- "$1"
      fi
      return 0
    fi
    return 1
  }
  for docpath; do
    llmcu_for_config_item "tools/$name/doc/$docpath" cat_doc
  done \
    | if [ -n "$opt_json" ]; then
        jq -s --arg name "$name" '{toolname:$name,docs:.}'
      else
        cat
      fi
}

sub_listdoc() {
  # Currently no option supported
  [ "$1" = "--" ] && shift
  [ "$#" -eq 0 ] && { printf "missing tool name\n" >&2; return 2; }
  name=$1
  shift
  validate_toolname "$name" || return
  validate_globpattern "$@" || return

  . llm-config-utils

  case $# in
    0)
      print_all() {
        find "$1/." ! -name . -exec sh -c '
          prefix="$1"
          shift
          for f; do
            [ -d "$f" ] && f=${f%/}/
            printf "%s\n" "${f#"$prefix"}"
          done
        ' sh "$1/./" {} +
      }
      llmcu_for_config_item "tools/$name/doc/" print_all
      ;;
    *)
      validate_globpattern "$@" || return
      print_docs() {
        [ -d "$1" ] && set -- "${1%/}/"
        printf "%s\n" "${1#"$llmcu_dir/tools/$name/doc/"}"
        return 1
      }
      for globpattern; do
        llmcu_match_config_item "tools/$name/doc/$globpattern" print_docs
      done
    ;;
  esac | sort -u | {
    if [ -n "$opt_json" ]; then
      jq --arg name "$name" -Rcn '{toolname:$name, doclist:[inputs]}'
    else
      cat -u
    fi
  }
}

case $subcommand in
  enable)   sub_operate_tool_list add "$@" ;;
  disable)  sub_operate_tool_list remove "$@" ;;
  describe) sub_describe "$@" ;;
  list)     sub_list "$@" ;;
  doc)      sub_doc "$@" ;;
  listdoc)  sub_listdoc "$@" ;;
esac

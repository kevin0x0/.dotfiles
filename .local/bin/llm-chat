#!/bin/sh

opt_reasoning=none
opt_stream=
opt_api_key=
opt_api_key_cmd=
opt_cache_key=
opt_model=
opt_responses_base_url=
opt_files_base_url=
opt_files_default_purpose=user_data
opt_default_role=user
opt_prompt=
opt_prompt_file=
opt_default_tools=
opt_extra_tools=
opt_extra_tools_defer_loading=
opt_extra_tools_defer_loading_mode=
opt_extra_tools_description='[deferred]'
opt_extra_tools_parameters=''
opt_show_conversation_on_startup=1
opt_color=auto
opt_color_ansi=
opt_repl_prompt_template='$(ansi_escape "33;1")llm> $(ansi_escape "0")'
opt_repl_reader=
opt_repl_read_wrapper=
opt_repl_reader_ignore=

opt_extra_request_args=

opt_session_conversation=
opt_session_fileids=
opt_session_writeback=

opt_state_dir=

opt_enable_hook=

llmcuopt_fromfile=
llmcuopt_fromfd=

opt_print_options=
opt_print_states=

renderer_opt_tool_output_lines=15

. llm-config-utils
. llm-render-utils
. llm-chat-common

llm_scriptname=llm-chat
[ -f "$llmcu_configdir/chat-config" ] && . -- "$llmcu_configdir/chat-config"

llm_chat_options="fFnNswSh:H:o:O:r:E:k:K:m:u:t:c:" 
while getopts "$llm_chat_options" opt; do
  case $opt in
    [oO])
      option_prefix=opt_
      [ "$opt" = O ] && option_prefix=
      llmcu_evaluate_option "$option_prefix$OPTARG"
      case $option_prefix$OPTARG in
        opt_api-key=*)      opt_api_key_cmd= ;;
        opt_api-key-cmd=*)  opt_api_key= ;;
        opt_prompt=*)       opt_prompt_file= ;;
        opt_prompt-file=*)  opt_prompt= ;;
      esac
      ;;
    n)
      llmcu_set_boolean_option llmcuopt_inverse_boolean_option
      ;;
    N)
      llmcu_set_boolean_option llmcuopt_trim_newline
      ;;
    f)
      llmcu_set_boolean_option llmcuopt_fromfile
      ;;
    F)
      llmcu_set_boolean_option llmcuopt_fromfd
      ;;
    s)
      llmcu_set_boolean_option opt_stream
      ;;
    w)
      llmcu_set_boolean_option opt_session_writeback
      ;;
    S)
      llmcu_set_boolean_option opt_show_conversation_on_startup
      ;;
    h)
      llmcu_getarg opt_session_conversation "$OPTARG"
      ;;
    H)
      llmcu_getarg opt_session_fileids "$OPTARG"
      ;;
    r)
      llmcu_getarg opt_reasoning "$OPTARG"
      ;;
    E)
      llmcu_getarg opt_api_key_cmd "$OPTARG"
      opt_api_key=
      ;;
    k)
      llmcu_getarg opt_api_key "$OPTARG"
      opt_api_key_cmd=
      ;;
    K)
      llmcu_getarg opt_cache_key "$OPTARG"
      ;;
    m)
      llmcu_getarg opt_model "$OPTARG"
      ;;
    u)
      llmcu_getarg opt_responses_base_url "$OPTARG"
      ;;
    t)
      llmcu_getarg opt_default_tools "$OPTARG"
      ;;
    c)
      # Additional config
      llmcu_source_configfile "$OPTARG"
      ;;
    \?)
      exit 2
      ;;
  esac
done

if [ -n "$opt_print_options" ]; then
  printf "%s\n" "$llm_chat_options"
  exit 0
fi

if [ -n "$opt_print_states" ]; then
  # Single source of truth for the states hooks can target
  hook_states='any-state agent-loop-api-call agent-loop-tool-call read-loop agent-loop-end end agent-loop-api-call-interrupted agent-loop-tool-call-interrupted'
  printf "%s\n" "$hook_states"
  exit 0
fi

[ -f "$llmcu_configdir/post-chat-config" ] && . -- "$llmcu_configdir/post-chat-config"

if [ -n "$opt_repl_read_wrapper" ] && [ -z "$opt_repl_reader_ignore" ]; then
  if ! command eval " $opt_repl_read_wrapper"' "$0" -o repl-reader-ignore=1 "$@"'; then
    i18n -n llm-scripts 'invalid REPL read wrapper' >&2
    exit 1
  else
    i18n -n llm-scripts 'did you forget to prefix your REPL reader wrapper command with exec?' >&2
    exit 0
  fi
fi

[ -n "$opt_repl_reader_ignore" ] && opt_repl_reader=
if [ -z "$opt_repl_reader" ] && [ -z "$opt_repl_reader_ignore" ]; then
  if command -v rlwrap >/dev/null 2>&1; then
    break_chars=$'()[]{},+=&^%$#";|\\\''
    opt_repl_reader='
    historyfile=${XDG_STATE_HOME:-$HOME/.local/state}/llm-scripts/chat/rlwrap-history
    if [ ! -f "$historyfile" ]; then
      mkdir -p -- "${historyfile%/*}"
      : >"$historyfile"
    fi
    builtin_completion=${XDG_DATA_HOME:-$HOME/.local/share}/llm-scripts/chat/completion
    if [ ! -e "$opt_state_dir/tmp.completions" ]; then
      print_cmdname() {
        set -- "${1%"${1##*[!/]}"}"
        printf "@%s\n" "${1##*/}"
        return 1
      }
      llmcu_match_config_item "commands/*" print_cmdname >"$opt_state_dir/tmp.completions"
    fi
    rlwrap -C llm-chat -H "$historyfile" -b "$break_chars" -f "$builtin_completion" -f "$opt_state_dir/tmp.completions" -ca -S "$cmdline_prompt" -- sh -c '\''IFS= read -r line && printf "%s" "$line"'\'
  fi
fi

if [ -z "$opt_repl_reader" ]; then
  opt_repl_reader='
  printf "%s" "$cmdline_prompt" >&3
  if IFS= read -r line; then
    printf "%s" "$line"
  else
    echo >&3
    exit 1
  fi'
fi

llmcu_eval_api_key

if [ -z "$opt_api_key" ]; then
  i18n -n llm-scripts 'API key not provided' >&2
  exit 1
fi

if [ -z "$opt_responses_base_url" ]; then
  i18n -n llm-scripts 'base URL not provided' >&2
  exit 1
fi

if [ -z "$opt_model" ]; then
  i18n -n llm-scripts 'model not provided' >&2
  exit 1
fi

case $opt_color in
  auto)
    [ -t 1 ] && opt_color_ansi=1 || opt_color_ansi=
    ;;
  always)
    opt_color_ansi=1
    ;;
  never)
    opt_color_ansi=
    ;;
esac

shift "$((OPTIND - 1))"

file_input() {
  is_image=
  [ "${1%%/*}" = @image ] && is_image=1
  file_detail=auto
  case ${1#*/} in
    auto*) file_detail=auto ;;
    low*)  file_detail=low ;;
    high*) file_detail=high ;;
    original*)
      if [ -n "$is_image" ]; then
        file_detail=original
      else
        i18n -n llm-scripts "detail level 'original' is only available for images, ignored" >&2
      fi
      ;;
  esac
  shift

  if [ -n "$is_image" ]; then
    mkcontent_data_opt=-u
    mkcontent_id_opt=-i
    mkcontent_url_opt=-u
  else
    mkcontent_data_opt=-D
    mkcontent_id_opt=-I
    mkcontent_url_opt=-U
  fi

  for file; do
    if ! path2uri -u -- "$file"; then
      if fileid=$(trap - INT; llm_chat_get_fileid "$opt_files_base_url" "$opt_api_key" "$opt_cache_key" "$opt_files_default_purpose" "$file" && echo x); then
        fileid=${fileid%$'\nx'}
        i18n -n llm-scripts 'file selected, file id: $1' "$fileid"
        llm-make-mcontent -e "$file_detail" "$mkcontent_id_opt" -- "$fileid" >&3
      else
        i18n -n llm-scripts 'failed to get a file id for $1, skipping' "$file" >&2
      fi
      continue
    fi

    case $file in
      data:)
        llm-make-mcontent -e "$file_detail" "$mkcontent_data_opt" -- "$file" >&3
        ;;
      *)
        llm-make-mcontent -e "$file_detail" "$mkcontent_url_opt" -- "$file" >&3
        ;;
    esac
  done
}

save_session() {
  shift

  if [ -z "$1" ]; then
    set -- "$opt_session_conversation" "$opt_session_fileids"
  fi
  if [ -z "$1" ]; then
    i18n -n llm-scripts 'please provide a filename to save as' >&2
    return 0
  fi

  if [ -z "$2" ]; then
    set -- "$1" "${1}.fileids"
  fi

  if ! cp -- "$conversation" "$1" || \
    ! cat -- "$llm_chat_persistent_fileids" "$llm_chat_volatile_fileids" >"$2"; then
  i18n -n llm-scripts 'failed to save as $1 and $2' "$1" "$2" >&2
  fi
}

dispatch_command() {
  eval 'set -- '"$1"

  need_break_word=
  case $1 in
    */fzf)
      extra_arg=$(fzf && echo x) || return 0
      extra_arg=${extra_arg%$'\nx'}
      set -- "$@" "$extra_arg"
      ;;
    */lf)
      # lf doesn't support paths containing <newline> anyway, so we just treat
      # <newline> as path terminator.
      extra_arg=$(lf -print-selection && echo x) || return 0
      extra_arg=${extra_arg%x}
      while [ -n "$extra_arg" ]; do
        set -- "$@" "${extra_arg%%$'\n'*}"
        extra_arg=${extra_arg#*$'\n'}
      done
      ;;
  esac

  cmdname=${1%%/*}
  cmdname=${cmdname#@}
  case $cmdname in
    nop)
      ;;
    break)
      input_end_action=break
      ;;
    add)
      input_end_action=add
      ;;
    cancel)
      input_end_action=cancel
      ;;
    go)
      input_end_action=go
      ;;
    retry)
      shift
      if [ -z "$last_error_state" ]; then
        i18n -n llm-scripts 'there is no need to retry since no error occurred' >&2
        return 0
      fi
      case $1 in
        agent-loop-api-call|agent-loop-tool-call)
          next_state=$1
          ;;
        *)
          next_state=$last_error_state
          ;;
      esac
      last_error_state=
      input_end_action=retry
      ;;
    drop)
      : >"$this_turn"
      ;;
    role)
      case $2 in
        developer|system|user|assistant)
          input_message_role=$2
          ;;
        *)
          i18n -n llm-scripts 'invalid role: $1' "$2" >&2
          ;;
      esac
      ;;
    text)
      shift
      for text; do
        llm-make-mcontent -t -- "$text" >&3
      done
      ;;
    file|image)
      file_input "$@"
      ;;
    save)
      save_session "$@"
      ;;
    command)
      shift
      trap ':' INT
      command -- "$@" 3>&-
      trap '' INT
      ;;
    *)
      cmdpath=
      llmcu_locate_config_item cmdpath "commands/$cmdname"
      if [ -f "$cmdpath" ]; then
        if [ -x "$cmdpath" ]; then
          shift
          (
            export conversation llm_chat_volatile_fileids llm_chat_persistent_fileids this_turn llm_chat_tool_list
            "$cmdpath" "$@"
          )
        elif [ -r "$cmdpath" ]; then
          command . -- "$cmdpath"
        fi
      else
        i18n -n llm-scripts 'unrecognized command: $1' "$cmdname" >&2
      fi
      ;;
  esac
}

update_file_id() (
  changed=$1
  unchanged=$opt_state_dir/tmp.unchanged
  new=$opt_state_dir/tmp.new
  idmap=$opt_state_dir/tmp.idmap

  jq --slurpfile changed "$changed" -- \
    'if IN(.id; $changed[].id) then empty else . end' \
    "$llm_chat_volatile_fileids" "$llm_chat_persistent_fileids" >"$unchanged"

  trap ':' INT
  {
    jq -Rsr '"opt_api_key=" + (rtrimstr("\n") | @sh)' <<EOF
$opt_api_key
EOF
    jq -sr --arg cachekey "$opt_cache_key" --arg purpose "$opt_files_default_purpose" --arg fburl "$opt_files_base_url" -- \
      'map(.filename | @sh) | range(0;length;10) as $n |
       "llm-file-manager -u " + ($fburl | @sh) + " -K " + ($cachekey | @sh) + " -p " + ($purpose | @sh) + " -FNk 0 -Ulm -- "
       + (.[$n:$n+10] | join(" ")) + " <<EOF\n$opt_api_key\nEOF"' "$changed"
  } | sh >"$new" \
    || exit
  trap '' INT

  jq -n --slurpfile new "$new" \
    'reduce (inputs | JOIN(INDEX($new[]; .filename); .; .filename; {(.[0].id): .[1].id})) as $o ({}; . + $o)' \
    <"$changed" >"$idmap"

  jq --slurpfile idmap "$idmap" \
    '$idmap[0] as $idmap |
     walk(if type == "object" and (.type == "input_image" or .type == "input_file") and $idmap[.file_id // ""] != null then .file_id = $idmap[.file_id] end)' \
    <"$conversation" >"$tmp"

  cp -- "$tmp" "$conversation"

  jq -c -- '[select(has("expires_at"))] | unique_by(.id)[]' "$unchanged" "$new" >"$llm_chat_volatile_fileids"
  jq -c -- '[select(has("expires_at") | not)] | unique_by(.id)[]' "$unchanged" "$new" >"$llm_chat_persistent_fileids"

  rm -- "$unchanged" "$new" "$idmap"
)

check_file_id() {
  [ -f "$llm_chat_volatile_fileids" ] || return 0

  changed=$opt_state_dir/tmp.changed
  jq 'if .expires_at < now + 300 then . else empty end' \
    <"$llm_chat_volatile_fileids" >"$changed"

  [ ! -s "$changed" ] && return 0

  i18n -n llm-scripts 'some files soon expire, updating them'
  update_file_id "$changed"
}

call() (
  if ! check_file_id; then
    errmsg="some file ids expired and failed to retrieve a new one"
    jq -n --arg err "$errmsg" >"$response_output" \
      '{"error":{"message":$err,"type":"__defined_by_me","code":"__defined_by_me"}}'
    exit 1
  fi

  [ -s "$llm_chat_tool_list" ] && set -- "$@" -T "$llm_chat_tool_list"

  cat -- "$conversation" "$this_turn" >"$response_input_fifo" &
  dispatch_render_event "$render_event_fifo" <"$response_event_output_fifo" &

  trap ':' INT
  llm-responses-api -FNk 0 "$@" -- "$response_output" - <<EOF \
    >"$response_event_output_fifo"
$opt_api_key
EOF

  exitcode=$?
  while ! wait; do
    continue
  done

  exit "$exitcode"
)

call_tool() {
  set -- "$@" -i "$response_output" -- \
    "$opt_state_dir" "$opt_files_base_url" \
    "$opt_cache_key" "$opt_files_default_purpose"
  trap ':' INT
  llm-tool-call -NS llm_chat_opt_api_key=0 "$@" >"$tool_output" <<EOF
$opt_api_key
EOF
  set -- "$?"
  trap '' INT
  return "$1"
}

render_prompter() {
  case $opt_repl_prompt_template in
    *$'\n'*)
      command eval " $1"='invalid prompt> '
      ;;
    EOF)
      command eval " $1"=EOF
      ;;
    *)
      command eval " $1"$'=$(cat <<EOF\n'"$opt_repl_prompt_template"$'\nEOF\n echo x)'
      command eval " $1"='${'"$1""%\$'\nx'}"
      ;;
  esac
  return 0
}

# We call the read in a subshell so that the remembered EOF state doesn't
# propagate to the next read.
# For example, in dash, while the read detects EOF, it remembers this. It
# will exit with status 1 and not actually read anything on next read from
# the same file descriptor if the descriptor not redirected.
read_wrapper() {
  if [ -s "$cmdline_input" ]; then
    IFS= read -r "$1" <"$cmdline_input"
    tail -n +2 -- "$cmdline_input" >"$tmp"
    cp -- "$tmp" "$cmdline_input"
    return 0
  fi
  render_prompter cmdline_prompt # used in $opt_repl_reader
  command eval " $1"='$(trap - INT; '"$opt_repl_reader"')' 3>&1
}

read_loop() {
  input_end_action=
  input_message_role=${opt_default_role:-user}
  : >"$text_input"
  need_break_word=
  while read_wrapper line; do
    case $line in
      '')
        need_break_word=
        printf "\n" >>"$text_input"
        ;;
      [!@]*|@@*)
        line=${line#@}
        if [ -n "$need_break_word" ]; then
          case $line in
            [[:alnum:]]*) line=" $line" ;;
          esac
        fi
        case $line in
          *[[:alnum:]]) need_break_word=1 ;;
          *)            need_break_word= ;;
        esac
        printf "%s" "$line" >>"$text_input"
        ;;
      *)
        [ -s "$text_input" ] && llm-make-mcontent -t <"$text_input" >&3
        : >"$text_input"

        dispatch_command "$line"
        [ -n "$input_end_action" ] && break
        ;;
    esac
  done

  [ -s "$text_input" ] && llm-make-mcontent -t <"$text_input" >&3
} 3>"$input_content"

run_hooks() {
  [ -z "$opt_enable_hook" ] && return 0
  for hooked_state in any-state "$state"; do
    [ -d "$llm_chat_hooks_dir/$hooked_state" ] || continue
    for hook_type in oneshot always; do
      if [ -e "$llm_chat_hooks_dir/$hooked_state/$hook_type/$1" ]; then
        for hook_script in "$llm_chat_hooks_dir/$hooked_state/$hook_type/$1"/*; do
          [ -f "$hook_script" ] || continue
          (trap - INT; . -- "$hook_script")
        done
        if [ "$hook_type" = oneshot ]; then
          rm -rf -- "$llm_chat_hooks_dir/$hooked_state/$hook_type/$1"
        fi
      fi
    done
    # Clean empty directories
    find "$llm_chat_hooks_dir/$hooked_state" -depth -type d -exec rmdir {} \; 2>/dev/null
  done
}

generate_tool_list() {
  llm-expand-toolspec -- "$opt_default_tools" >"$llm_chat_default_tool_name_list"
  if [ -z "$opt_extra_tools_defer_loading" ]; then
    llm_chat_generate_tool_list
    return
  fi
  llm_chat_operate_extra_tool -m add -- "$opt_extra_tools"
  case ${opt_extra_tools_defer_loading_mode:-inject} in
    builtin)
      llm_chat_generate_tool_list -l
      ;;
    inject)
      llm_chat_generate_tool_list -l \
        -d "$opt_extra_tools_description" \
        -p "$opt_extra_tools_parameters"
      ;;
    *)
      printf "invalid value of opt_extra_tools_defer_loading_mode: %s\n" \
        "$opt_extra_tools_defer_loading_mode" >&2
      exit 2
      ;;
  esac
}

create_state_dir() {
  dirprefix=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/llm-chat-$$
  dir=$dirprefix
  i=0
  while ! mkdir -- "$dir" >/dev/null 2>&1; do
    dir=$dirprefix.$i
    i=$((i + 1))
    if [ "$i" -gt 30 ]; then
      i18n -n llm-scripts 'failed to create state directory' >&2
      return 1
    fi
  done
  opt_state_dir=$dir
}

state_init() {
  : >"$conversation"
  : >"$llm_chat_volatile_fileids"
  : >"$llm_chat_persistent_fileids"
  : >"$this_turn"
  : >"$response_output"
  : >"$tool_output"
  : >"$input_content"
  : >"$text_input"
  : >"$tmp"

  if [ -n "$opt_prompt" ]; then
    llm-make-message -r system -tE "$opt_prompt" >"$conversation"
  fi

  if [ -n "$opt_prompt_file" ]; then
    llm-make-message -r system -ftE "$opt_prompt_file" >"$conversation"
  fi
}

state_init_from_session() {
  : >"$this_turn"
  : >"$response_output"
  : >"$tool_output"
  : >"$input_content"
  : >"$text_input"
  : >"$tmp"

  [ -z "$opt_session_fileids" ] && opt_session_fileids=${opt_session_conversation}.fileids
  for f in "$opt_session_conversation" "$opt_session_fileids"; do
    if [ ! -f "$f" ] || [ ! -r "$f" ]; then
      i18n -n llm-scripts '$1 does not exist or is not a readable file' "$f" >&2
      exit 1
    fi
  done
  cp -- "$opt_session_conversation" "$conversation"

  if ! jq -c -- '[select(has("expires_at"))] | unique_by(.id)[]' "$opt_session_fileids" >"$llm_chat_volatile_fileids" ||
    ! jq -c -- '[select(has("expires_at") | not)] | unique_by(.id)[]' "$opt_session_fileids" >"$llm_chat_persistent_fileids"; then
    i18n -n llm-scripts 'failed to extract file ids from $1' "$opt_session_fileids" >&2
    exit 1
  fi
}

cleanup() {
  [ -n "$rm_dir_on_exit" ] && rm -rf -- "$rm_dir_on_exit"
  if [ "$1" ]; then
    trap - "$1"
    kill -"$1" "$$"
  fi
}

trap 'cleanup' EXIT
trap 'cleanup QUIT' QUIT
trap 'cleanup TERM' TERM
trap '' INT

rm_dir_on_exit=
if [ -z "$opt_state_dir" ]; then
  create_state_dir || exit
  rm_dir_on_exit=$opt_state_dir
else
  mkdir -p -- "$opt_state_dir" || exit
fi
conversation=$opt_state_dir/conversation
this_turn=$opt_state_dir/this-turn
response_output=$opt_state_dir/response-output
tool_output=$opt_state_dir/tool-output
input_content=$opt_state_dir/input-content
text_input=$opt_state_dir/text-input
cmdline_input=$opt_state_dir/cmdline-input
render_event_fifo=$opt_state_dir/render-event-fifo
response_input_fifo=$opt_state_dir/response-input-fifo
response_event_output_fifo=$opt_state_dir/response-output-fifo
tmp=$opt_state_dir/tmp
# Set:
# llm_chat_volatile_fileids
# llm_chat_persistent_fileids
# llm_chat_tool_list
# llm_chat_default_tool_name_list
# llm_chat_extra_tool_name_list
# llm_chat_hooks_dir
llm_chat_set_public_files_var "$opt_state_dir"
generate_tool_list
[ "$#" -ne 0 ] && printf "%s\n" "$@" >"$cmdline_input"
mkfifo -- "$render_event_fifo" || exit
mkfifo -- "$response_input_fifo" || exit
mkfifo -- "$response_event_output_fifo" || exit

if [ -n "$opt_session_conversation" ] && [ -f "$opt_session_conversation" ]; then
  state_init_from_session
  if [ -n "$opt_show_conversation_on_startup" ]; then
    llm-render-events "$conversation" | dispatch_render_event "$render_event_fifo"
  fi
else
  state_init
fi


set -- \
  -u "$opt_responses_base_url" \
  -i "$response_input_fifo" \
  -r "$opt_reasoning" \
  -m "$opt_model"
[ -n "$opt_stream" ] && set -- "$@" -s
[ -n "$opt_extra_request_args" ] && set -- "$@" -A "$opt_extra_request_args"

# REPL
error_to() {
  last_error_state=$state
  next_state=$1
}

last_error_state=
state=read-loop
next_state=read-loop
while :; do
  run_hooks before
  case $state in
    read-loop)
      read_loop
      if [ -z "$input_end_action" ]; then
        if [ -s "$input_content" ] || [ -s "$this_turn" ]; then
          input_end_action=go
        else
          input_end_action=break
        fi
      fi

      case $input_end_action in
        retry|cancel)
          ;;
        break)
          next_state=end
          ;;
        *)
          if [ "$input_end_action" = go ] && [ -s "$input_content" ] || [ "$input_end_action" = add ]; then
            llm-make-message -r "$input_message_role" -p <"$input_content" \
              | tee -a "$this_turn" | llm-render-events | dispatch_render_event "$render_event_fifo"
          fi
          [ "$input_end_action" = go ] && next_state=agent-loop-api-call
          ;;
      esac
      ;;
    agent-loop-api-call)
      call "$@"
      exitcode=$?
      case $exitcode in
        0) # Append to input
          if [ -s "$response_output" ]; then
            llm-o2i "$response_output" >>"$this_turn"
            next_state=agent-loop-tool-call
          else
            i18n -n llm-scripts \
              'The API call exit code is 0, but the returned response output is empty.' >&2
            error_to read-loop
          fi
          ;;
        5)
          llm-o2i "$response_output" >>"$this_turn"
          next_state=agent-loop-api-call-interrupted
          ;;
        3) # response.incomplete
          echo
          if incomplete_reason=$(jq -jn 'limit(1; inputs) | .reason' "$response_output" 2>/dev/null); then
            case $incomplete_reason in
              max_output_tokens|steered)
                # Skip the first item
                jq -c -- 'inputs' "$response_output" >"$tmp"
                cp -- "$tmp" "$response_output"
                llm-o2i "$response_output" >>"$this_turn"
                next_state=agent-loop-tool-call
                ;;
              *)
                i18n -n llm-scripts 'response incomplete: $1' "$incomplete_reason" >&2
                error_to read-loop
                ;;
            esac
          else
            i18n -n llm-scripts 'response incomplete but no reason given' >&2
            error_to read-loop
          fi
          ;;
        *)
          [ -s "$response_output" ] && jq -n 'limit(1; inputs)' "$response_output" >&2
          error_to read-loop
          ;;
      esac
      ;;
    agent-loop-tool-call)
      call_tool
      exitcode=$?
      case $exitcode in
        0)
          cat -- "$tool_output" >>"$this_turn"
          [ -s "$tool_output" ] && next_state=agent-loop-api-call || next_state=agent-loop-end
          ;;
        5)
          cat -- "$tool_output" >>"$this_turn"
          next_state=agent-loop-tool-call-interrupted
          ;;
        *)
          i18n -n llm-scripts 'failed to handle tool call' >&2
          error_to read-loop
          ;;
      esac
      llm-render-events <"$tool_output" | dispatch_render_event "$render_event_fifo"
      ;;
    agent-loop-api-call-interrupted)
      i18n -n llm-scripts 'interrupted' >&2
      if ! call_tool -I; then
        i18n -n llm-scripts 'failed to handle tool call' >&2
        error_to read-loop
      else
        cat -- "$tool_output" >>"$this_turn"
        next_state=read-loop
      fi
      ;;
    agent-loop-tool-call-interrupted)
      i18n -n llm-scripts 'interrupted' >&2
      next_state=read-loop
      ;;
    agent-loop-end)
      cat -- "$this_turn" >>"$conversation"
      : >"$this_turn"
      next_state=read-loop
      ;;
    end)
      if [ -n "$opt_session_writeback" ]; then
        save_session "@save" "$opt_session_conversation" "$opt_session_fileids"
      fi
      break
      ;;
    *)
      i18n -n llm-scripts 'unknown state: $1' "$state" >&2
      next_state=read-loop
      ;;
  esac
  run_hooks after
  state=$next_state
done

#!/bin/sh

unset opt_api_key opt_api_key_cmd

opt_reasoning=none
opt_stream=
opt_api_key=
opt_api_key_cmd=
opt_cache_key=
opt_model=
opt_responses_base_url=
opt_files_base_url=
opt_files_default_purpose=user_data
opt_default_role=user
opt_prompt=
opt_prompt_file=
opt_default_tools=
opt_extra_tools=
opt_extra_tools_defer_loading=
opt_extra_tools_defer_loading_mode=
opt_extra_tools_description='[deferred]'
opt_extra_tools_parameters=''
opt_show_conversation_on_startup=1
opt_color=auto
opt_repl_prompt_template='$(llmru_ansi_escape "33;1")llm> $(llmru_ansi_escape "0")'
opt_repl_reader=
opt_repl_read_wrapper=
opt_repl_reader_ignore=

opt_extra_request_args=

opt_session=
opt_session_writeback=
opt_use_session_option=1
opt_session_save_options='
opt_files_base_url
opt_files_default_purpose
opt_cache_key
opt_responses_base_url
opt_model
opt_extra_tools_defer_loading
opt_extra_tools_defer_loading_mode
opt_extra_tools_description
opt_extra_tools_parameters
opt_extra_request_args
opt_session_save_options
opt_reasoning
'

opt_state_dir=

llmcuopt_fromfile=
llmcuopt_fromfd=

opt_print_options=

renderer_opt_tool_output_lines=15

. llm-config-utils
. llm-render-utils
. llm-chat-common
. llm-chat-hook-funcs

llm_scriptname=llm-chat
[ -f "$llmcu_configdir/chat-config" ] && . -- "$llmcu_configdir/chat-config"

llm_chat_options="fFnNswSh:o:O:r:E:k:K:m:u:t:c:" 
while getopts "$llm_chat_options" opt; do
  case $opt in
    [oO])
      option_prefix=opt_
      [ "$opt" = O ] && option_prefix=
      llmcu_evaluate_option "$option_prefix$OPTARG"
      case $option_prefix$OPTARG in
        opt_api-key=*)      opt_api_key_cmd= ;;
        opt_api-key-cmd=*)  opt_api_key= ;;
        opt_prompt=*)       opt_prompt_file= ;;
        opt_prompt-file=*)  opt_prompt= ;;
      esac
      ;;
    n)
      llmcu_set_boolean_option llmcuopt_inverse_boolean_option
      ;;
    N)
      llmcu_set_boolean_option llmcuopt_trim_newline
      ;;
    f)
      llmcu_set_boolean_option llmcuopt_fromfile
      ;;
    F)
      llmcu_set_boolean_option llmcuopt_fromfd
      ;;
    s)
      llmcu_set_boolean_option opt_stream
      ;;
    w)
      llmcu_set_boolean_option opt_session_writeback
      ;;
    S)
      llmcu_set_boolean_option opt_show_conversation_on_startup
      ;;
    h)
      llmcu_getarg opt_session "$OPTARG"
      ;;
    r)
      llmcu_getarg opt_reasoning "$OPTARG"
      ;;
    E)
      llmcu_getarg opt_api_key_cmd "$OPTARG"
      opt_api_key=
      ;;
    k)
      llmcu_getarg opt_api_key "$OPTARG"
      opt_api_key_cmd=
      ;;
    K)
      llmcu_getarg opt_cache_key "$OPTARG"
      ;;
    m)
      llmcu_getarg opt_model "$OPTARG"
      ;;
    u)
      llmcu_getarg opt_responses_base_url "$OPTARG"
      ;;
    t)
      llmcu_getarg opt_default_tools "$OPTARG"
      ;;
    c)
      # Additional config
      llmcu_source_configfile "$OPTARG"
      ;;
    \?)
      exit 2
      ;;
  esac
done

if [ -n "$opt_print_options" ]; then
  printf "%s\n" "$llm_chat_options"
  exit 0
fi

[ -f "$llmcu_configdir/post-chat-config" ] && . -- "$llmcu_configdir/post-chat-config"

if [ -n "$opt_repl_read_wrapper" ] && [ -z "$opt_repl_reader_ignore" ]; then
  if ! command eval " $opt_repl_read_wrapper"' "$0" -o repl-reader-ignore=1 "$@"'; then
    i18n -n llm-scripts 'invalid REPL read wrapper' >&2
    exit 1
  else
    i18n -n llm-scripts 'did you forget to prefix your REPL reader wrapper command with exec?' >&2
    exit 0
  fi
fi

[ -n "$opt_repl_reader_ignore" ] && opt_repl_reader=
if [ -z "$opt_repl_reader" ] && [ -z "$opt_repl_reader_ignore" ]; then
  if command -v rlwrap >/dev/null 2>&1; then
    break_chars=$'()[]{},+=&^%$#";|\\\''
    opt_repl_reader='
    historyfile=${XDG_STATE_HOME:-$HOME/.local/state}/llm-scripts/chat/rlwrap-history
    if [ ! -f "$historyfile" ]; then
      mkdir -p -- "${historyfile%/*}"
      : >"$historyfile"
    fi
    builtin_completion=${XDG_DATA_HOME:-$HOME/.local/share}/llm-scripts/chat/completion
    if [ ! -e "$opt_state_dir/tmp.completions" ]; then
      print_cmdname() {
        set -- "${1%"${1##*[!/]}"}"
        printf "@%s\n" "${1##*/}"
        return 1
      }
      llmcu_match_config_item "commands/*" print_cmdname >"$opt_state_dir/tmp.completions"
    fi
    rlwrap -C llm-chat -H "$historyfile" -b "$break_chars" -f "$builtin_completion" -f "$opt_state_dir/tmp.completions" -ca -S "$cmdline_prompt" -- sh -c '\''IFS= read -r line && printf "%s" "$line"'\'
  fi
fi

if [ -z "$opt_repl_reader" ]; then
  opt_repl_reader='
  printf "%s" "$cmdline_prompt" >&3
  if IFS= read -r line; then
    printf "%s" "$line"
  else
    echo >&3
    exit 1
  fi'
fi

llm_chat_color_ansi=
case $opt_color in
  auto)
    [ -t 1 ] && llm_chat_color_ansi=1 || llm_chat_color_ansi=
    ;;
  always)
    llm_chat_color_ansi=1
    ;;
  never)
    llm_chat_color_ansi=
    ;;
esac
llmru_opt_color_ansi=$llm_chat_color_ansi

shift "$((OPTIND - 1))"

check_required_options() {
  if [ -z "$opt_api_key" ]; then
    i18n -n llm-scripts 'API key not provided' >&2
    exit 1
  fi

  if [ -z "$opt_responses_base_url" ]; then
    i18n -n llm-scripts 'base URL not provided' >&2
    exit 1
  fi

  if [ -z "$opt_model" ]; then
    i18n -n llm-scripts 'model not provided' >&2
    exit 1
  fi
}

file_input() {
  is_image=
  [ "${1%%/*}" = @image ] && is_image=1
  file_detail=auto
  case ${1#*/} in
    auto*) file_detail=auto ;;
    low*)  file_detail=low ;;
    high*) file_detail=high ;;
    original*)
      if [ -n "$is_image" ]; then
        file_detail=original
      else
        i18n -n llm-scripts "detail level 'original' is only available for images, ignored" >&2
      fi
      ;;
  esac
  shift

  if [ -n "$is_image" ]; then
    mkcontent_data_opt=-u
    mkcontent_id_opt=-i
    mkcontent_url_opt=-u
  else
    mkcontent_data_opt=-D
    mkcontent_id_opt=-I
    mkcontent_url_opt=-U
  fi

  for file; do
    if ! path2uri -u -- "$file"; then
      if fileid=$(trap - INT; llmcc_get_fileid "$opt_files_base_url" "$opt_api_key" "$opt_cache_key" "$opt_files_default_purpose" "$file" && echo x); then
        fileid=${fileid%$'\nx'}
        i18n -n llm-scripts 'file selected, file id: $1' "$fileid"
        llm-make-mcontent -e "$file_detail" "$mkcontent_id_opt" -- "$fileid" >&3
      else
        i18n -n llm-scripts 'failed to get a file id for $1, skipping' "$file" >&2
      fi
      continue
    fi

    case $file in
      data:)
        llm-make-mcontent -e "$file_detail" "$mkcontent_data_opt" -- "$file" >&3
        ;;
      *)
        llm-make-mcontent -e "$file_detail" "$mkcontent_url_opt" -- "$file" >&3
        ;;
    esac
  done
}

save_session() {
  shift

  if [ -z "$1" ]; then
    set -- "$opt_session"
  fi

  if [ -z "$1" ]; then
    i18n -n llm-scripts 'please provide a directory to save as' >&2
    return 1
  fi

  if [ -e "$1" ]; then
    if [ "$opt_session" != "$1" ]; then
      i18n -n llm-scripts 'already exists: $1' "$1" >&2
      return 1
    else
      rm -rf -- "$1" || return
    fi
  fi
  saved_as=$1

  set --
  dump_options=$opt_session_save_options
  while [ -n "$dump_options" ]; do
    case $dump_options in
      [[:space:]]*)
        dump_options=${dump_options#?}
        ;;
      *)
        dump_option=${dump_options%%[[:space:]]*}
        dump_options=${dump_options#"$dump_option"}
        set -- "$@" "$dump_option"
        ;;
    esac
  done
  llmcc_dump_vars "$@" >"$dumped_session_option"
  cp -PR -- "$opt_state_dir" "$saved_as" || return
}

dispatch_command() {
  eval 'set -- '"$1"

  need_break_word=
  case $1 in
    */fzf)
      extra_arg=$(fzf && echo x) || return 0
      extra_arg=${extra_arg%$'\nx'}
      set -- "$@" "$extra_arg"
      ;;
    */lf)
      # lf doesn't support paths containing <newline> anyway, so we just treat
      # <newline> as path terminator.
      extra_arg=$(lf -print-selection && echo x) || return 0
      extra_arg=${extra_arg%x}
      while [ -n "$extra_arg" ]; do
        set -- "$@" "${extra_arg%%$'\n'*}"
        extra_arg=${extra_arg#*$'\n'}
      done
      ;;
  esac

  cmdname=${1%%/*}
  cmdname=${cmdname#@}
  case $cmdname in
    nop)
      ;;
    break)
      input_end_action=break
      ;;
    add)
      input_end_action=add
      ;;
    go)
      input_end_action=go
      ;;
    drop-content)
      input_end_action=drop-content
      ;;
    drop-this-turn)
      input_end_action=drop-this-turn
      ;;
    retry)
      shift
      if [ -z "$last_error_state" ]; then
        i18n -n llm-scripts 'there is no need to retry since no error occurred' >&2
        return 0
      fi
      case $1 in
        agent-loop-api-call|agent-loop-tool-call)
          llm_chat_next_state=$1
          ;;
        *)
          llm_chat_next_state=$last_error_state
          ;;
      esac
      last_error_state=
      input_end_action=retry
      ;;
    role)
      case $2 in
        developer|system|user|assistant)
          input_message_role=$2
          ;;
        *)
          i18n -n llm-scripts 'invalid role: $1' "$2" >&2
          ;;
      esac
      ;;
    text)
      shift
      for text; do
        llm-make-mcontent -t -- "$text" >&3
      done
      ;;
    file|image)
      file_input "$@"
      ;;
    save)
      save_session "$@"
      ;;
    command)
      shift
      trap ':' INT
      command -- "$@" 3>&-
      trap '' INT
      ;;
    *)
      cmdpath=
      llmcu_locate_config_item cmdpath "commands/$cmdname"
      if [ -f "$cmdpath" ]; then
        if [ -x "$cmdpath" ]; then
          shift
          (
            export llm_chat_conversation llm_chat_volatile_fileids llm_chat_persistent_fileids llm_chat_this_turn llm_chat_tool_list
            "$cmdpath" "$@"
          )
        elif [ -r "$cmdpath" ]; then
          command . -- "$cmdpath"
        fi
      else
        i18n -n llm-scripts 'unrecognized command: $1' "$cmdname" >&2
      fi
      ;;
  esac
}

update_file_id() (
  changed=$1
  unchanged=$opt_state_dir/tmp.unchanged
  new=$opt_state_dir/tmp.new
  idmap=$opt_state_dir/tmp.idmap

  jq --slurpfile changed "$changed" -- \
    'if IN(.id; $changed[].id) then empty else . end' \
    "$llm_chat_volatile_fileids" "$llm_chat_persistent_fileids" >"$unchanged"

  trap ':' INT
  {
    jq -Rsr '"opt_api_key=" + (rtrimstr("\n") | @sh)' <<EOF
$opt_api_key
EOF
    jq -sr --arg cachekey "$opt_cache_key" --arg purpose "$opt_files_default_purpose" --arg fburl "$opt_files_base_url" -- \
      'map(.filename | @sh) | range(0;length;10) as $n |
       "llm-file-manager -u " + ($fburl | @sh) + " -K " + ($cachekey | @sh) + " -p " + ($purpose | @sh) + " -FNk 0 -Ulm -- "
       + (.[$n:$n+10] | join(" ")) + " <<EOF\n$opt_api_key\nEOF"' "$changed"
  } | sh >"$new" \
    || exit
  trap '' INT

  jq -n --slurpfile new "$new" \
    'reduce (inputs | JOIN(INDEX($new[]; .filename); .; .filename; {(.[0].id): .[1].id})) as $o ({}; . + $o)' \
    <"$changed" >"$idmap"

  jq --slurpfile idmap "$idmap" \
    '$idmap[0] as $idmap |
     walk(if type == "object" and (.type == "input_image" or .type == "input_file") and $idmap[.file_id // ""] != null then .file_id = $idmap[.file_id] end)' \
    <"$llm_chat_conversation" >"$tmp"

  cp -- "$tmp" "$llm_chat_conversation"

  jq -nc -- '[inputs | select(has("expires_at"))] | unique_by(.id)[]' "$unchanged" "$new" >"$llm_chat_volatile_fileids"
  jq -nc -- '[inputs | select(has("expires_at") | not)] | unique_by(.id)[]' "$unchanged" "$new" >"$llm_chat_persistent_fileids"

  rm -- "$unchanged" "$new" "$idmap"
)

check_file_id() {
  [ -f "$llm_chat_volatile_fileids" ] || return 0

  changed=$opt_state_dir/tmp.changed
  jq 'if .expires_at < now + 300 then . else empty end' \
    <"$llm_chat_volatile_fileids" >"$changed"

  [ ! -s "$changed" ] && return 0

  i18n -n llm-scripts 'some files soon expire, updating them'
  update_file_id "$changed"
}

call() (
  if ! check_file_id; then
    errmsg="some file ids expired and failed to retrieve a new one"
    jq -n --arg err "$errmsg" >"$llm_chat_response_output" \
      '{"error":{"message":$err,"type":"__defined_by_me","code":"__defined_by_me"}}'
    exit 1
  fi

  [ -s "$llm_chat_tool_list" ] && set -- "$@" -T "$llm_chat_tool_list"

  cat -- "$llm_chat_conversation" "$llm_chat_this_turn" >"$response_input_fifo" &
  llmru_dispatch_render_event "$render_event_fifo" <"$response_event_output_fifo" &

  trap ':' INT
  llm-responses-api -FNk 0 "$@" -- "$llm_chat_response_output" - <<EOF \
    >"$response_event_output_fifo"
$opt_api_key
EOF

  exitcode=$?
  while ! wait; do
    continue
  done

  exit "$exitcode"
)

call_tool() {
  set -- "$@" -i "$llm_chat_response_output" -- \
    "$opt_state_dir" "$opt_files_base_url" \
    "$opt_cache_key" "$opt_files_default_purpose"
  trap ':' INT
  llm-tool-call -NS llm_chat_opt_api_key=0 "$@" >"$llm_chat_tool_output" <<EOF
$opt_api_key
EOF
  set -- "$?"
  trap '' INT
  return "$1"
}

render_prompter() {
  case $opt_repl_prompt_template in
    *$'\n'*)
      command eval " $1"='invalid prompt> '
      ;;
    EOF)
      command eval " $1"=EOF
      ;;
    *)
      command eval " $1"$'=$(cat <<EOF\n'"$opt_repl_prompt_template"$'\nEOF\n echo x)'
      command eval " $1"='${'"$1""%\$'\nx'}"
      ;;
  esac
  return 0
}

# We call the read in a subshell so that the remembered EOF state doesn't
# propagate to the next read.
# For example, in dash, while the read detects EOF, it remembers this. It
# will exit with status 1 and not actually read anything on next read from
# the same file descriptor if the descriptor not redirected.
read_wrapper() {
  if [ "${#pending_input}" -ne 0 ]; then
    command eval " $1=\${pending_input%%\$'\\n'*}"
    pending_input=${pending_input#*$'\n'}
    return 0
  fi
  render_prompter cmdline_prompt # used in $opt_repl_reader
  command eval " $1"='$(trap - INT; '"$opt_repl_reader"')' 3>&1
}

read_loop() {
  while :; do
    input_end_action=
    input_message_role=${opt_default_role:-user}
    : >"$text_input"
    need_break_word=
    while read_wrapper line; do
      case $line in
        '')
          need_break_word=
          printf "\n" >>"$text_input"
          ;;
        [!@]*|@@*)
          line=${line#@}
          if [ -n "$need_break_word" ]; then
            case $line in
              [[:alnum:]]*) line=" $line" ;;
            esac
          fi
          case $line in
            *[[:alnum:]]) need_break_word=1 ;;
            *)            need_break_word= ;;
          esac
          printf "%s" "$line" >>"$text_input"
          ;;
        *)
          [ -s "$text_input" ] && llm-make-mcontent -t <"$text_input" >&3
          : >"$text_input"

          dispatch_command "$line"
          [ -n "$input_end_action" ] && break
          ;;
      esac
    done 3>"$input_content"
    [ -s "$text_input" ] && llm-make-mcontent -t <"$text_input" >"$input_content"

    if [ -z "$input_end_action" ]; then
      if [ -s "$input_content" ] || [ -s "$llm_chat_this_turn" ]; then
        input_end_action=go
      else
        input_end_action=break
      fi
    fi

    case $input_end_action in
      drop-content)
        : >"$input_content"
        ;;
      drop-this-turn)
        : >"$llm_chat_this_turn"
        ;;
      break)
        llm_chat_next_state=end
        break
        ;;
      retry)
        break
        ;;
      go|add)
        if [ "$input_end_action" = go ] && [ -s "$input_content" ] || [ "$input_end_action" = add ]; then
          llm-make-message -r "$input_message_role" -p <"$input_content" \
            | tee -a "$llm_chat_this_turn" | llm-render-events | llmru_dispatch_render_event "$render_event_fifo"
        fi
        if [ "$input_end_action" = go ]; then
          llm_chat_next_state=agent-loop-api-call
          break
        fi
        ;;
    esac
  done
}

build_env_and_run_hook() {
  llm_chat_model=$opt_model

  (
    unset -v opt_api_key opt_api_key_cmd
    trap - INT
    . -- "$1"
  )
  exitcode=$?
  if [ "$exitcode" -ne 0 ]; then
    llmcc_hook_log ERROR "exited with status $exitcode"
  fi

  if [ -s "$llm_chat_hook_input" ]; then
    hook_input=
    while read -r line; do
      hook_input=$hook_input$line$'\n'
    done <"$llm_chat_hook_input"
    : >"$llm_chat_hook_input"
    pending_input=$hook_input$pending_input
  fi
}

run_hooks() {
  llmcc_run_hooks build_env_and_run_hook "$1"
}

create_state_dir() {
  dirprefix=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/llm-chat-$$
  dir=$dirprefix
  i=0
  while ! mkdir -- "$dir" >/dev/null 2>&1; do
    dir=$dirprefix.$i
    i=$((i + 1))
    if [ "$i" -gt 30 ]; then
      i18n -n llm-scripts 'failed to create state directory' >&2
      return 1
    fi
  done
  opt_state_dir=$dir
}

state_init() {
  : >"$llm_chat_conversation"
  : >"$llm_chat_volatile_fileids"
  : >"$llm_chat_persistent_fileids"
  : >"$llm_chat_this_turn"
  : >"$llm_chat_response_output"
  : >"$llm_chat_tool_output"
  : >"$input_content"
  : >"$text_input"
  : >"$tmp"

  mkfifo -- "$render_event_fifo" || exit
  mkfifo -- "$response_input_fifo" || exit
  mkfifo -- "$response_event_output_fifo" || exit

  llm-expand-toolspec -- "$opt_default_tools" >"$llm_chat_default_tool_set"
  if [ -n "$opt_extra_tools_defer_loading" ]; then
    llmcc_operate_extra_tool -m add -- "$opt_extra_tools"
  fi
  llm_chat_gen_tool_list

  if [ -n "$opt_prompt" ]; then
    llm-make-message -r system -tE "$opt_prompt" >"$llm_chat_conversation"
  fi

  if [ -n "$opt_prompt_file" ]; then
    llm-make-message -r system -ftE "$opt_prompt_file" >"$llm_chat_conversation"
  fi
}

state_init_from_session() {
  [ -d "$opt_session" ] || { i18n -n llm-scripts '$1 is not a directory' "$opt_session" >&2; return 1; }
  [ -r "$opt_session" ] || { i18n -n llm-scripts '$1 is not readable' "$opt_session" >&2; return 1; }
  [ -x "$opt_session" ] || { i18n -n llm-scripts '$1 is not executable' "$opt_session" >&2; return 1; }

  for f in "$opt_session"/* "$opt_session"/.[!.]*; do
    [ -e "$f" ] || continue
    cp -PR -- "$f" "$opt_state_dir" || return
  done

  if [ -n "$opt_use_session_option" ] && [ -f "$dumped_session_option" ]; then
    command . -- "$dumped_session_option"
  fi
  rm -f -- "$dumped_session_option"
}

set_session_vars() {
  llm_chat_conversation=$opt_state_dir/conversation
  llm_chat_this_turn=$opt_state_dir/this-turn
  llm_chat_response_output=$opt_state_dir/response-output
  llm_chat_tool_output=$opt_state_dir/tool-output
  input_content=$opt_state_dir/input-content
  text_input=$opt_state_dir/text-input
  render_event_fifo=$opt_state_dir/render-event-fifo
  response_input_fifo=$opt_state_dir/response-input-fifo
  response_event_output_fifo=$opt_state_dir/response-output-fifo
  llm_chat_response_extra_info_output=$opt_state_dir/response-extra-info-output
  dumped_session_option=$opt_state_dir/dumped-session-option
  tmp=$opt_state_dir/tmp
  llm_chat_hook_input=$opt_state_dir/hook-input

  llmcc_set_public_files_var "$opt_state_dir"
  # Symbols exposed to hooks
  llm_chat_volatile_fileids=$llmcc_volatile_fileids
  llm_chat_persistent_fileids=$llmcc_persistent_fileids
  llm_chat_tool_list=$llmcc_tool_list
  llm_chat_default_tool_set=$llmcc_default_tool_name_list
  llm_chat_extra_tool_set=$llmcc_extra_tool_name_list
}

cleanup() {
  [ -n "$rm_dir_on_exit" ] && rm -rf -- "$rm_dir_on_exit"
  if [ "$1" ]; then
    trap - "$1"
    kill -"$1" "$$"
  fi
}

trap 'cleanup' EXIT
trap 'cleanup QUIT' QUIT
trap 'cleanup TERM' TERM
trap '' INT

rm_dir_on_exit=
if [ -z "$opt_state_dir" ]; then
  create_state_dir || exit
  rm_dir_on_exit=$opt_state_dir
else
  mkdir -p -- "$opt_state_dir" || exit
fi

set_session_vars

if [ -n "$opt_session" ] && [ -e "$opt_session" ]; then
  state_init_from_session || exit
  if [ -n "$opt_show_conversation_on_startup" ]; then
    llm-render-events "$llm_chat_conversation" | llmru_dispatch_render_event "$render_event_fifo"
  fi
else
  state_init
fi

llmcu_eval_api_key
check_required_options

pending_input=
for cmdline_input; do
  pending_input=$pending_input$cmdline_input$'\n'
done

set -- \
  -u "$opt_responses_base_url" \
  -i "$response_input_fifo" \
  -I "$llm_chat_response_extra_info_output" \
  -r "$opt_reasoning" \
  -m "$opt_model"
[ -n "$opt_stream" ] && set -- "$@" -s
[ -n "$opt_extra_request_args" ] && set -- "$@" -A "$opt_extra_request_args"

# REPL
error_to() {
  last_error_state=$llm_chat_state
  llm_chat_next_state=$1
}

last_error_state=
llm_chat_state=read-loop
llm_chat_next_state=read-loop
llm_chat_prev_state=end
while :; do
  run_hooks "builtin.state.$llm_chat_state.enter"
  case $llm_chat_state in
    read-loop)
      read_loop
      ;;
    agent-loop-api-call)
      call "$@"
      exitcode=$?
      case $exitcode in
        0) # Append to input
          if [ -s "$llm_chat_response_output" ]; then
            llm-o2i "$llm_chat_response_output" >>"$llm_chat_this_turn"
            llm_chat_next_state=agent-loop-tool-call
          else
            i18n -n llm-scripts \
              'The API call exit code is 0, but the returned response output is empty.' >&2
            error_to read-loop
          fi
          ;;
        5)
          llm-o2i "$llm_chat_response_output" >>"$llm_chat_this_turn"
          llm_chat_next_state=agent-loop-api-call-interrupted
          ;;
        3) # response.incomplete
          echo
          if incomplete_reason=$(jq -jn 'limit(1; inputs) | .reason' "$llm_chat_response_output" 2>/dev/null); then
            case $incomplete_reason in
              max_output_tokens|steered)
                # Skip the first item
                jq -c -- 'inputs' "$llm_chat_response_output" >"$tmp"
                cp -- "$tmp" "$llm_chat_response_output"
                llm-o2i "$llm_chat_response_output" >>"$llm_chat_this_turn"
                llm_chat_next_state=agent-loop-tool-call
                ;;
              *)
                i18n -n llm-scripts 'response incomplete: $1' "$incomplete_reason" >&2
                error_to read-loop
                ;;
            esac
          else
            i18n -n llm-scripts 'response incomplete but no reason given' >&2
            error_to read-loop
          fi
          ;;
        *)
          [ -s "$llm_chat_response_output" ] && jq -n 'limit(1; inputs)' "$llm_chat_response_output" >&2
          error_to read-loop
          ;;
      esac
      ;;
    agent-loop-tool-call)
      call_tool
      exitcode=$?
      case $exitcode in
        0)
          cat -- "$llm_chat_tool_output" >>"$llm_chat_this_turn"
          [ -s "$llm_chat_tool_output" ] && llm_chat_next_state=agent-loop-api-call || llm_chat_next_state=agent-loop-end
          ;;
        5)
          cat -- "$llm_chat_tool_output" >>"$llm_chat_this_turn"
          llm_chat_next_state=agent-loop-tool-call-interrupted
          ;;
        *)
          i18n -n llm-scripts 'failed to handle tool call' >&2
          error_to read-loop
          ;;
      esac
      llm-render-events <"$llm_chat_tool_output" | llmru_dispatch_render_event "$render_event_fifo"
      ;;
    agent-loop-api-call-interrupted)
      i18n -n llm-scripts 'interrupted' >&2
      if ! call_tool -I; then
        i18n -n llm-scripts 'failed to handle tool call' >&2
        error_to read-loop
      else
        cat -- "$llm_chat_tool_output" >>"$llm_chat_this_turn"
        llm_chat_next_state=read-loop
      fi
      ;;
    agent-loop-tool-call-interrupted)
      i18n -n llm-scripts 'interrupted' >&2
      llm_chat_next_state=read-loop
      ;;
    agent-loop-end)
      cat -- "$llm_chat_this_turn" >>"$llm_chat_conversation"
      : >"$llm_chat_this_turn"
      llm_chat_next_state=read-loop
      ;;
    end)
      if [ -n "$opt_session_writeback" ]; then
        save_session "@save"
      fi
      break
      ;;
    *)
      i18n -n llm-scripts 'unknown state: $1' "$llm_chat_state" >&2
      llm_chat_next_state=read-loop
      ;;
  esac
  run_hooks "builtin.state.$llm_chat_state.leave"
  llm_chat_prev_state=$llm_chat_state
  llm_chat_state=$llm_chat_next_state
done

run_hooks "builtin.state.end.leave"

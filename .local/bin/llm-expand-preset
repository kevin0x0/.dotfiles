#!/bin/sh

. llm-config-utils

opt_prefix=
while getopts "p:" opt; do
  case $opt in
    p)  opt_prefix=$OPTARG ;;
    \?) exit 2 ;;
  esac
done
shift "$((OPTIND - 1))"

expand_spec() {
  added_presets=$'\n'
  while [ "$#" -ne 0 ]; do
    pattern=$1
    shift
    case $pattern in
      '#'*)
        case "$added_presets" in
          *$'\n'$pattern$'\n'*) continue ;;
        esac
        added_presets=$added_presets$pattern$'\n'

        pattern=${pattern#'#'}
        llmcu_locate_config_item preset_file "presets/$opt_prefix/$pattern" || continue
        [ -f "$preset_file" ] || continue
        while IFS= read -r line; do
          set -- "$@" "$line"
        done <"$preset_file"
        ;;
      *)
        printf "%s\n" "$pattern"
        ;;
    esac
  done
}

expand_spec "$@"

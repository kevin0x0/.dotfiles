#!/bin/sh

opt_target_is_code=
opt_source_is_code=
opt_target=
opt_source=
opt_prompt_template=
while getopts "t:s:T:S:p:" opt; do
  case $opt in
    T)
      opt_target=$OPTARG
      ;;
    t)
      opt_target_is_code=1
      opt_target=$OPTARG
      ;;
    S)
      opt_source=$OPTARG
      ;;
    s)
      opt_source_is_code=1
      opt_source=$OPTARG
      ;;
    p)
      opt_prompt_template=$OPTARG
      ;;
    \?)
      exit 2
      ;;
  esac
done
shift "$((OPTIND - 1))"

if [ -z "$opt_target" ]; then
  locale=${LC_ALL:-${LC_MESSAGES:-${LANG:-C}}}
  lang=${locale%%[.@]*}
  # Validate the language code heuristically
  case $lang in
    /*|C|POSIX)
      ;;
    *)
      opt_target=$lang
      opt_target_is_code=1
      ;;
  esac
fi

if [ -z "$opt_target" ]; then
  i18n -n llm-scripts 'target language (-t) not specified' >&2
  exit 2
fi

case $opt_target$opt_source in
  *[![:alpha:]_]*)
    i18n -n llm-scripts 'invalid language name or code' >&2
    exit 2
    ;;
esac

target_parenthetical_note=
if [ -n "$opt_target_is_code" ]; then
  case "$opt_target" in
    *_*) target_parenthetical_note="(language and territory code)" ;;
    *)   target_parenthetical_note="(language code)" ;;
  esac
fi

source_parenthetical_note=
if [ -n "$opt_source_is_code" ]; then
  case "$opt_source" in
    *_*) source_parenthetical_note="(language and territory code)" ;;
    *)   source_parenthetical_note="(language code)" ;;
  esac
fi

target_lang="$opt_target$target_parenthetical_note"
source_lang="$opt_source$source_parenthetical_note"

{
  stpl -v "source_lang=$source_lang" -v "target_lang=$target_lang" -- "$opt_prompt_template"
  if [ "$#" -eq 0 ]; then
    cat
  else
    printf "%s" "$1"
    shift
    [ "$#" -ne 0 ] && printf " %s" "$@"
  fi
} | llm-oneshot \
  -t "" \
  -c @renderers/assistant-message-only \
  -o prompt= \
  -o default-role=system

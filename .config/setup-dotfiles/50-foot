: "${XDG_CONFIG_HOME:=$HOME/.config}"
if [ "$(printf "%s" "$XDG_CONFIG_HOME/" | tr -s '/')" \
  != "$(printf "%s" ~/.config/ | tr -s '/')"  ]; then
  error_exit "XDG_CONFIG_HOME must be set to ~/.config"
fi

DIR=$XDG_CONFIG_HOME/foot/state
colorconfig=$DIR/current-colorscheme
dark_slot=$DIR/dark-slot
light_slot=$DIR/light-slot
mkdir -p -- "$DIR"

printf "initial-color-theme=dark\n" > "$colorconfig"

ln -sf -- "/dev/null" "$dark_slot"
ln -sf -- "/dev/null" "$light_slot"


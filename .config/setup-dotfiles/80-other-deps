helper_check_deps warning "the following commands are required for lf:" <<'EOF'
bash bourne-again shell
xdg-open opens a file or URL
highlight source code highlighter
EOF

helper_check_deps warning "the following commands are required for llm-* scripts:" <<'EOF'
jq command-line json processor
curl transfer a URL
EOF

if command -v jq >/dev/null 2>&1 && ! jq -n --raw-output0 --args '$ARGS.positional[]' a b >/dev/null 2>&1; then
  warning "jq in this machine doesn't support --raw-output0 and --args options"
fi

helper_check_deps warning "the following commands are required for running sway:" <<'EOF'
swaymsg sway cli
swaybg wallpaper tool
swaylock screen locker for wayland
firefox browser
i3status bar
foot terminal emulator
grim screenshot utility
slurp screen region selector
mako notification daemon
makoctl mako cli
swayimg image viewer
brightnessctl brightness control tool
xdg-user-dir XDG user directory getter
pkill kill processes by name
EOF

helper_check_any_deps warning "one of the following commands are required for running sway:" <<'EOF'
wmenu dynamic menu for wayland
fuzzel wayland app launcher and picker
EOF

return 0


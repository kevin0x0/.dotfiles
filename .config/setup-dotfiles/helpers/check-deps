helper_check_deps() (
  header_outputed=
  while read -r cmd description; do
    if ! command -v -- "$cmd" >/dev/null 2>&1; then
      if [ -z "$header_outputed" ]; then
        header_outputed=1
        "$1" "$2"
      fi
      "$1" "$cmd: $description"
    fi
  done

  [ -z "$header_outputed" ]
)


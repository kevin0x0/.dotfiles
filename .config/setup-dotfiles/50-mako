: "${XDG_CONFIG_HOME:=$HOME/.config}"
if [ "$(printf "%s" "$XDG_CONFIG_HOME/" | tr -s '/')" \
  != "$(printf "%s" ~/.config/ | tr -s '/')"  ]; then
  error_exit "XDG_CONFIG_HOME must be set to ~/.config"
fi

STATE_FILE=$XDG_CONFIG_HOME/mako/state/current-colorscheme
mkdir -p "$(dirname -- "$STATE_FILE")"
ln -sf -- /dev/null "$STATE_FILE"


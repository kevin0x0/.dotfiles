if [ "${XDG_STATE_HOME:-$HOME/.local/state}" != ~/.local/state ]; then
  error_exit "XDG_STATE_HOME must be set to ~/.local/state"
fi

STATE_FILE=${XDG_STATE_HOME:-$HOME/.local/state}/colorscheme/mako/colorscheme
mkdir -p "$(dirname -- "$STATE_FILE")"
ln -sf -- "/dev/null" "$STATE_FILE"


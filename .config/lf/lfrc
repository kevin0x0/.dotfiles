set incsearch true

map <tab> toggle
map a set hidden!
map <c-j> :{{
  toggle
  down
}}
map <c-k> :{{
  toggle
  up
}}
cmd open $run-lf-script open "$f"
map <c-o> $run-lf-script open-multi
set previewer "run-lf-script-previewer"


set filesep "////"

set promptfmt ""

set cutfmt ""
set copyfmt ""
set selectfmt ""
set visualfmt ""

set user_modefmt ""
set user_permfmt ""
set user_linkcountfmt ""
set user_userfmt ""
set user_groupfmt ""
set user_sizefmt ""
set user_modtimefmt ""
set user_linkfmt ""
set user_iovertfmt ""
set user_filterfmt ""

cmd on-init &{{
  : "${XDG_CONFIG_HOME:=$HOME/.config}"
  : "${XDG_STATE_HOME:=$HOME/.local/state}"
  colorscheme_state=$(get-config-state -cp lf/state current-colorscheme)
  filename=
  if [ -f "$colorscheme_state" ] && [ -r "$colorscheme_state" ]; then
    filename=$(cat -- "$colorscheme_state")
  fi
  if [ -n "$filename" ]; then
    filename=$(printf "%s" "$filename" | sed 's/\\/\\\\/g; s/"/\\"/g')
    case $(termcolors) in
      16777216)
        filename=16777216-$filename
        ;;
      256)
        filename=256-$filename
        ;;
      *)
        filename=none
        ;;
    esac
  else
    filename=none
  fi
  escaped_config_home=$(printf "%s" "$XDG_CONFIG_HOME" | sed 's/\\/\\\\/g; s/"/\\"/g')
  source_color="source \"$escaped_config_home/lf/colorscheme/$filename\";"
  rulerfile="$escaped_config_home/lf/ruler"

  lf --remote "send $id $source_color"
  lf --remote "send $id set rulerfile \"$rulerfile\""
}}

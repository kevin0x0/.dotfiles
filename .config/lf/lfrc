set incsearch true

map <tab> toggle
map a set hidden!
map <c-j> :{{
  toggle
  down
}}
map <c-k> :{{
  toggle
  up
}}

set filesep "////"

set promptfmt ""

set cutfmt ""
set copyfmt ""
set selectfmt ""
set visualfmt ""

set user_modefmt ""
set user_permfmt ""
set user_linkcountfmt ""
set user_userfmt ""
set user_groupfmt ""
set user_sizefmt ""
set user_modtimefmt ""
set user_linkfmt ""
set user_iovertfmt ""
set user_filterfmt ""

cmd on-init &{{
  : "${XDG_CONFIG_HOME:=$HOME/.config}"
  : "${XDG_STATE_HOME:=$HOME/.local/state}"
  COLOR_THEME_FILE=$XDG_STATE_HOME/colorscheme/lf/colorscheme
  filename=
  if [ -f "$COLOR_THEME_FILE" ] && [ -r "$COLOR_THEME_FILE" ]; then
    filename=$(cat -- "$COLOR_THEME_FILE")
  fi
  if [ -n "$filename" ]; then
    filename=$(printf "%s" "$filename" | sed 's/\\/\\\\/g; s/"/\\"/g')
    case $(termcolors) in
      16777216)
        filename=16777216-$filename
        ;;
      256)
        filename=256-$filename
        ;;
      2|none)
        filename=none
        ;;
      *)
        filename=8
        ;;
    esac
  else
    filename=none
  fi
  escaped_config_home=$(printf "%s" "$XDG_CONFIG_HOME" | sed 's/\\/\\\\/g; s/"/\\"/g')
  source_color="source \"$escaped_config_home/lf/colorscheme/$filename\";"
  rulerfile="$escaped_config_home/lf/ruler"

  lf --remote "send $id $source_color"
  lf --remote "send $id set rulerfile \"$rulerfile\""
  lf --remote "send $id cmd open \$\"$escaped_config_home/lf/scripts/open\" \"\$f\""
  lf --remote "send $id map <c-o> \$\"$escaped_config_home/lf/scripts/open-multi\""
  lf --remote "send $id set previewer \"$escaped_config_home/lf/scripts/previewer\""
}}

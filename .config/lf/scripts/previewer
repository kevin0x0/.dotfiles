#!/bin/sh

file=$1
mime_type=$(file --mime-type --brief -- "$file" </dev/null)

case "$mime_type" in
  application/yaml|\
  application/toml|\
  application/json|\
  application/mbox|\
  text/*)
    if command -v highlight >/dev/null 2>&1; then
      termcolor=$(termcolors)
      if [ "$termcolor" -eq 16777216 ]; then
        output_format=truecolor
      else
        output_format=ansi
      fi
      highlight -O "$output_format" -- "$file"
    else
      cat
    fi
    ;;
  *)
    file --brief -- "$file" | fold -sw "$2"
    ;;
esac

# background color (fallback before the image loads; invisible once the
# stretched wallpaper covers it, opaque)
{ color=#$bg }

# unlock ring —— per state (semi-transparent, over the blurred layer)
{ ring-color=#$accent$alpha_hex }
{ ring-ver-color=#$warning$alpha_hex }
{ ring-wrong-color=#$urgent$alpha_hex }
{ ring-clear-color=#$unfocused_fg$alpha_hex }

# ring inside —— semi-transparent dark layer so the indicator stays
# readable on any wallpaper
{ inside-color=#$bg$alpha_hex }
{ inside-ver-color=#$bg$alpha_hex }
{ inside-wrong-color=#$bg$alpha_hex }
{ inside-clear-color=#$bg$alpha_hex }

# line between the ring and inside uses the inside color (no extra line)
line-uses-inside

# key highlight segments (semi-transparent)
{ key-hl-color=#$indicator$alpha_hex }
{ bs-hl-color=#$urgent$alpha_hex }

# status text (semi-transparent)
{ text-color=#$fg$alpha_hex }
{ text-ver-color=#$warning$alpha_hex }
{ text-wrong-color=#$urgent$alpha_hex }
{ text-clear-color=#$unfocused_fg$alpha_hex }

# separator between highlight segments (semi-transparent)
{ separator-color=#$inactive$alpha_hex }

# vim: ft=dosini

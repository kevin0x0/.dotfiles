# Commands must not cross multiple lines via backslash line-continuing.
# Command bar shall be specified a bar id
# Commands must be available at runtime

# appearance ---------------------------------------------------------------
seat * xcursor_theme capitaine-cursors

exec_always {
  command -v gsettings && gsettings set org.gnome.desktop.interface icon-theme "Adwaita"
  command -v gsettings && gsettings set org.gnome.desktop.interface gtk-theme "{ $gtk_theme }"
  command -v gsettings && gsettings set org.gnome.desktop.interface cursor-theme "capitaine-cursors"
  command -v gsettings && gsettings set org.gnome.desktop.interface color-scheme "prefer-{ $kind }"
}

# client windows -------------------------------------------------------------
# border background text indicator child_border
client.focused          { #$accent$alpha_hex #$accent$alpha_hex #$accent_fg #$indicator #$accent$alpha_hex }
client.focused_inactive { #$inactive$alpha_hex #$inactive$alpha_hex #$inactive_fg #$inactive$alpha_hex #$inactive$alpha_hex }
client.unfocused        { #$unfocused$alpha_hex #$unfocused$alpha_hex #$unfocused_fg #$unfocused$alpha_hex #$unfocused$alpha_hex }
client.urgent           { #$urgent$alpha_hex #$urgent$alpha_hex #$urgent_fg #$urgent$alpha_hex #$urgent$alpha_hex }

# bar ------------------------------------------------------------------------
bar default {
  separator_symbol " ▌"
  icon_theme Adwaita

  colors {
    separator { #$bg }
    statusline { #$statusline }
    background { #$bg$alpha_hex }

    focused_separator { #$inactive }
    focused_statusline { #$statusline }
    focused_background { #$bg$alpha_hex }

    focused_workspace { #$accent #$accent #$bg }
    active_workspace { #$bg #$bg #$indicator }
    inactive_workspace { #$bg #$bg #$inactive_fg }
    urgent_workspace { #$warning #$warning #$bg }
    binding_mode { #$binding #$binding #$bg }
  }
}

# vim: ft=swayconfig

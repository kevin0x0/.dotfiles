theme=$COLORSCHEME_THEME_FILE_A

case $(uname -s) in
  Linux|FreeBSD|OpenBSD|NetBSD)
    ;;
  *)
    exit 0
    ;;
esac

set --
for tty in /dev/pts/*[[:digit:]]*; do
  [ -w "$tty" ] && set -- "$@" "$tty"
done

if [ "$#" -eq 0 ]; then
  exit 0
fi

# Maybe need a lock to do atomic writing
run-foot-script switch-colorscheme-on-the-fly "$theme" | tee -- "$@" >/dev/null


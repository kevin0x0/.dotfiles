
newer_than_output() {
  count=0
  while [ "$count" -lt "$#" ]; do
    count=$((count + 1))
    eval arg='${'"$count}"

    if [ -L "$arg" ]; then
      link_target=$(readlink -- "$arg" && echo x) || return 0
      link_target=${link_target%$'\nx'}
      case $link_target in
        /*)
          ;;
        *)
          link_target="${arg%/*}/$link_target"
          ;;
      esac
      set -- "$@" "$link_target"
    fi

    if [ "$count" -gt 100 ]; then
      # Too many files, may be symbolic link loop, stop and always
      # do re-generatition.
      return 0
    fi
  done
  [ "$#" -ne 0 ] && [ -n "$(find "$@" -newer "$output")" ]
}

theme=$COLORSCHEME_COLORSCHEMES_DIR/$COLORSCHEME_THEME

if [ ! -f "$theme" ]; then
  notify-or-print -en colorscheme -- \
    "$(i18n -n common "Failure")" \
    "$(i18n -n colorscheme 'The "$1" color scheme does not exist' "$COLORSCHEME_THEME")"
  exit 1
fi

notify-state -c colorscheme-generation-error

for f in "$COLORSCHEME_SPECS_DIR"/*; do
  [ -f "$f" ] || continue
  [ -r "$f" ] || continue

  target=${f##*/}
  template=$COLORSCHEME_TEMPLATES_DIR/$target
  [ -f "$template" ] || continue

  (
    . -- "$f"
    mkdir -p -- "${output%/*}"

    set -- "$theme"
    [ -n "$extra_info" ] && extra_info="$extra_info "
    while [ -n "$extra_info" ]; do
      info=${extra_info%% *}
      extra_info=${extra_info#* }
      set -- "$@" "$COLORSCHEME_EXTRA_DIR/$info"
    done

    if [ -f "$output" ]; then
      newer_than_output "$@" "$template" || exit 0
    elif [ -e "$output" ]; then
      notify-or-print -en colorscheme -- \
        "$(i18n -n common "Failure")" "$(i18n -n common '$1 is not a file' "$output")"
      notify-state colorscheme-generation-error
      exit 1
    fi

    count=$#
    while [ "$count" -ne 0 ]; do
      count=$((count - 1))
      info=$1
      shift
      set -- "$@" -s "$info"
    done

    if ! stpl "$@" -o "$output" -- "$template"; then
       notify-state colorscheme-generation-error
       exit 1
    fi
  ) &
done

while ! wait; do
  :
done

! notify-state -tc colorscheme-generation-error


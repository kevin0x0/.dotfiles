theme=$COLORSCHEME_COLORSCHEMES_DIR/$COLORSCHEME_REAL_THEME

[ -f "$theme" ] || exit 0

for f in "$COLORSCHEME_SPECS_DIR"/*; do
  [ -f "$f" ] || continue
  [ -r "$f" ] || continue

  target=${f##*/}
  template=$COLORSCHEME_TEMPLATES_DIR/$target
  [ -f "$template" ] || continue

  . -- "$f"
  mkdir -p -- "${output%/*}"

  set -- "$theme"
  extra_info="$extra_info "
  while [ -n "$extra_info" ]; do
    info=${extra_info%% *}
    extra_info=${extra_info#* }
    set -- "$@" "$COLORSCHEME_EXTRA_DIR/$info"
  done

  if [ -f "$output" ]; then
    [ -z "$(find "$@" "$template" -newer "$output")" ] && continue
  elif [ -e "$output" ]; then
    printf "%s is not a file" "$output" >&2
    exit 1
  fi

  count=$#
  while [ "$count" -ne 0 ]; do
    count=$((count - 1))
    info=$1
    shift
    set -- "$@" -s "$info"
  done

  stpl "$@" -o "$output" -- "$template" || exit 1
done


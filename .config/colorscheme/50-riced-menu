set -e

COLORSCHEME_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/riced-menu/colorscheme
COLOR_THEME_FILE=$COLORSCHEME_STATE_HOME/riced-menu/colorscheme
if [ ! -e  "$(dirname -- $COLOR_THEME_FILE)" ]; then
  if ! mkdir -p "$(dirname -- $COLOR_THEME_FILE)"; then
    echo "can not create state file for riced-menu" >&2
    exit 1
  fi
fi

theme=$1
ln -sf -- "$COLORSCHEME_DIR/$theme" "$COLOR_THEME_FILE"


COLOR_THEME_FILE=$COLORSCHEME_STATE_HOME/foot/colortheme.ini

if [ ! -r "$COLOR_THEME_FILE" ]; then
  echo "$COLOR_THEME_FILE doesn't exist" >&2
  exit 1
fi

: "${XDG_CONFIG_HOME:=$HOME/.config}"
theme=$COLORSCHEME_THEME_FILE_A
colorscheme_file="$XDG_CONFIG_HOME/foot/colorscheme/$theme"
IFS= read -r section_spec <"$colorscheme_file"

case "$section_spec" in
  *'[colors-light]'*)
    category=light
    ;;
  *'[colors-dark]'*)
    category=dark
    ;;
  *)
    echo "unknown section: $section_spec" >&2
    exit 1
    ;;
esac

slot=$COLORSCHEME_STATE_HOME/foot/${category}-slot
ln -sf -- "$colorscheme_file" "$slot"

case $category in
  dark)
    pkill -u "$(id -u)" -USR1 foot || true
    ;;
  light)
    pkill -u "$(id -u)" -USR2 foot || true
    ;;
esac

printf "initial-color-theme=%s\n" "$category" > "$COLOR_THEME_FILE"

# vim: ft=sh

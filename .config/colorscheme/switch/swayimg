COLOR_THEME_FILE=$COLORSCHEME_STATE_HOME/swayimg/colorscheme

if [ ! -e "$(dirname -- "$COLOR_THEME_FILE")" ]; then
  if ! mkdir -p "$(dirname -- "$COLOR_THEME_FILE")"; then
    notify-or-print -en colorscheme -- \
      "$(i18n -n common "Failure")" "$(i18n -n colorscheme 'can not create state file for $1' swayimg)"
    exit 1
  fi
fi

theme=$COLORSCHEME_THEME_FILE_A
printf "%s\n" "$theme" > "$COLOR_THEME_FILE"

pkill -USR1 -u "$(id -u)" swayimg || true


COLOR_THEME_FILE=$COLORSCHEME_STATE_HOME/lf/colorscheme

if [ ! -e "$(dirname -- "$COLOR_THEME_FILE")" ]; then
  if ! mkdir -p "$(dirname -- "$COLOR_THEME_FILE")"; then
    notify-or-print -en colorscheme -- \
      "$(i18n -n common "Failure")" "$(i18n -n colorscheme 'can not create state file for $1' lf)"
    exit 1
  fi
fi

theme=$COLORSCHEME_THEME_FILE
printf "%s\n" "$theme" > "$COLOR_THEME_FILE"

lf -remote 'send on-init' >/dev/null 2>&1 || true

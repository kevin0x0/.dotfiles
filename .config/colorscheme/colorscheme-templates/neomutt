# basic colors ---------------------------------------------------------
color error               { color$red_256 color$bg_256 }                       # message line error text (bright red)
color tilde               { color$accent_256 color$bg_256 }                       # vi-like tildes marking blank lines
color message             { color$accent_256 color$bg_256 }
color markers       bold  { color$red_256 color$bg_256 }                       # wrapped-line /^\+/ markers
color attachment    bold  { color$accent_256 color$bg_256 }                       # attachment headers
color search              { color$bg_256 color$accent_256 }                        # search patterns in pager
color status        bold  { color$bg_256 color$accent_256 }
color indicator     bold  { color$bg_256 color$accent_256 }                       # selected email in index
color tree          bold  { color$accent_256 color$bg_256 }                       # arrow in threads (`-->')

# basic monochrome screen
mono bold           bold
mono underline      underline
mono indicator      reverse
mono error          bold
mono header         bold                            "^(From|Subject|Date|To|Cc|Bcc):"
mono quoted         bold

# index ----------------------------------------------------------------

color index               { color$accent_256 color$bg_256 }       "~A"            # all messages
color index               { color$unfocused_fg_256 color$bg_256 }       "~E"            # expired messages
color index         bold  { color$accent_256 color$bg_256 }       "~N"            # new messages
color index               { color$unfocused_fg_256 color$bg_256 }       "~O"            # old messages
color index               { color$unfocused_fg_256 color$bg_256 }       "~R"            # read messages
color index         bold  { color$unfocused_fg_256 color$bg_256 }       "~Q"            # messages that have been replied to
color index         bold  { color$accent_256 color$bg_256 }       "~U"            # unread messages
color index         bold  { color$accent_256 color$bg_256 }       "~U~$"          # unread, unreferenced messages
color index               { color$accent_256 color$bg_256 }       "~v"            # messages part of a collapsed thread
color index               { color$unfocused_fg_256 color$bg_256 }       "~P"            # messages from me
#color index               { color$71 color$0 }        "~p!~F"        # messages to me
#color index               { color$71 color$0 }        "~N~p!~F"      # new messages to me
#color index               { color$71 color$0 }        "~U~p!~F"      # unread messages to me
#color index               { color$244 color$0 }        "~R~p!~F"      # messages to me
color index         bold  { color$magenta_256 color$bg_256 }       "~F"            # flagged messages
color index         bold  { color$magenta_256 color$bg_256 }       "~F~p"          # flagged messages to me
color index         bold  { color$magenta_256 color$bg_256 }       "~N~F"          # new flagged messages
color index         bold  { color$magenta_256 color$bg_256 }       "~N~F~p"        # new flagged messages to me
color index         bold  { color$magenta_256 color$bg_256 }       "~U~F~p"        # new flagged messages to me
color index               { color$bg_256 color$red_256 }       "!~N ~D"        # deleted messages
color index               { color$bg_256 color$red_256 }       "~N ~D"         # deleted new messages
color index               { color$unfocused_fg_256 color$bg_256 }       "~v~(!~N)"      # collapsed thread with no unread
color index               { color$accent_256 color$bg_256 }       "~v~(~N)"       # collapsed thread with some unread
color index               { color$accent_256 color$bg_256 }       "~N~v~(~N)"     # collapsed thread with unread parent
# statusbg used to indicated flagged when foreground color shows other status
# for collapsed thread
color index               { color$accent_256 color$bg_256 }       "~v~(~F)!~N"    # collapsed thread with flagged, no unread
color index               { color$accent_256 color$bg_256 }       "~v~(~F~N)"     # collapsed thread with some unread & flagged
color index               { color$accent_256 color$bg_256 }       "~N~v~(~F~N)"   # collapsed thread with unread parent & flagged
color index               { color$accent_256 color$bg_256 }       "~N~v~(~F)"     # collapsed thread with unread parent, no unread inside, but some flagged
color index               { color$accent_256 color$bg_256 }       "~v~(~p)"       # collapsed thread with unread parent, no unread inside, some to me directly
color index               { color$accent_256 color$red_256 }       "~v~(~D)"       # thread with deleted (doesn't differentiate between all or partial)
color index               { color$accent_256 color$bg_256 }       "~T"            # tagged messages
color index         bold  { color$accent_256 color$bg_256 }       "~T~F"          # tagged, flagged messages
color index         bold  { color$accent_256 color$bg_256 }       "~T~N"          # tagged, new messages
color index         bold  { color$accent_256 color$bg_256 }       "~T~U"          # tagged, unread messages

# message headers ------------------------------------------------------

color hdrdefault    bold  { color$yellow_256 color$bg_256 }
color header        bold  { color$accent_256 color$bg_256 }       "^(From|To|Cc|Bcc)"
color header        bold  { color$accent_256 color$bg_256 }       "^(Subject|Date)"

# body -----------------------------------------------------------------

color quoted              { color$accent_256 color$bg_256 }
color quoted1             { color$yellow_256 color$bg_256 }
color quoted2             { color$yellow_256 color$bg_256 }
color quoted3             { color$accent_256 color$bg_256 }
color quoted4             { color$accent_256 color$bg_256 }
color signature           { color$accent_256 color$bg_256 }                        # everything below /^--\s*$/

color bold                { color$fg_256 color$bg_256 }
color underline           { color$bg_256 color$unfocused_fg_256 }
color normal              { color$fg_256 color$bg_256 }

## pgp

color body                { color$red_256 color$bg_256 }       "(BAD signature)"
color body                { color$accent_256 color$bg_256 }       "(Good signature)"
color body                { color$bg_256 color$bg_256 }       "^gpg: Good signature .*"
color body                { color$unfocused_fg_256 color$bg_256 }       "^gpg: "
color body                { color$unfocused_fg_256 color$red_256 }       "^gpg: BAD signature from.*"
mono  body          bold                          "^gpg: Good signature"
mono  body          bold                          "^gpg: BAD signature from.*"


hex_to_256() (
  r=${1%????}
  g=${1#??}
  g=${g%??}
  b=${1#????}

  r=$((0x$r))
  g=$((0x$g))
  b=$((0x$b))

  cr=$((r <= 47 ? 0 : r <= 95 ? 1 : ((r - 35) / 40)))
  crv=$((cr == 0 ? 0 : (55 + cr * 40)))
  cg=$((g <= 47 ? 0 : g <= 95 ? 1 : ((g - 35) / 40)))
  cgv=$((cg == 0 ? 0 : (55 + cg * 40)))
  cb=$((b <= 47 ? 0 : b <= 95 ? 1 : ((b - 35) / 40)))
  cbv=$((cb == 0 ? 0 : (55 + cb * 40)))

  gl=$((((r + g + b) * 23 + 382) / 765))

  cd=$(((crv - r) * (crv - r) + (cgv - g) * (cgv - g) + (cbv - b) * (cbv - b)))

  gval=$((8 + 10 * gl))
  gd=$(((r - gval) * (r - gval) + (g - gval) * (g - gval) + (b - gval) * (b - gval)))

  printf "%u" "$((cd < gd ? (16 + 36 * cr + 6 * cg + cb) : (232 + gl)))"
)

fg_256=$(hex_to_256 "$fg")
bg_256=$(hex_to_256 "$bg")
accent_256=$(hex_to_256 "$accent")
cyan_256=$(hex_to_256 "$cyan")
green_256=$(hex_to_256 "$green")
magenta_256=$(hex_to_256 "$magenta")
red_256=$(hex_to_256 "$red")
yellow_256=$(hex_to_256 "$yellow")
surface_256=$(hex_to_256 "$surface")
unfocused_fg_256=$(hex_to_256 "$unfocused_fg")


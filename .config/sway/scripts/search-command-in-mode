#!/bin/sh

SWAY_CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/sway

if ! mode=$(swaymsg -rt get_binding_state | jq -r '.name'); then
  exit 1
fi

if ! line=$(run-sway-script generate-mode-commands -t "$mode" \
  | while read -r key command; do
      printf "%-25s %s\n" "$key" "$command"
    done \
  | menu-wrapper dmenu -vw 90 -p "search command in $mode mode"); then
  exit 1
fi

swaymsg -- "${line#*[[:space:]]}"

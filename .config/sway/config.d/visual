include \"$("${XDG_CONFIG_HOME:-$HOME/.config}/sway/scripts/get-colorscheme")\"

font pango: sans-serif, 12

titlebar_border_thickness 3
default_border pixel 3
smart_borders on

gaps inner 4

seat * hide_cursor 5000

bar default {
  font monospace, 12
  gaps 4
  position top
  tray_padding 4
  status_padding 0

  status_command sway-i3status-wrapper
}

for_window [app_id="foot"] title_format <span font="monospace">%title</span>

# vim: ft=swayconfig

include \"$("${XDG_CONFIG_HOME:-$HOME/.config}/sway/scripts/get-colorscheme")\"

set $monofont monospace
set $font Adwaita Sans

font pango: $monofont, Bold 12

titlebar_border_thickness 3
default_border pixel 3
smart_borders on

gaps inner 4

seat * hide_cursor 5000

exec_always {
  command -v gsettings && gsettings set org.gnome.desktop.interface font-name "$font"
}

bar default {
  font $monofont, Bold 12
  gaps 4
  position top
  tray_padding 4
  status_padding 0

  status_command sway-i3status-wrapper
}

# vim: ft=swayconfig

# Commands must not cross multiple lines via backslash line-continuing.
# Command bar shall be specified a bar id
# Commands must be available at runtime

# palette ----------------------------------------------------------------
set $bg           #2e3440
set $fg           #2e3440
set $accent       #88c0d0
set $indicator    #d08770
set $inactive     #4c566a
set $inactive_fg  #81a1c1
set $unfocused    #3b4252
set $unfocused_fg #4c566a
set $urgent       #bf616a
set $urgent_fg    #2e3440
set $warning      #ebcb8b
set $statusline   #d8dee9
set $binding      #b48ead

# appearance ---------------------------------------------------------------
set $gtk-theme     Materia-dark
set $color-scheme  prefer-dark
set $icon-theme    Adwaita
set $cursor-theme  capitaine-cursors

seat * xcursor_theme $cursor-theme

exec_always {
  command -v gsettings && gsettings set org.gnome.desktop.interface icon-theme "$icon-theme"
  command -v gsettings && gsettings set org.gnome.desktop.interface gtk-theme "$gtk-theme"
  command -v gsettings && gsettings set org.gnome.desktop.interface cursor-theme "$cursor-theme"
  command -v gsettings && gsettings set org.gnome.desktop.interface color-scheme "$color-scheme"
}

# client windows -------------------------------------------------------------
# border background text indicator child_border
client.focused          $accent    $accent    $fg           $indicator   $accent
client.focused_inactive $inactive  $inactive  $inactive_fg  $inactive    $inactive
client.unfocused        $unfocused $unfocused $unfocused_fg $unfocused   $unfocused
client.urgent           $urgent    $urgent    $urgent_fg    $urgent      $urgent

# bar ------------------------------------------------------------------------
bar default {
  separator_symbol " ▌"
  icon_theme $icon-theme

  colors {
    separator $bg
    statusline $statusline
    background $bg

    focused_separator $inactive
    focused_statusline $statusline
    focused_background $bg

    focused_workspace $accent $accent $bg
    active_workspace $bg $bg $indicator
    inactive_workspace $bg $bg $inactive_fg
    urgent_workspace $warning $warning $bg
    binding_mode $binding $binding $bg
  }
}

# vim: ft=swayconfig

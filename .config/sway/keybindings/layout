include common

# Fast operation
bindsym {
  $mod+b splith
  $mod+v splitv
  $mod+shift+b splith; layout tabbed
  $mod+shift+v splitv; layout stacking
  $mod+r split none

  # Make the current focus fullscreen
  $mod+f fullscreen

  # Move the current window
  $mod+Shift+$left move left 40px
  $mod+Shift+$down move down 40px
  $mod+Shift+$up move up 40px
  $mod+Shift+$right move right 40px

  # Toggle the current focus between tiling and floating mode
  $mod+Shift+space floating toggle

  # Move the currently focused window to the scratchpad
  $mod+Shift+Minus move scratchpad

  # Move focused container to workspace
  $mod+Shift+1 move container to workspace number 1
  $mod+Shift+2 move container to workspace number 2
  $mod+Shift+3 move container to workspace number 3
  $mod+Shift+4 move container to workspace number 4
  $mod+Shift+5 move container to workspace number 5
  $mod+Shift+6 move container to workspace number 6
  $mod+Shift+7 move container to workspace number 7
  $mod+Shift+8 move container to workspace number 8
  $mod+Shift+9 move container to workspace number 9
  $mod+Shift+0 move container to workspace number 10
  $mod+less move container to workspace prev; workspace prev
  $mod+greater move container to workspace next; workspace next
}

mode "layout" bindsym {
  $mod+q mode "default"
  $mod+Shift+q mode "default"
  Escape mode "default"

  $mod+t splitt; mode "default"
  $mod+e layout toggle split
  $mod+shift+e layout toggle tabbed stacking

  # Move the current window by small step for floating windows
  $mod+$left move left
  $mod+$down move down
  $mod+$up move up
  $mod+$right move right
  $mod+Shift+$left move left
  $mod+Shift+$down move down
  $mod+Shift+$up move up
  $mod+Shift+$right move right

  $mod+w exec \"${XDG_CONFIG_HOME:-$HOME/.config}/sway/scripts/move-to-workspace\"; mode "default"
  $mod+Shift+w exec \"${XDG_CONFIG_HOME:-$HOME/.config}/sway/scripts/move-to-workspace\"; mode "default"
}
bindsym $mod+Shift+w mode "layout"

# vim: ft=swayconfig


mode "mark" bindsym {
  $mod+q mode "default"
  $mod+Shift+q mode "default"
  Escape mode "default"

  $mod+m mode "mark-move"
  $mod+Shift+m mode "mark-move"

  $mod+s mode "mark-swap"
  $mod+Shift+s mode "mark-swap"

  $mod+u [con_id=__focused__] unmark; mode "default"
  $mod+Shift+u [con_id=__focused__] unmark; mode "default"
}
bindsym $mod+Shift+m mode "mark"

mode "mark-move" bindsym {
  $mod+q mode "default"
  $mod+Shift+q mode "default"
  Escape mode "default"

  Return exec run-sway-script mark-move; mode "default"
  Shift+Return exec run-sway-script mark-move; mode "default"
  $mod+Return exec run-sway-script mark-move; mode "default"
  $mod+Shift+Return exec run-sway-script mark-move; mode "default"
  $mod+i exec run-sway-script mark-move; mode "default"
  $mod+Shift+i exec run-sway-script mark-move; mode "default"
}

mode "mark-swap" bindsym {
  $mod+q mode "default"
  $mod+Shift+q mode "default"
  Escape mode "default"

  Return exec run-sway-script mark-swap; mode "default"
  Shift+Return exec run-sway-script mark-swap; mode "default"
  $mod+Return exec run-sway-script mark-swap; mode "default"
  $mod+Shift+Return exec run-sway-script mark-swap; mode "default"
  $mod+i exec run-sway-script mark-swap; mode "default"
  $mod+Shift+i exec run-sway-script mark-swap; mode "default"
}

mode "mark-jump" bindsym {
  $mod+q mode "default"
  $mod+Shift+q mode "default"
  Escape mode "default"

  Return exec run-sway-script mark-jump; mode "default"
  $mod+Return exec run-sway-script mark-jump; mode "default"
  $mod+i exec run-sway-script mark-jump; mode "default"
}
bindsym $mod+semicolon mode "mark-jump"

mode "mark-set" bindsym {
  $mod+q mode "default"
  $mod+Shift+q mode "default"
  Escape mode "default"

  Return exec run-sway-script mark-set; mode "default"
  $mod+Return exec run-sway-script mark-set; mode "default"
  $mod+i exec run-sway-script mark-set; mode "default"
}
bindsym $mod+m mode "mark-set"



# Fast start
bindsym {
  # Screen shot
  Print exec GRIM_DEFAULT_DIR="$(xdg-user-dir PICTURES)/screenshots" grim

  # Screen shot with specified region
  $mod+Print exec GRIM_DEFAULT_DIR="$(xdg-user-dir PICTURES)/screenshots" grim -g "$(slurp)"

  # Special keys to adjust volume
  --locked XF86AudioLowerVolume exec audioctl set pvolume 5%- && pkill -u "$(id -u)" -USR1 i3status
  --locked XF86AudioRaiseVolume exec audioctl set pvolume 5%+ && pkill -u "$(id -u)" -USR1 i3status
  --locked XF86AudioMute exec audioctl set pswitch toggle && pkill -u "$(id -u)" -USR1 i3status
  # bindsym --locked XF86AudioLowerVolume exec audioctl set pvolume 5%- && pkill -u "$(id -u)" -RTMIN+1 i3blocks
  # bindsym --locked XF86AudioRaiseVolume exec audioctl set pvolume 5%+ && pkill -u "$(id -u)" -RTMIN+1 i3blocks
  # bindsym --locked XF86AudioMute exec audioctl set pswitch toggle && pkill -u "$(id -u)" -RTMIN+1 i3blocks

  # Special keys to adjust brightness via brightnessctl
  --locked XF86MonBrightnessDown exec brightnessctl set 1%-
  --locked XF86MonBrightnessUp exec brightnessctl set 1%+

  # Exit sway (logs you out of your Wayland session)
  # bindsym $mod+escape exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
  $mod+Shift+e exit
}

mode "control" bindsym {
  $mod+l exec run-sway-script lock-screen; mode "default"
  --locked $mod+q mode "default" 
  --locked $mod+Shift+q mode "default" 
  --locked Escape mode "default" 

  # Special keys to adjust brightness via brightnessctl
  --locked $mod+b exec brightnessctl set 1%-
  --locked $mod+Shift+b exec brightnessctl set 1%+
  --locked $mod+s exec brightnessctl set 50%; mode "default"

  # Special keys to adjust volume
  --locked $mod+v exec audioctl set pvolume 5%- && pkill -u "$(id -u)" -USR1 i3status
  --locked $mod+Shift+v exec audioctl set pvolume 5%+ && pkill -u "$(id -u)" -USR1 i3status
  --locked $mod+m exec audioctl set pswitch toggle && pkill -u "$(id -u)" -USR1 i3status; mode "default"
}
bindsym $mod+o mode "control"

# vim: ft=swayconfig

# Fast start
bindsym {
  # Screen shot
  Print exec screenshot

  # Screen shot with specified region
  $mod+Print exec screenshot -s

  # Screen shot on selected window
  $mod+Shift+Print exec run-sway-script screenshot; mode "default"

  # Special keys to adjust volume
  --locked XF86AudioLowerVolume exec audioctl set pvolume 5%- && pkill -USR1 -xu "$(id -u)" i3status
  --locked XF86AudioRaiseVolume exec audioctl set pvolume 5%+ && pkill -USR1 -xu "$(id -u)" i3status
  --locked XF86AudioMute exec audioctl set pswitch toggle && pkill -USR1 -xu "$(id -u)" i3status
  # bindsym --locked XF86AudioLowerVolume exec audioctl set pvolume 5%- && pkill -RTMIN+1 -u "$(id -u)" i3blocks
  # bindsym --locked XF86AudioRaiseVolume exec audioctl set pvolume 5%+ && pkill -RTMIN+1 -u "$(id -u)" i3blocks
  # bindsym --locked XF86AudioMute exec audioctl set pswitch toggle && pkill -RTMIN+1 -u "$(id -u)" i3blocks

  # Special keys to adjust brightness via brightnessctl
  --locked XF86MonBrightnessDown exec brightnessctl set 1%-
  --locked XF86MonBrightnessUp exec brightnessctl set 1%+

  # Exit sway (logs you out of your Wayland session)
  # bindsym $mod+escape exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
  $mod+Shift+e exit
}

mode "control" bindsym {
  --locked $mod+q mode "default" 
  --locked $mod+Shift+q mode "default" 
  --locked Escape mode "default" 

  $mod+l exec run-sway-script lock-screen; mode "default"

  # Screen shot
  $mod+s exec screenshot; mode "default"
  $mod+Shift+s exec screenshot -s; mode "default"
  $mod+w exec run-sway-script screenshot; mode "default"

  # Special keys to adjust brightness via brightnessctl
  --locked $mod+b exec brightnessctl set 1%-
  --locked $mod+Shift+b exec brightnessctl set 1%+
  --locked $mod+r exec brightnessctl set 50%; mode "default"

  # Special keys to adjust volume
  --locked $mod+v exec audioctl set pvolume 5%- && pkill -USR1 -xu "$(id -u)" i3status
  --locked $mod+Shift+v exec audioctl set pvolume 5%+ && pkill -USR1 -xu "$(id -u)" i3status
  --locked $mod+m exec audioctl set pswitch toggle && pkill -USR1 -xu "$(id -u)" i3status; mode "default"
}
bindsym $mod+o mode "control"

# vim: ft=swayconfig

# vim: ft=sh

shift
if [ "$#" -eq 0 ]; then
  [ -d "$opt_tooldir" ] && (cd -- "$opt_tooldir" && printf "%s\n" *)
  return 0
fi

if [ "$#" -eq 1 ]; then
  for f in "$opt_tooldir/$1/call" "$opt_tooldir/$1/source"; do
    if [ -f "$f" ]; then
      sed -n '/opt_/{s/^.*opt_\([[:alnum:]_]*\).*$/\1/; s/_/-/g; p;}' <"$f" \
        | sort -u
    fi
  done
  return 0
fi

mkdir -p "$statedir/tool-config" || return
tool_config_file=$statedir/tool-config/$1
shift
for kv; do
  case $kv in
    *=*)
      ;;
    *)
      printf "expected a option assignment, got: %s\n" "$kv" >&2
      continue
      ;;
  esac
  k=${kv%%=*}
  case $k in
    [[:digit:]]*|*[![:alnum:]-]*)
      printf "bad option name: %s\n" "$k" >&2
      continue
      ;;
  esac
  v=${kv#*=}
  k=opt_$(printf "%s" "$k" | tr -- '-' '_')
  if [ -e "$tool_config_file" ]; then
    grep -v "^$k=" <"$tool_config_file" >"$tmp"
    cp -- "$tmp" "$tool_config_file"
  fi
  {
    printf "%s=" "$k"
    shell-escape -- "$v"
    printf ";\n"
  } >>"$tool_config_file"
done

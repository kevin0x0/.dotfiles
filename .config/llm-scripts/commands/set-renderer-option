# vim: ft=sh

shift

if [ "$#" -eq 0 ]; then
  my_render_utils_path=
  my_paths=${PATH:+$PATH:}
  while [ -n "$my_paths" ]; do
    my_path=${my_paths%%:*}
    my_paths=${my_paths#*:}
    if [ -f "${my_path:-.}/llm-render-utils" ]; then
      my_render_utils_path=${my_path:-.}/llm-render-utils
      break
    fi
  done
  if [ -n "$my_render_utils_path" ]; then
    sed -n -- '/^.*renderer_opt_.*$/{s/^.*renderer_opt_\([[:alnum:]_]*\).*$/\1/; s/_/-/gp}' "$my_render_utils_path" | sort -u
  fi
  return 0
fi

command eval "renderer_opt_$(printf "%s" "$1" | tr '-' '_')="'$2'

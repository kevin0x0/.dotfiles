# vim: ft=sh

# Set the api key
opt_api_key="<your api key>"
# Or
# opt_api_key_cmd="<command that prints your api key>"
# Note: the command must print a trailing <newline>
# For example, if your key is 'abc', then the command may like:
# opt_api_key_cmd='printf "abc\n"'

# Set the cache key
opt_cache_key="<cache key, this identifies your remote file storage>"

# Source a model
source_configfile @providers/deepseek/models/deepseek-flash

if [ "$llm_scriptname" = llm-chat ]; then
  # If the opt_prompt is set, then its value will be used as the prompt.
  opt_prompt='You are a helpful assistant.'
  # Otherwise if the opt_prompt_file is set, then the file content will be
  # used as the prompt.
  # locate_config_item opt_prompt_file prompts/generic

  # Specify which tools you want to use.
  # Tools are specified via a space-separated list of glob.
  opt_toolspec='*'
fi

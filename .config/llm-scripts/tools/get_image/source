#!/bin/sh

arg=$(cat)
if ! printf "%s" "$arg" | jq -e 'has("url") or has("pathname")' >/dev/null; then
  llm-make-mcontent -t -- '{"error":"bad argument"}'
  exit 0
fi
url=$(printf "%s" "$arg" | jq -j ".url // .pathname"; echo x)
url=${url%x}
if path2uri -u "$url"; then
  llm-make-mcontent -u -- "$url"
  exit 0
fi

tmp=$(tmpfile) || exit
trap 'rm "$tmp"' EXIT
trap 'rm -f -- "$tmp"; trap - INT; kill -INT "$$"' INT

statedir=$2
# llm_chat_opt_api_key should be pass via llm-tool-call -[N]S opt_api_key=<n> and
# llm-tool-call reads the value form the file descriptor <n>.
api_key=$llm_chat_opt_api_key
files_base_url=$3
cache_key=$4
purpose=$5

. llm-chat-fileid-utils
if ! output=$(llm_chat_get_fileid "$statedir" "$files_base_url" "$api_key" "$cache_key" "$purpose" "$url" 2>"$tmp" && echo x); then
  jq -n --rawfile err "$tmp" '{"error":"failed to get file id: " + $err}' \
    | llm-make-mcontent -t
  exit 0
fi

llm-make-mcontent -i -- "${output%$'\nx'}"

font=sans-serif, 10

border-size=2
border-radius=10
width=500
height=150

default-timeout=5000

on-notify=exec ring-bell message

#format=<span weight="bold" size="12pt">%s</span> <small><span font="monospace" style="italic">%a</span></small>\n%b
format=<span weight="semibold" size="12pt">%s </span> <span alpha="75%%">%a</span>\n%b

include=~/.local/state/colorscheme/mako/colorscheme

[urgency=critical]
height=300
on-notify=exec ring-bell dialog-error

[urgency=low]
height=150
on-notify=none

[actionable=true]
format=<span weight="semibold" size="12pt">%s </span> <span alpha="75%%">%a</span> 🗲\n%b

[category="email.arrived"]
on-notify=exec ring-bell message-new-email

